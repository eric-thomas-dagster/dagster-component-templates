{
  "component_type": "dagster_component_templates.BigQueryMLTrainAssetComponent",
  "description": "Train a BigQuery ML model from a SELECT statement. Supports LINEAR_REG, LOGISTIC_REG, ARIMA_PLUS, KMEANS, DNN_*, BOOSTED_TREE_*, AUTOML_*, MATRIX_FACTORIZATION, etc. — ML in pure SQL.",
  "category": "ai",
  "icon": "si:googlebigquery",
  "x-dagster-io": {
    "outputs": {
      "type": "DataFrame",
      "description": "ML.EVALUATE metrics for the trained model."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output asset name.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "credentials": {
      "type": "object",
      "label": "Credentials (dict)",
      "required": false,
      "default": null
    },
    "credentials_path": {
      "description": "Falls back to GOOGLE_APPLICATION_CREDENTIALS.",
      "type": "string",
      "label": "Credentials Path",
      "required": false,
      "default": null
    },
    "project_id": {
      "description": "Billing project. Defaults to the SA's project.",
      "type": "string",
      "label": "Project ID",
      "required": false,
      "default": null
    },
    "location": {
      "description": "BQ location. Default: auto-detect.",
      "type": "string",
      "label": "Location",
      "required": false,
      "default": null
    },
    "destination_model_id": {
      "description": "Fully-qualified BQML model id, e.g. `my-project.ml.my_arima_model`.",
      "type": "string",
      "label": "Destination Model ID",
      "required": true
    },
    "model_options": {
      "type": "object",
      "label": "Model Options",
      "required": true,
      "description": "OPTIONS clause as a dict. Must include model_type."
    },
    "select_query": {
      "description": "SELECT statement that supplies training data. Supports {placeholder} substitution.",
      "type": "string",
      "label": "Select Query",
      "required": true,
      "ui:widget": "textarea"
    },
    "query_params": {
      "type": "object",
      "label": "Query Params",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    }
  },
  "tags": [
    "ai",
    "ml",
    "google",
    "bigquery",
    "bqml",
    "training",
    "forecasting"
  ],
  "name": "BigQuery ML Train"
}
