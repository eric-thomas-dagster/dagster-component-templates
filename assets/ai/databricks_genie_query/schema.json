{
  "component_type": "dagster_component_templates.DatabricksGenieQueryComponent",
  "description": "Natural-language \u2192 SQL \u2192 result via Databricks AI/BI Genie spaces. Two modes: single question (one Genie call per materialization, returns DataFrame) or per-row (each upstream row's question gets a Genie call, output adds sql + result + genie_message_id columns).",
  "category": "ai",
  "icon": "si:databricks",
  "x-dagster-io": {
    "supports_partitions": true
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "host_env_var": {
      "type": "string",
      "label": "Workspace URL Env Var",
      "default": "DATABRICKS_HOST",
      "required": false
    },
    "token_env_var": {
      "type": "string",
      "label": "PAT / OAuth Token Env Var",
      "default": "DATABRICKS_TOKEN",
      "required": false
    },
    "space_id": {
      "type": "string",
      "label": "Genie Space ID",
      "required": true
    },
    "question": {
      "type": "string",
      "label": "Single Question",
      "description": "Mode A: one question per materialization. Supports {partition_key} / {run_id} substitution.",
      "required": false
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "description": "Mode B: per-row. Mutually exclusive with `question`.",
      "required": false
    },
    "question_column": {
      "type": "string",
      "label": "Question Column",
      "description": "Mode B: column on upstream DataFrame holding NL questions.",
      "required": false,
      "x-dagster-widget": "column"
    },
    "poll_interval_seconds": {
      "type": "number",
      "label": "Poll Interval (sec)",
      "default": 2.0,
      "required": false
    },
    "timeout_seconds": {
      "type": "integer",
      "label": "Timeout (sec)",
      "default": 300,
      "required": false
    },
    "request_timeout_seconds": {
      "type": "integer",
      "label": "Request Timeout (sec)",
      "default": 60,
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "required": false
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "required": false
    },
    "partition_type": {"label": "Partition Type", 
      "type": "string",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {"label": "Partition Start", 
      "type": "string",
      "required": false
    },
    "partition_values": {"label": "Partition Values", 
      "type": "string",
      "required": false
    },
    "dynamic_partition_name": {"label": "Dynamic Partition Name", 
      "type": "string",
      "required": false
    },
    "partition_dimensions": {"label": "Partition Dimensions", 
      "type": "array",
      "required": false
    },
    "freshness_max_lag_minutes": {"label": "Freshness Max Lag Minutes", 
      "type": "integer",
      "required": false
    },
    "freshness_cron": {"label": "Freshness Cron", 
      "type": "string",
      "required": false,
      "x-dagster-widget": "cron"
    },
    "retry_policy_max_retries": {"label": "Retry Policy Max Retries", 
      "type": "integer",
      "required": false
    },
    "retry_policy_delay_seconds": {"label": "Retry Policy Delay Seconds", 
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {"label": "Retry Policy Backoff", 
      "type": "string",
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "default": "exponential",
      "required": false,
      "description": "Retry backoff strategy: exponential (doubles the delay each time), linear (adds a fixed delay each time), or fixed (constant delay)."
    }
  }
}
