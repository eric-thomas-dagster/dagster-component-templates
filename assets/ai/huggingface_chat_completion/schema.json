{
  "component_type": "dagster_community_components.HuggingfaceChatCompletionComponent",
  "description": "Call a chat-completion model via the HuggingFace router (OpenAI-compatible) — any hosted chat model on the Hub with one SDK.",
  "category": "ai",
  "icon": "si:huggingface",
  "x-dagster-io": {
    "outputs": {
      "type": "MaterializeResult",
      "description": "Assistant message + token usage in metadata"
    }
  },
  "attributes": {
    "asset_key": {
      "description": "Dagster asset key (e.g. 'hf/chat/summary').",
      "type": "string",
      "label": "Asset Key",
      "required": true
    },
    "prompt": {
      "type": "string",
      "label": "Prompt",
      "description": "Simple user-message prompt. Mutually exclusive with messages.",
      "required": false
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "label": "Messages",
      "description": "OpenAI chat messages [{role, content}, ...]. Mutually exclusive with prompt.",
      "required": false
    },
    "hf_token_env_var": {
      "type": "string",
      "label": "HF Token Env Var",
      "description": "Env var with HF token",
      "required": false,
      "default": "HF_TOKEN",
      "ui:widget": "env_var"
    },
    "temperature": {
      "description": "Sampling temperature (0.0–2.0).",
      "type": "number",
      "label": "Temperature",
      "required": false,
      "default": null
    },
    "max_tokens": {
      "description": "Max output tokens.",
      "type": "integer",
      "label": "Max Tokens",
      "required": false,
      "default": null
    },
    "top_p": {
      "description": "Nucleus sampling top_p.",
      "type": "number",
      "label": "Top P",
      "required": false,
      "default": null
    },
    "base_url": {
      "type": "string",
      "label": "Base URL",
      "description": "OpenAI-compatible base URL. Default is the HF router.",
      "required": false,
      "default": "https://router.huggingface.co/v1"
    },
    "extra_kwargs": {
      "description": "Additional kwargs forwarded to chat.completions.create() (e.g. stop, response_format).",
      "type": "object",
      "label": "Extra Kwargs",
      "required": false,
      "ui:widget": "key-value"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "huggingface"
    },
    "description": {
      "description": "Asset description shown in the Dagster catalog.",
      "type": "string",
      "label": "Description",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "description": "Key-value catalog tags.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Asset kinds (auto-includes 'huggingface').",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    },
    "deps": {
      "description": "Upstream asset keys this asset depends on.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false,
      "ui:widget": "list"
    }
  },
  "tags": [
    "ai",
    "huggingface",
    "chat",
    "llm",
    "router"
  ],
  "name": "HuggingFace Chat Completion"
}
