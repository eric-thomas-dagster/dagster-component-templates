{
  "component_type": "dagster_community_components.IterativeSupervisorAgentComponent",
  "description": "Iterative / chained supervisor agent. Planner runs once per step, sees prior steps' tool outputs, and picks the NEXT tool call — or declares done. Each step is its own Dagster asset (full ReAct-loop lineage). Static DAG shape via pre-declared max_iterations, dynamic termination via short-circuit.",
  "category": "ai",
  "icon": "Sparkles",
  "x-dagster-io": {
    "inputs": {
      "type": "none"
    },
    "outputs": {
      "type": "multi_asset",
      "description": "Emits (max_iterations + 1) assets: N step assets + 1 synthesis."
    }
  },
  "attributes": {
    "step_asset_prefix": {"label": "Step Asset Prefix", 
      "type": "string",
      "required": false,
      "default": "agent_step"
    },
    "synthesis_asset_name": {"label": "Synthesis Asset Name", 
      "type": "string",
      "required": true
    },
    "task": {"label": "Task", 
      "type": "string",
      "required": true
    },
    "tools": {"label": "Tools", 
      "type": "array",
      "required": true
    },
    "max_iterations": {"label": "Max Iterations", 
      "type": "integer",
      "required": false,
      "default": 5,
      "minimum": 1,
      "maximum": 15
    },
    "model": {"label": "Model", 
      "type": "string",
      "required": false,
      "default": null
    },
    "api_key_env_var": {"label": "API Key Env Var", 
      "type": "string",
      "required": false,
      "default": null
    },
    "api_base_env_var": {"label": "API Base Env Var", 
      "type": "string",
      "required": false
    },
    "temperature": {"label": "Temperature", 
      "type": "number",
      "required": false,
      "default": 0.1
    },
    "planner_max_tokens": {"label": "Planner Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 400
    },
    "tool_max_tokens": {"label": "Tool Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 500
    },
    "synthesis_max_tokens": {"label": "Synthesis Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 600
    },
    "synthesis_system_message": {"label": "Synthesis System Message", 
      "type": "string",
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    }
  }
}
