{
  "component_type": "dagster_component_templates.PerplexityLLMComponent",
  "description": "Native Perplexity (Sonar) web-grounded LLM inference via Perplexity's OpenAI-compatible API. Drop-in peer of openai_llm / anthropic_llm / gemini_llm / groq_llm / mistral_llm, but unlike those, Perplexity's responses are grounded with real-time web citations, which this component surfaces as its own output column and in materialization metadata. For multi-vendor routing use litellm_inference_asset.",
  "category": "ai",
  "icon": "lu:search",
  "x-dagster-io": {
    "outputs": {
      "type": "DataFrame",
      "description": "Upstream DataFrame with the LLM response column, a web-citations column, and optional _error / search-result-detail columns added."
    }
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "api_key_env_var": {
      "type": "string",
      "label": "API Key Env Var",
      "required": false,
      "default": "PERPLEXITY_API_KEY"
    },
    "base_url": {
      "type": "string",
      "label": "Base URL",
      "required": false,
      "default": "https://api.perplexity.ai"
    },
    "text_model": {
      "type": "string",
      "label": "Text Model",
      "required": false,
      "default": "sonar",
      "description": "Common: sonar, sonar-pro, sonar-reasoning, sonar-reasoning-pro, sonar-deep-research"
    },
    "system_prompt": {
      "type": "string",
      "label": "System Prompt",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "user_prompt_template": {
      "type": "string",
      "label": "User Prompt Template",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "input_column": {
      "type": "string",
      "label": "Input Column",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "output_column": {
      "type": "string",
      "label": "Output Column",
      "required": false,
      "default": "perplexity_response",
      "x-dagster-widget": "column"
    },
    "citations_column": {
      "type": "string",
      "label": "Citations Column",
      "required": false,
      "default": "perplexity_citations",
      "description": "Column holding the list of web source URLs cited for that row's answer.",
      "x-dagster-widget": "column"
    },
    "include_search_results": {
      "type": "boolean",
      "label": "Include Search Result Detail",
      "required": false,
      "default": false,
      "description": "Also add a '<citations_column>_detail' column with title/url/date/snippet per source."
    },
    "max_tokens": {
      "type": "integer",
      "label": "Max Tokens",
      "required": false,
      "default": 1024
    },
    "temperature": {
      "type": "number",
      "label": "Temperature",
      "required": false,
      "default": 0.0
    },
    "top_p": {
      "type": "number",
      "label": "Top-P",
      "required": false,
      "default": null
    },
    "response_format": {
      "type": "string",
      "label": "Response Format",
      "required": false,
      "default": null,
      "description": "'json_object' for JSON-only output"
    },
    "search_domain_filter": {
      "type": "array",
      "label": "Search Domain Filter",
      "required": false,
      "items": {
        "type": "string"
      },
      "description": "Allowlist domains, or denylist with a '-' prefix, e.g. ['-reddit.com']. Max 20."
    },
    "search_recency_filter": {
      "type": "string",
      "label": "Search Recency Filter",
      "required": false,
      "default": null,
      "enum": [
        "day",
        "week",
        "month",
        "year"
      ],
      "ui:widget": "select"
    },
    "return_related_questions": {
      "type": "boolean",
      "label": "Return Related Questions",
      "required": false,
      "default": null
    },
    "rate_limit_delay": {
      "type": "number",
      "label": "Rate Limit Delay",
      "required": false,
      "default": 0.0
    },
    "max_retries": {
      "type": "integer",
      "label": "Max Retries",
      "required": false,
      "default": 3
    },
    "description": {
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "deps": {
      "type": "array",
      "label": "Deps",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "default": null,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "required": false,
      "default": null
    },
    "partition_values": {
      "type": "string",
      "label": "Partition Values",
      "required": false,
      "default": null
    },
    "dynamic_partition_name": {
      "type": "string",
      "label": "Dynamic Partition Name",
      "required": false,
      "default": null
    },
    "partition_dimensions": {
      "type": "array",
      "label": "Partition Dimensions",
      "required": false
    }
  },
  "tags": [
    "ai",
    "llm",
    "perplexity",
    "sonar",
    "web-search",
    "citations",
    "rag"
  ],
  "name": "Perplexity LLM"
}
