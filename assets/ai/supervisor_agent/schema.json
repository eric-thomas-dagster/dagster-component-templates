{
  "component_type": "dagster_community_components.SupervisorAgentComponent",
  "description": "Supervisor / planner agent — reads a task, picks tools from a bounded YAML-declared set, and fans out execution across per-tool Dagster assets. Ends with a synthesizer LLM that grounds the final answer in tool outputs. The 'agent of agents' pattern with full lineage.",
  "category": "ai",
  "icon": "Sparkles",
  "x-dagster-io": {
    "inputs": {
      "type": "none",
      "description": "Task is provided in YAML config."
    },
    "outputs": {
      "type": "multi_asset",
      "description": "Emits (2 + N_tools) assets: plan, one per tool, and synthesis."
    }
  },
  "attributes": {
    "plan_asset_name": {"label": "Plan Asset Name", 
      "type": "string",
      "required": true,
      "description": "Name of the planner's asset."
    },
    "synthesis_asset_name": {"label": "Synthesis Asset Name", 
      "type": "string",
      "required": true,
      "description": "Name of the final synthesis asset."
    },
    "task": {"label": "Task", 
      "type": "string",
      "required": true,
      "description": "The task / question the supervisor plans against."
    },
    "tools": {"label": "Tools", 
      "type": "array",
      "required": true,
      "description": "Bounded list of {name, description, system_message}."
    },
    "model": {"label": "Model", 
      "type": "string",
      "required": false,
      "default": null
    },
    "api_key_env_var": {"label": "API Key Env Var", 
      "type": "string",
      "required": false,
      "default": null
    },
    "api_base_env_var": {"label": "API Base Env Var", 
      "type": "string",
      "required": false
    },
    "temperature": {"label": "Temperature", 
      "type": "number",
      "required": false,
      "default": 0.2
    },
    "planner_max_tokens": {"label": "Planner Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 400
    },
    "tool_max_tokens": {"label": "Tool Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 400
    },
    "synthesis_max_tokens": {"label": "Synthesis Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 600
    },
    "synthesis_system_message": {"label": "Synthesis System Message", 
      "type": "string",
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    }
  }
}
