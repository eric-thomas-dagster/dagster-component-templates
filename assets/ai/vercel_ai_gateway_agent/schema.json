{
  "component_type": "dagster_community_components.VercelAIGatewayAgentComponent",
  "description": "Single-shot LLM agent via Vercel AI Gateway — OpenAI-compatible proxy that routes to any provider with unified billing + automatic fallback + Vercel observability.",
  "category": "ai",
  "icon": "si:vercel",
  "x-dagster-io": {
    "inputs": {
      "type": "none"
    },
    "outputs": {
      "type": "dict"
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true
    },
    "prompt": {"label": "Prompt", 
      "type": "string",
      "required": true
    },
    "system_prompt": {"label": "System Prompt", 
      "type": "string",
      "required": false
    },
    "fallback_models": {"label": "Fallback Models", 
      "type": "array",
      "required": false,
      "description": "Fallback chain on invocation error."
    },
    "api_key_env_var": {"label": "API Key Env Var", 
      "type": "string",
      "required": false,
      "default": "VERCEL_API_TOKEN"
    },
    "api_base_url": {"label": "API Base URL", 
      "type": "string",
      "required": false,
      "default": "https://ai-gateway.vercel.sh/v1"
    },
    "temperature": {"label": "Temperature", 
      "type": "number",
      "required": false,
      "default": 0.0
    },
    "max_tokens": {"label": "Max Tokens", 
      "type": "integer",
      "required": false,
      "default": 2048
    },
    "max_iterations": {"label": "Max Iterations", 
      "type": "integer",
      "required": false,
      "default": 10
    },
    "mcp_servers": {"label": "Mcp Servers", 
      "type": "array",
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "required": false
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "required": false
    }
  }
}
