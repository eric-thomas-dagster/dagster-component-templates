{
  "component_type": "dagster_component_templates.VisionApiAssetComponent",
  "description": "Cloud Vision API per-row image analysis. Supports LABEL_DETECTION, OBJECT_LOCALIZATION, FACE_DETECTION, LANDMARK_DETECTION, LOGO_DETECTION, TEXT_DETECTION (basic OCR), DOCUMENT_TEXT_DETECTION, SAFE_SEARCH_DETECTION, IMAGE_PROPERTIES, CROP_HINTS, WEB_DETECTION. For form/table/structured-document parsing, prefer Document AI.",
  "category": "ai",
  "icon": "si:googlecloud",
  "x-dagster-io": {
    "outputs": {
      "type": "DataFrame",
      "description": "Upstream DataFrame with vision_* columns added per requested feature."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output asset name.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Upstream DataFrame asset key.",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "credentials": {
      "type": "object",
      "label": "Credentials (dict)",
      "required": false,
      "default": null
    },
    "credentials_path": {
      "description": "Falls back to GOOGLE_APPLICATION_CREDENTIALS.",
      "type": "string",
      "label": "Credentials Path",
      "required": false,
      "default": null
    },
    "image_column": {
      "description": "Column with image references (file path, gs:// URI, or http(s) URL).",
      "type": "string",
      "label": "Image Column",
      "required": true,
      "x-dagster-widget": "column"
    },
    "image_source": {
      "type": "string",
      "label": "Image Source",
      "required": false,
      "default": "auto",
      "description": "One of: path / gcs / url / auto.",
      "enum": [
        "path",
        "gcs",
        "url",
        "auto"
      ],
      "ui:widget": "select"
    },
    "features": {
      "description": "One or more Vision feature types (e.g. ['LABEL_DETECTION', 'OBJECT_LOCALIZATION']).",
      "type": "array",
      "label": "Features",
      "required": true,
      "items": {
        "type": "string"
      }
    },
    "max_results": {
      "description": "max_results per feature in the Vision request.",
      "type": "integer",
      "label": "Max Results",
      "required": false,
      "default": 10
    },
    "output_prefix": {
      "description": "Column-name prefix for added analysis columns.",
      "type": "string",
      "label": "Output Prefix",
      "required": false,
      "default": "vision_"
    },
    "rate_limit_delay": {
      "type": "number",
      "label": "Rate Limit Delay",
      "required": false,
      "default": 0.0
    },
    "max_retries": {
      "type": "integer",
      "label": "Max Retries",
      "required": false,
      "default": 3
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    }
  },
  "tags": [
    "ai",
    "vision",
    "google",
    "ocr",
    "image-analysis",
    "object-detection"
  ],
  "name": "Cloud Vision API"
}
