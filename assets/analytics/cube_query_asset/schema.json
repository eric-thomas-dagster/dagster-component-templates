{
  "component_type": "dagster_community_components.CubeQueryAssetComponent",
  "description": "Run a Cube semantic-layer query (REST /v1/load) and materialize as a Dagster asset (pandas DataFrame). Great for landing governed metrics in the warehouse or feeding downstream AI/reporting.",
  "category": "analytics",
  "icon": "si:cube",
  "x-dagster-io": {
    "inputs": {"type": "none"},
    "outputs": {"type": "dataframe", "description": "Query result as pandas DataFrame"}
  },
  "attributes": {
    "asset_name": {"description": "Output Dagster asset name.", "type": "string", "label": "Asset Name", "required": true},
    "query": {"type": "object", "label": "Cube Query", "required": true, "description": "Cube JSON query: {measures, dimensions, timeDimensions, filters, order, limit, offset}"},
    "api_url_env_var": {"description": "Env var with Cube API base URL (e.g. http://localhost:4000 for local dev).", "label": "API URL Env Var", "type": "string", "required": false, "default": "CUBE_URL"},
    "api_token_env_var": {"label": "API Token Env Var", "type": "string", "required": false, "description": "JWT env var for Cube Cloud / production. Omit for local dev."},
    "request_timeout_seconds": {"description": "Timeout per Cube API call.", "label": "Request Timeout Seconds", "type": "integer", "required": false, "default": 60},
    "group_name": {"description": "Dagster asset group name.", "label": "Group Name", "type": "string", "required": false, "default": "cube"},
    "description": {"description": "Asset description.", "label": "Description", "type": "string", "required": false},
    "owners": {"description": "Asset owners.", "label": "Owners", "type": "array", "required": false},
    "tags": {"description": "Catalog tags.", "label": "Tags", "type": "object", "required": false},
    "kinds": {"description": "Asset kinds (auto-includes 'cube', 'semantic-layer').", "label": "Kinds", "type": "array", "required": false},
    "deps": {"description": "Upstream Dagster asset keys.", "label": "Deps", "type": "array", "required": false}
  }
}
