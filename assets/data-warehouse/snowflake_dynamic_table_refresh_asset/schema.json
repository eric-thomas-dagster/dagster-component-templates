{
  "component_type": "dagster_community_components.SnowflakeDynamicTableRefreshAssetComponent",
  "description": "Materialize by ALTER DYNAMIC TABLE ... REFRESH on a named Snowflake dynamic table. Single-entity counterpart to snowflake_workspace's auto-discovered DTs.",
  "category": "integration",
  "icon": "si:snowflake",
  "x-dagster-io": {
    "outputs": {
      "type": "MaterializeResult",
      "description": "Snowflake DT refresh result + last status"
    }
  },
  "attributes": {
    "asset_key": {
      "description": "Dagster asset key (e.g. 'snowflake/dt/customer_summary').",
      "type": "string",
      "label": "Asset Key",
      "required": true
    },
    "dynamic_table_name": {
      "description": "Name of the dynamic table.",
      "type": "string",
      "label": "Dynamic Table Name",
      "required": true
    },
    "database": {
      "description": "Snowflake database holding the DT.",
      "type": "string",
      "label": "Database",
      "required": true
    },
    "account_env_var": {
      "description": "Env var with Snowflake account.",
      "type": "string",
      "label": "Account Env Var",
      "required": true,
      "ui:widget": "env_var"
    },
    "user_env_var": {
      "description": "Env var with Snowflake username.",
      "type": "string",
      "label": "User Env Var",
      "required": true,
      "ui:widget": "env_var"
    },
    "password_env_var": {
      "description": "Env var with Snowflake password.",
      "type": "string",
      "label": "Password Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "pat_env_var": {
      "description": "Env var with Snowflake PAT.",
      "type": "string",
      "label": "PAT Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "private_key_path_env_var": {
      "description": "Env var with RSA private key path.",
      "type": "string",
      "label": "Private Key Path Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "private_key_passphrase_env_var": {
      "description": "Env var with private-key passphrase.",
      "type": "string",
      "label": "Private Key Passphrase Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "warehouse_env_var": {
      "description": "Env var with Snowflake warehouse.",
      "type": "string",
      "label": "Warehouse Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "role_env_var": {
      "description": "Env var with Snowflake role.",
      "type": "string",
      "label": "Role Env Var",
      "required": false,
      "ui:widget": "env_var"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "snowflake"
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Asset kinds (auto-includes 'snowflake').",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    },
    "deps": {
      "description": "Upstream Dagster asset keys.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false,
      "ui:widget": "list"
    }
  },
  "tags": [
    "data-warehouse",
    "snowflake",
    "dynamic-table",
    "refresh"
  ],
  "name": "Snowflake Dynamic Table Refresh Asset"
}
