{
  "component_type": "dagster_community_components.PrefectFlowRunAssetComponent",
  "description": "Trigger a Prefect deployment as a Dagster asset. Optionally waits for the flow run to complete. Materialization metadata carries the Prefect flow_run_id, state, state message, and parameters. Works with local Prefect server and Prefect Cloud.",
  "category": "infrastructure",
  "icon": "Play",
  "attributes": {
    "asset_name": {"type": "string", "label": "Asset Name", "required": true, "description": "Dagster asset name (or '/' path)."},
    "deployment_name": {"type": "string", "label": "Deployment Name", "required": true, "description": "Prefect deployment name in 'flow_name/deployment_name' format."},
    "parameters": {"type": "object", "label": "Parameters", "required": false, "description": "Parameters passed to the flow run. String values are templated: {partition_key}, {run_id}.", "default": null},
    "wait_for_result": {"type": "boolean", "label": "Wait For Result", "required": false, "description": "Wait for flow completion before materializing.", "default": true},
    "timeout_seconds": {"type": "integer", "label": "Timeout Seconds", "required": false, "description": "Only when wait_for_result=True. Max seconds to wait. None=indefinite.", "default": null},
    "poll_interval_seconds": {"type": "number", "label": "Poll Interval Seconds", "required": false, "description": "Only when wait_for_result=True. Seconds between polls.", "default": 5.0},
    "tags": {"type": "array", "label": "Tags", "required": false, "description": "Prefect tags applied to the created flow run.", "default": null, "items": {"type": "string"}},
    "flow_run_name": {"type": "string", "label": "Flow Run Name", "required": false, "description": "Optional custom flow run name (templated with {partition_key}, {run_id}).", "default": null},
    "api_url": {"type": "string", "label": "API URL", "required": false, "description": "Prefect API URL.", "default": "http://127.0.0.1:4200/api"},
    "api_key_env_var": {"type": "string", "label": "API Key Env Var", "required": false, "description": "Env var holding a Prefect Cloud API key.", "default": null},
    "fail_on_flow_run_failure": {"type": "boolean", "label": "Fail On Flow Run Failure", "required": false, "description": "Fail the Dagster asset if the Prefect flow ends in FAILED/CRASHED/CANCELLED.", "default": true},
    "group_name": {"type": "string", "label": "Group Name", "required": false, "default": null},
    "description": {"type": "string", "label": "Description", "required": false, "default": null},
    "owners": {"type": "array", "label": "Owners", "required": false, "default": null, "items": {"type": "string"}},
    "asset_tags": {"type": "object", "label": "Asset Tags", "required": false, "default": null, "additionalProperties": {"type": "string"}},
    "kinds": {"type": "array", "label": "Kinds", "required": false, "description": "Asset kinds. Defaults to ['prefect'].", "default": null, "items": {"type": "string"}},
    "freshness_max_lag_minutes": {"type": "integer", "label": "Freshness Max Lag Minutes", "required": false, "default": null},
    "freshness_cron": {"type": "string", "label": "Freshness Cron", "required": false, "default": null},
    "partition_type": {"type": "string", "label": "Partition Type", "required": false, "default": null},
    "partition_start": {"type": "string", "label": "Partition Start", "required": false, "default": null},
    "partition_values": {"type": "string", "label": "Partition Values", "required": false, "default": null},
    "dynamic_partition_name": {"type": "string", "label": "Dynamic Partition Name", "required": false, "default": null},
    "partition_dimensions": {"type": "array", "label": "Partition Dimensions", "required": false, "default": null, "items": {"type": "object"}},
    "deps": {"type": "array", "label": "Deps", "required": false, "description": "Lineage-only upstream asset keys.", "default": null, "items": {"type": "string"}},
    "retry_policy_max_retries": {"type": "integer", "label": "Retry Max Retries", "required": false, "default": null},
    "retry_policy_delay_seconds": {"type": "integer", "label": "Retry Delay Seconds", "required": false, "default": null},
    "retry_policy_backoff": {"type": "string", "label": "Retry Backoff", "required": false, "default": "exponential"}
  }
}
