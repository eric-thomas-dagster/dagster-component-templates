{
  "component_type": "dagster_community_components.TemporalSignalAssetComponent",
  "description": "Send a Signal to a running Temporal workflow as a Dagster asset. For long-lived workflows that need Dagster-driven state pushes (flush, add, kick, shutdown).",
  "category": "infrastructure",
  "icon": "si:temporal",
  "attributes": {
    "asset_key": {"label": "Asset Key", "type": "string", "required": true},
    "workflow_id": {"label": "Workflow ID", "type": "string", "required": true},
    "signal_name": {"label": "Signal Name", "type": "string", "required": true},
    "signal_args": {"label": "Signal Args", "type": "array", "required": false},
    "signal_arg": {"label": "Signal Arg", "type": "object", "required": false},
    "target_host": {"label": "Target Host", "type": "string", "required": false, "default": "localhost:7233"},
    "namespace": {"label": "Namespace", "type": "string", "required": false, "default": "default"},
    "api_key_env_var": {"label": "API Key Env Var", "type": "string", "required": false},
    "tls_cert_env_var": {"label": "Tls Cert Env Var", "type": "string", "required": false},
    "tls_key_env_var": {"label": "Tls Key Env Var", "type": "string", "required": false},
    "tls_server_root_ca_env_var": {"label": "Tls Server Root Ca Env Var", "type": "string", "required": false},
    "group_name": {"label": "Group Name", "type": "string", "required": false, "default": "temporal"},
    "description": {"label": "Description", "type": "string", "required": false},
    "owners": {"label": "Owners", "type": "array", "required": false},
    "tags": {"label": "Tags", "type": "object", "required": false},
    "kinds": {"label": "Kinds", "type": "array", "required": false},
    "deps": {"label": "Deps", "type": "array", "required": false}
  }
}
