{
  "component_type": "dagster_community_components.TimeoutAssetComponent",
  "description": "Hard-kill compute after N seconds. Wraps compute in concurrent.futures.ThreadPoolExecutor; on timeout, cancels the future and raises dg.Failure with typed metadata + emits AssetObservation tagged timeout_hit=<key> for cross-run counting. Different from @sla — @sla only OBSERVES overruns, @timeout KILLS the compute. Complementary. Portable (works on Dagster+ Serverless — no signal-based kill required). Companion `@timeout` decorator wraps existing @dg.asset.",
  "category": "decorator",
  "icon": "TimerOff",
  "x-dagster-io": {
    "outputs": {
      "type": "asset",
      "description": "One @dg.asset. Compute is executed with a hard wall-clock deadline. On timeout: cancelled + dg.Failure. Metadata: timeout_seconds, timeout_hit."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Required when NOT using `wraps:`.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "required": false,
      "default": null
    },
    "compute": {
      "type": "object",
      "label": "Compute",
      "required": true,
      "description": "{kind: python, python: 'mod:fn'}."
    },
    "timeout_seconds": {
      "description": "Kill compute if it exceeds this wall-clock time.",
      "type": "number",
      "label": "Timeout (seconds)",
      "required": true
    },
    "on_timeout": {
      "description": "'fail' raises dg.Failure. 'warn' logs + returns None (rare).",
      "type": "string",
      "label": "On Timeout",
      "required": false,
      "default": "fail",
      "enum": [
        "fail",
        "warn"
      ]
    },
    "timeout_key": {
      "type": "string",
      "label": "Timeout Key",
      "required": false,
      "default": null,
      "description": "Shared cross-run counting key. Defaults to asset_name."
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Default: ['python', 'timeout'].",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    }
  },
  "tags": [
    "timeout",
    "hard-kill",
    "deadline",
    "resilience",
    "infrastructure"
  ],
  "name": "Timeout Asset"
}
