{
  "component_type": "dagster_component_templates.BrazeIngestionComponent",
  "description": "Ingest Braze marketing automation data using dlt's generic REST API source.",
  "category": "ingestion",
  "vertical": "marketing",
  "icon": "ArrowUpFromLine",
  "x-dagster-io": {
    "outputs": {
      "type": "dataframe",
      "description": "pandas DataFrame with one row per Braze record (or MaterializeResult if destination is non-SQL / persist_only=true)."
    }
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "description": "Name of the asset that will hold the data",
      "required": true
    },
    "rest_endpoint": {
      "type": "string",
      "label": "Rest Endpoint",
      "description": "Account-specific Braze REST endpoint (from the Braze dashboard). Required unless resource_key is set.",
      "required": false,
      "default": null
    },
    "api_key": {
      "type": "string",
      "label": "Api Key",
      "description": "Braze REST API key. Use ${BRAZE_API_KEY} for env vars. Required unless resource_key is set.",
      "required": false,
      "default": null
    },
    "resource_key": {
      "type": "string",
      "label": "Resource Key",
      "description": "Optional resource key registered by a BrazeResourceComponent. When set, credentials are read from that resource at run time instead of rest_endpoint/api_key above -- lets one Braze credential serve both this ingestion connector and the braze_sink reverse-ETL sink without configuring it twice.",
      "required": false,
      "default": null
    },
    "resources": {
      "type": "string",
      "label": "Resources",
      "description": "Comma-separated list of resources to extract: segments, campaigns, canvases, content_blocks",
      "required": false,
      "default": "segments,campaigns,canvases,content_blocks"
    },
    "destination": {
      "type": "string",
      "label": "Destination",
      "description": "dlt destination identifier (e.g. 'snowflake', 'bigquery', 'postgres', 'redshift', 'filesystem', 'duckdb', 'databricks', 'athena', 'clickhouse', 'mssql', 'motherduck'). Leave empty for in-memory DuckDB -> DataFrame mode.",
      "required": false,
      "default": null,
      "enum": [
        "snowflake",
        "bigquery",
        "postgres",
        "redshift",
        "filesystem",
        "duckdb",
        "databricks",
        "athena",
        "clickhouse",
        "mssql",
        "motherduck"
      ],
      "ui:widget": "select"
    },
    "dataset_name": {
      "type": "string",
      "label": "Dataset Name",
      "description": "Target dataset/schema in the destination. Defaults to the asset name.",
      "required": false,
      "default": null
    },
    "persist_only": {
      "type": "boolean",
      "label": "Persist Only",
      "description": "If True with destination set: emit a MaterializeResult and skip DataFrame return.",
      "required": false,
      "default": false,
      "ui:widget": "checkbox"
    },
    "destination_credentials_url": {
      "type": "string",
      "label": "Destination Credentials Url",
      "description": "Inline connection string passed to dlt's destination factory.",
      "required": false,
      "default": null,
      "x-dagster-destination-fields": {
        "trigger_field": "destination",
        "options": {
          "snowflake": {
            "fields": [
              {
                "name": "account",
                "label": "Account",
                "required": true,
                "description": "e.g. xy12345.us-east-1"
              },
              {
                "name": "username",
                "label": "Username",
                "required": true
              },
              {
                "name": "password",
                "label": "Password",
                "required": true,
                "widget": "password"
              },
              {
                "name": "database",
                "label": "Database",
                "required": true
              },
              {
                "name": "warehouse",
                "label": "Warehouse",
                "required": false
              },
              {
                "name": "role",
                "label": "Role",
                "required": false
              }
            ],
            "template": {
              "base": "snowflake://{username}:{password}@{account}/{database}",
              "query_params": {
                "warehouse": "warehouse",
                "role": "role"
              }
            }
          },
          "postgres": {
            "fields": [
              {
                "name": "host",
                "label": "Host",
                "required": true
              },
              {
                "name": "port",
                "label": "Port",
                "required": false,
                "default": "5432"
              },
              {
                "name": "username",
                "label": "Username",
                "required": true
              },
              {
                "name": "password",
                "label": "Password",
                "required": true,
                "widget": "password"
              },
              {
                "name": "database",
                "label": "Database",
                "required": true
              }
            ],
            "template": {
              "base": "postgresql://{username}:{password}@{host}:{port}/{database}"
            }
          },
          "redshift": {
            "fields": [
              {
                "name": "host",
                "label": "Host",
                "required": true
              },
              {
                "name": "port",
                "label": "Port",
                "required": false,
                "default": "5439"
              },
              {
                "name": "username",
                "label": "Username",
                "required": true
              },
              {
                "name": "password",
                "label": "Password",
                "required": true,
                "widget": "password"
              },
              {
                "name": "database",
                "label": "Database",
                "required": true
              }
            ],
            "template": {
              "base": "redshift://{username}:{password}@{host}:{port}/{database}"
            }
          },
          "clickhouse": {
            "fields": [
              {
                "name": "host",
                "label": "Host",
                "required": true
              },
              {
                "name": "port",
                "label": "Port",
                "required": false,
                "default": "9000",
                "description": "Native TCP port (not the HTTP interface port)"
              },
              {
                "name": "username",
                "label": "Username",
                "required": false,
                "default": "default"
              },
              {
                "name": "password",
                "label": "Password",
                "required": true,
                "widget": "password"
              },
              {
                "name": "database",
                "label": "Database",
                "required": true
              },
              {
                "name": "secure",
                "label": "Secure (TLS)",
                "required": false,
                "default": "0",
                "description": "1 for HTTPS/TLS, 0 otherwise"
              }
            ],
            "template": {
              "base": "clickhouse://{username}:{password}@{host}:{port}/{database}",
              "query_params": {
                "secure": "secure"
              }
            }
          },
          "mssql": {
            "fields": [
              {
                "name": "host",
                "label": "Host",
                "required": true
              },
              {
                "name": "port",
                "label": "Port",
                "required": false,
                "default": "1433"
              },
              {
                "name": "username",
                "label": "Username",
                "required": true
              },
              {
                "name": "password",
                "label": "Password",
                "required": true,
                "widget": "password"
              },
              {
                "name": "database",
                "label": "Database",
                "required": true
              },
              {
                "name": "encrypt",
                "label": "Encrypt",
                "required": false,
                "default": "no",
                "description": "'yes' to require SSL (e.g. Azure SQL); 'no' for a local unencrypted instance"
              }
            ],
            "template": {
              "base": "mssql://{username}:{password}@{host}:{port}/{database}",
              "query_params": {
                "encrypt": "encrypt"
              }
            }
          },
          "motherduck": {
            "fields": [
              {
                "name": "database",
                "label": "Database",
                "required": false,
                "description": "Defaults to 'my_db' on MotherDuck's side if left blank"
              },
              {
                "name": "token",
                "label": "Service Token",
                "required": true,
                "widget": "password"
              }
            ],
            "template": {
              "base": "md:{database}",
              "query_params": {
                "token": "motherduck_token"
              }
            }
          },
          "bigquery": {
            "credential_format": "json_blob",
            "description": "Paste the full GCP service-account key JSON (GCP Console -> IAM & Admin -> Service Accounts -> your account -> Keys -> Add Key -> JSON). Used verbatim -- dlt's GcpServiceAccountCredentials parses a raw JSON string directly, so no connection-string assembly happens here.",
            "placeholder": "{\n  \"type\": \"service_account\",\n  \"project_id\": \"...\",\n  \"private_key\": \"...\",\n  \"client_email\": \"...\"\n}"
          }
        },
        "related_env_var_field": "destination_credentials_env_var"
      }
    },
    "destination_credentials_env_var": {
      "type": "string",
      "label": "Destination Credentials Env Var",
      "description": "Env var holding the destination connection string.",
      "required": false,
      "default": null
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Asset description",
      "required": false,
      "default": null
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "description": "Asset group for organization",
      "required": false,
      "default": "braze_ingestion"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "description": "Asset owners",
      "required": false,
      "default": null
    },
    "asset_tags": {
      "type": "object",
      "label": "Asset Tags",
      "description": "Additional key-value tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "description": "Asset kinds for the catalog",
      "required": false,
      "default": null
    },
    "freshness_max_lag_minutes": {
      "type": "integer",
      "label": "Freshness Max Lag Minutes",
      "description": "Maximum acceptable lag in minutes.",
      "required": false,
      "default": null
    },
    "freshness_cron": {
      "type": "string",
      "label": "Freshness Cron",
      "description": "Cron schedule string for the freshness policy.",
      "required": false,
      "default": null
    },
    "include_preview_metadata": {
      "type": "boolean",
      "label": "Include Preview Metadata",
      "description": "Include sample data preview in metadata",
      "required": false,
      "default": true,
      "ui:widget": "checkbox"
    },
    "preview_rows": {
      "type": "integer",
      "label": "Preview Rows",
      "description": "Rows to include in the preview metadata.",
      "required": false,
      "default": 25
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "description": "Upstream asset keys this asset depends on",
      "required": false,
      "default": null
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "description": "Partition type: 'daily' / 'weekly' / 'monthly' / 'hourly' / 'static' / 'multi' / 'dynamic' / None. Note: this connector's compute function does not currently use the partition key to filter the underlying API request -- every partition run re-fetches the same full resource set. Declaring a partition type here controls the materialization/backfill schedule in Dagster, not what data is fetched. If you need the fetch itself narrowed to a date window, this connector does not yet support that (see calendly_ingestion / pagerduty_events_ingestion for connectors where it is genuinely bound).",
      "required": false,
      "default": null,
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "hourly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "description": "Partition start date in ISO format. Required for time-based partition types.",
      "required": false,
      "default": null
    },
    "partition_values": {
      "type": "string",
      "label": "Partition Values",
      "description": "Comma-separated values for static or multi partitioning.",
      "required": false,
      "default": null
    },
    "dynamic_partition_name": {
      "type": "string",
      "label": "Dynamic Partition Name",
      "description": "Name for DynamicPartitionsDefinition.",
      "required": false,
      "default": null
    },
    "partition_dimensions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "label": "Partition Dimensions",
      "description": "Multi-axis partition spec.",
      "required": false,
      "default": null
    },
    "retry_policy_max_retries": {
      "type": "integer",
      "label": "Retry Policy Max Retries",
      "description": "Max retries on asset failure.",
      "required": false,
      "default": null
    },
    "retry_policy_delay_seconds": {
      "type": "integer",
      "label": "Retry Policy Delay Seconds",
      "description": "Seconds between retries.",
      "required": false,
      "default": null
    },
    "retry_policy_backoff": {
      "type": "string",
      "label": "Retry Policy Backoff",
      "description": "Backoff strategy.",
      "required": false,
      "default": "exponential",
      "enum": [
        "exponential",
        "linear"
      ],
      "ui:widget": "select"
    },
    "column_lineage": {
      "type": "object",
      "label": "Column Lineage",
      "description": "Column-level lineage.",
      "required": false,
      "default": null
    }
  },
  "tags": [
    "ingestion",
    "braze",
    "dlt",
    "rest_api"
  ],
  "name": "Braze Ingestion"
}
