{
  "component_type": "dagster_component_templates.JiraIngestionComponent",
  "description": "Component for ingesting Jira issue tracking data using dlt.",
  "category": "ingestion",
  "icon": "si:jira",
  "x-dagster-io": {
    "outputs": {
      "type": "MaterializeResult",
      "description": "Ingestion result with row count"
    }
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "description": "Name of the asset to create",
      "required": true
    },
    "domain": {
      "type": "string",
      "label": "Domain",
      "description": "Jira domain (e.g., your-company.atlassian.net)",
      "required": true
    },
    "email": {
      "type": "string",
      "label": "Email",
      "description": "Email address for Jira authentication",
      "required": true
    },
    "api_token": {
      "type": "string",
      "label": "Api Token",
      "description": "Jira API token for authentication",
      "required": true,
      "ui:widget": "password"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Resources",
      "description": "Jira resources to extract (issues, users, projects, boards)",
      "required": false,
      "default": [
        "issues",
        "projects"
      ],
      "ui:widget": "list"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Asset description",
      "required": false,
      "default": null,
      "ui:widget": "code"
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "description": "Asset group for organization",
      "required": false,
      "default": "jira"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "description": "Asset owners — team names (team:analytics) or email addresses.",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "type": "object",
      "label": "Asset Tags",
      "description": "Key-value tags applied to the asset in the Dagster catalog, e.g. {\"domain\": \"finance\"}.",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "description": "Asset kinds shown in the Dagster catalog (e.g. snowflake, python). Auto-inferred from component name if empty.",
      "required": false,
      "ui:widget": "list"
    },
    "freshness_max_lag_minutes": {
      "type": "integer",
      "label": "Freshness Max Lag (minutes)",
      "description": "Maximum acceptable lag in minutes before this asset is considered stale.",
      "required": false,
      "default": null
    },
    "freshness_cron": {
      "type": "string",
      "label": "Freshness Cron Schedule",
      "description": "Cron schedule for the freshness policy, e.g. '0 9 * * 1-5' (weekdays 9am).",
      "required": false,
      "default": null,
      "x-dagster-widget": "cron"
    },
    "include_preview_metadata": {
      "type": "boolean",
      "label": "Include Preview Metadata",
      "description": "Include sample data preview in metadata",
      "required": false,
      "default": true,
      "ui:widget": "checkbox"
    },
    "preview_rows": {
      "type": "integer",
      "label": "Preview Rows",
      "description": "How many rows to include in the preview. Large tables (>10× this number) are sampled randomly.",
      "required": false,
      "default": 25
    },
    "destination": {
      "type": "string",
      "label": "Destination",
      "description": "dlt destination identifier (e.g. 'snowflake', 'bigquery', 'postgres', 'redshift', 'filesystem', 'duckdb', 'databricks', 'athena', 'clickhouse', 'mssql', 'motherduck'). Leave empty for in-memory DuckDB → DataFrame mode.",
      "required": false,
      "default": null,
      "enum": [
        "snowflake",
        "bigquery",
        "postgres",
        "redshift",
        "filesystem",
        "duckdb",
        "databricks",
        "athena",
        "clickhouse",
        "mssql",
        "motherduck"
      ],
      "ui:widget": "select"
    },
    "deps": {
      "type": "array",
      "label": "Deps",
      "description": "Upstream asset keys this asset depends on (e.g. ['raw_orders', 'schema/asset'])",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      },
      "ui:widget": "list"
    },
    "dataset_name": {
      "type": "string",
      "label": "Dataset Name",
      "required": false
    },
    "persist_only": {
      "type": "boolean",
      "label": "Persist Only",
      "required": false,
      "default": false
    },
    "destination_credentials_url": {
      "type": "string",
      "label": "Destination Credentials Url",
      "required": false
    },
    "destination_credentials_env_var": {
      "type": "string",
      "label": "Destination Credentials Env Var",
      "required": false
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "retry_policy_max_retries": {
      "type": "integer",
      "label": "Retry Policy Max Retries",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "type": "integer",
      "label": "Retry Policy Delay Seconds",
      "required": false
    },
    "retry_policy_backoff": {
      "type": "string",
      "label": "Retry Policy Backoff",
      "required": false,
      "default": "exponential",
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    },
    "column_lineage": {
      "type": "object",
      "label": "Column Lineage",
      "required": false,
      "description": "Column-level lineage: output column → list of upstream columns it derives from, e.g. {'revenue': ['price', 'quantity']}."
    },
    "partition_date_column": {
      "type": "string",
      "label": "Partition Date Column",
      "required": false,
      "x-dagster-widget": "column"
    },
    "partition_values": {
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "partition_static_dim": {
      "type": "string",
      "label": "Partition Static Dim",
      "required": false,
      "x-dagster-widget": "column"
    },
    "partition_static_column": {
      "type": "string",
      "label": "Partition Static Column",
      "required": false,
      "x-dagster-widget": "column"
    },
    "dynamic_partition_name": {
      "type": "string",
      "label": "Dynamic Partition Name",
      "description": "Name for DynamicPartitionsDefinition (when partition_type='dynamic'), e.g. 'tenants'.",
      "required": false,
      "default": null
    },
    "partition_dimensions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "label": "Partition Dimensions",
      "description": "Multi-axis partition spec: list of {name, type, start, values, dynamic_partition_name} dicts. Overrides flat fields when set.",
      "required": false,
      "default": null
    }
  },
  "tags": [
    "ingestion",
    "jira"
  ],
  "name": "Jira Ingestion"
}
