{
  "component_type": "dagster_community_components.OpenAPIIngestionComponent",
  "description": "Create one Dagster asset per OpenAPI tag group, backed by a cached spec.",
  "category": "ingestion",
  "vertical": "internal",
  "icon": "ArrowUpFromLine",
  "x-dagster-io": {
    "outputs": {
      "type": "MaterializeResult",
      "description": "Ingestion result with row count"
    }
  },
  "attributes": {
    "spec_url": {
      "type": "string",
      "label": "Spec URL",
      "required": false,
      "default": null
    },
    "spec_path": {
      "type": "string",
      "label": "Spec Path",
      "required": false,
      "default": null
    },
    "api_base_url_env_var": {
      "type": "string",
      "label": "API Base URL Env Var",
      "required": false,
      "default": "API_BASE_URL"
    },
    "api_key_env_var": {
      "type": "string",
      "label": "API Key Env Var",
      "required": false,
      "default": null
    },
    "auth_header": {
      "type": "string",
      "label": "Auth Header",
      "required": false,
      "default": "Authorization"
    },
    "auth_prefix": {
      "type": "string",
      "label": "Auth Prefix",
      "required": false,
      "default": "Bearer"
    },
    "database_url_env_var": {
      "type": "string",
      "label": "Database URL Env Var",
      "required": false,
      "default": "DATABASE_URL"
    },
    "schema_name": {
      "type": "string",
      "label": "Schema Name",
      "required": false,
      "default": null
    },
    "if_exists": {
      "type": "string",
      "label": "If Exists",
      "required": false,
      "default": "replace"
    },
    "include_tags": {
      "type": "string",
      "label": "Include Tags",
      "required": false,
      "default": null
    },
    "exclude_tags": {
      "type": "string",
      "label": "Exclude Tags",
      "required": false,
      "default": null
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "openapi",
      "description": "Dagster asset group name"
    },
    "page_size": {
      "type": "integer",
      "label": "Page Size",
      "required": false,
      "default": 100
    },
    "max_pages": {
      "type": "integer",
      "label": "Max Pages",
      "required": false,
      "default": 100
    },
    "defs_state": {
      "type": "string",
      "label": "Defs State",
      "required": false,
      "default": null
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "description": "Partition type: 'daily' / 'weekly' / 'monthly' / 'hourly' / None for unpartitioned.",
      "required": false,
      "default": null,
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "hourly"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "required": false,
      "default": null
    },
    "partition_date_column": {
      "type": "string",
      "label": "Partition Date Column",
      "description": "Column used to filter the upstream DataFrame to the current date partition key.",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "backfill_policy": {
      "type": "string",
      "label": "Backfill Policy",
      "description": "Backfill execution strategy for a partitioned asset. 'single_run' materializes an entire backfill range in one run: each tag asset's full result set is fetched once (as always) and then filtered down to the whole range via Partition Date Column before being written. 'multi_run' launches one run per partition (optionally capped via Backfill Max Partitions Per Run). Leave empty for Dagster's default (one run per partition, uncapped). Ignored when Partition Type is not set.",
      "required": false,
      "default": null,
      "enum": [
        "single_run",
        "multi_run"
      ],
      "ui:widget": "select"
    },
    "backfill_policy_max_partitions_per_run": {
      "type": "integer",
      "label": "Backfill Max Partitions Per Run",
      "description": "For Backfill Policy = 'multi_run' only: maximum partitions materialized per run. Leave empty for Dagster's default (1).",
      "required": false,
      "default": null
    }
  },
  "tags": [
    "ingestion",
    "openapi",
    "asset"
  ],
  "name": "OpenAPI Asset"
}
