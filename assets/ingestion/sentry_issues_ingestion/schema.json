{
  "component_type": "dagster_community_components.SentryIssuesIngestionComponent",
  "description": "Ingest issues from a Sentry project via the /api/0/projects/{org}/{project}/issues/ REST endpoint. Handles cursor pagination via the Link header. Returns a DataFrame with flattened issue fields.",
  "category": "ingestion",
  "icon": "AlertCircle",
  "x-dagster-io": {
    "outputs": {
      "type": "dataframe",
      "description": "pandas DataFrame with one row per vendor record. Chain a downstream sink component (dataframe_to_snowflake / _to_bigquery / _to_duckdb / ...) to persist."
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true
    },
    "organization": {"label": "Organization", 
      "type": "string",
      "required": true,
      "description": "Sentry org slug."
    },
    "project": {"label": "Project", 
      "type": "string",
      "required": true,
      "description": "Sentry project slug."
    },
    "api_host": {"label": "API Host", 
      "type": "string",
      "required": false,
      "default": "https://sentry.io"
    },
    "api_token_env_var": {"label": "API Token Env Var", 
      "type": "string",
      "required": false,
      "default": "SENTRY_AUTH_TOKEN"
    },
    "query": {"label": "Query", 
      "type": "string",
      "required": false,
      "default": "is:unresolved"
    },
    "stats_period": {"label": "Stats Period", 
      "type": "string",
      "required": false,
      "default": "24h"
    },
    "limit": {"label": "Limit", 
      "type": "integer",
      "required": false,
      "default": 1000,
      "minimum": 1,
      "maximum": 10000
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false,
      "default": "sentry"
    }
  }
}
