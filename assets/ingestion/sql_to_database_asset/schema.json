{
  "component_type": "dagster_component_templates.SQLToDatabaseAssetComponent",
  "description": "Read from a source database and write to a destination database table.",
  "category": "ingestion",
  "icon": "ArrowUpFromLine",
  "x-dagster-io": {
    "outputs": {
      "type": "MaterializeResult",
      "description": "Ingestion result with row count"
    }
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "description": "Dagster asset name",
      "required": true
    },
    "source_url_env_var": {
      "type": "string",
      "label": "Source Url Env Var",
      "description": "Env var with source SQLAlchemy database URL",
      "required": true
    },
    "destination_url_env_var": {
      "type": "string",
      "label": "Destination Url Env Var",
      "description": "Env var with destination SQLAlchemy database URL",
      "required": true
    },
    "source_table": {
      "type": "string",
      "label": "Source Table",
      "description": "Source table name (use source_table OR source_query)",
      "required": false,
      "default": null
    },
    "source_schema": {
      "type": "string",
      "label": "Source Schema",
      "description": "Source schema name",
      "required": false,
      "default": null
    },
    "source_query": {
      "type": "string",
      "label": "Source Query",
      "description": "Custom SQL query (overrides source_table)",
      "required": false,
      "default": null,
      "ui:widget": "code"
    },
    "destination_table": {
      "type": "string",
      "label": "Destination Table",
      "description": "Destination table name",
      "required": true
    },
    "destination_schema": {
      "type": "string",
      "label": "Destination Schema",
      "description": "Destination schema name",
      "required": false,
      "default": null
    },
    "if_exists": {
      "type": "string",
      "label": "If Exists",
      "description": "One of: fail / replace / append.",
      "required": false,
      "default": "append",
      "enum": [
        "fail",
        "replace",
        "append"
      ],
      "ui:widget": "select"
    },
    "watermark_column": {
      "type": "string",
      "label": "Watermark Column",
      "description": "Incremental watermark column (e.g. updated_at, id)",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "watermark_env_var": {
      "type": "string",
      "label": "Watermark Env Var",
      "description": "Env var storing the last watermark value",
      "required": false,
      "default": null
    },
    "chunksize": {
      "type": "integer",
      "label": "Chunksize",
      "description": "Rows to read/write per chunk",
      "required": false,
      "default": 10000
    },
    "column_mapping": {
      "type": "object",
      "label": "Column Mapping",
      "description": "Rename columns: {old: new}",
      "required": false,
      "default": null,
      "ui:widget": "key-value"
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "description": "Asset group name",
      "required": false,
      "default": "ingestion"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "description": "Asset owners — team names (team:analytics) or email addresses.",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "type": "object",
      "label": "Asset Tags",
      "description": "Key-value tags applied to the asset in the Dagster catalog, e.g. {\"domain\": \"finance\"}.",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "description": "Asset kinds shown in the Dagster catalog (e.g. snowflake, python). Auto-inferred from component name if empty.",
      "required": false,
      "ui:widget": "list"
    },
    "freshness_max_lag_minutes": {
      "type": "integer",
      "label": "Freshness Max Lag (minutes)",
      "description": "Maximum acceptable lag in minutes before this asset is considered stale.",
      "required": false,
      "default": null
    },
    "freshness_cron": {
      "type": "string",
      "label": "Freshness Cron Schedule",
      "description": "Cron schedule for the freshness policy, e.g. '0 9 * * 1-5' (weekdays 9am).",
      "required": false,
      "default": null,
      "x-dagster-widget": "cron"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Description",
      "required": false,
      "default": null,
      "ui:widget": "code"
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "description": "One of: daily / hourly / weekly / monthly / static / multi / dynamic.",
      "required": false,
      "default": "none",
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start_date": {
      "type": "string",
      "label": "Partition Start Date",
      "description": "Partition start date YYYY-MM-DD (required if partition_type != none)",
      "required": false,
      "default": null
    },
    "deps": {
      "type": "array",
      "label": "Deps",
      "description": "Upstream asset keys this asset depends on (e.g. ['raw_orders', 'schema/asset'])",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      },
      "ui:widget": "list"
    },
    "retry_policy_max_retries": {
      "type": "integer",
      "label": "Retry Policy Max Retries",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "type": "integer",
      "label": "Retry Policy Delay Seconds",
      "required": false
    },
    "retry_policy_backoff": {
      "type": "string",
      "label": "Retry Policy Backoff",
      "required": false,
      "default": "exponential",
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    },
    "column_lineage": {
      "type": "object",
      "label": "Column Lineage",
      "required": false,
      "description": "Column-level lineage: output column → list of upstream columns it derives from, e.g. {'revenue': ['price', 'quantity']}."
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "partition_date_column": {
      "type": "string",
      "label": "Partition Date Column",
      "required": false,
      "x-dagster-widget": "column"
    },
    "partition_values": {
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "partition_static_dim": {
      "type": "string",
      "label": "Partition Static Dim",
      "required": false,
      "x-dagster-widget": "column"
    },
    "partition_static_column": {
      "type": "string",
      "label": "Partition Static Column",
      "required": false,
      "x-dagster-widget": "column"
    }
  },
  "tags": [
    "ingestion",
    "sql",
    "database",
    "asset"
  ],
  "name": "SQL to Database"
}
