{
  "component_type": "dagster_component_templates.DataframeToAmplitudeComponent",
  "description": "Reverse-ETL sink \u2014 POST DataFrame rows as Amplitude events via HTTP V2 API (POST /2/httpapi, up to 1000/batch). Sets event_type + user_id/device_id + event_properties + user_properties per row.",
  "category": "reverse_etl",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true
    },
    "outputs": {
      "type": "MaterializeResult"
    }
  },
  "icon": "si:amplitude",
  "attributes": {
    "asset_name": {
      "label": "Asset Name",
      "type": "string",
      "required": true
    },
    "upstream_asset_key": {
      "label": "Upstream Asset Key",
      "type": "string",
      "required": false
    },
    "source": {
      "label": "Source",
      "type": "object",
      "required": false
    },
    "resource_key": {
      "label": "Resource Key",
      "type": "string",
      "required": false
    },
    "api_key_env_var": {
      "label": "API Key Env Var",
      "type": "string",
      "required": false
    },
    "base_url": {
      "label": "Base URL",
      "type": "string",
      "required": false
    },
    "event_type_column": {
      "label": "Event Type Column",
      "type": "string",
      "required": false,
      "description": "Column with event_type; supply this OR `default_event_type`."
    },
    "default_event_type": {
      "label": "Default Event Type",
      "type": "string",
      "required": false,
      "description": "Static fallback event_type."
    },
    "user_id_column": {
      "label": "User ID Column",
      "type": "string",
      "required": false
    },
    "device_id_column": {
      "label": "Device ID Column",
      "type": "string",
      "required": false,
      "description": "Required if user_id_column unset (Amplitude needs ONE identifier)."
    },
    "time_column": {
      "label": "Time Column",
      "type": "string",
      "required": false,
      "description": "Coerced to unix ms."
    },
    "insert_id_column": {
      "label": "Insert ID Column",
      "type": "string",
      "required": false,
      "description": "Per-event de-dup key (Amplitude drops repeats for 7d)."
    },
    "event_properties_map": {
      "label": "Event Properties Map",
      "type": "object",
      "required": false
    },
    "user_properties_map": {
      "label": "User Properties Map",
      "type": "object",
      "required": false
    },
    "event_property_columns": {
      "label": "Event Property Columns",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "batch_size": {
      "label": "Batch Size",
      "type": "integer",
      "required": false,
      "description": "Default 1000 (Amplitude V2 max)."
    },
    "dry_run": {
      "label": "Dry Run",
      "type": "boolean",
      "required": false,
      "default": false
    },
    "request_timeout_seconds": {
      "label": "Request Timeout Seconds",
      "type": "integer",
      "required": false,
      "default": 30
    },
    "group_name": {
      "label": "Group Name",
      "type": "string",
      "required": false
    },
    "description": {
      "label": "Description",
      "type": "string",
      "required": false
    },
    "deps": {
      "label": "Deps",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "owners": {
      "label": "Owners",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "asset_tags": {
      "label": "Asset Tags",
      "type": "object",
      "required": false
    },
    "kinds": {
      "label": "Kinds",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "retry_policy_max_retries": {
      "label": "Retry Policy Max Retries",
      "type": "integer",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "label": "Retry Policy Delay Seconds",
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {
      "label": "Retry Policy Backoff",
      "type": "string",
      "required": false,
      "default": "exponential"
    },
    "freshness_max_lag_minutes": {
      "label": "Freshness Max Lag Minutes",
      "type": "integer",
      "required": false
    },
    "freshness_cron": {
      "label": "Freshness Cron",
      "type": "string",
      "required": false
    },
    "partition_type": {
      "label": "Partition Type",
      "type": "string",
      "required": false
    },
    "partition_start": {
      "label": "Partition Start",
      "type": "string",
      "required": false
    },
    "partition_values": {
      "label": "Partition Values",
      "type": "string",
      "required": false
    },
    "dynamic_partition_name": {
      "label": "Dynamic Partition Name",
      "type": "string",
      "required": false
    }
  },
  "tags": [
    "sink",
    "amplitude",
    "reverse-etl",
    "product-analytics",
    "event-tracking",
    "user-properties"
  ],
  "name": "DataFrame to Amplitude"
}
