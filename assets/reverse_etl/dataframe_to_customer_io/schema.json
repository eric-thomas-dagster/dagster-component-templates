{
  "component_type": "dagster_component_templates.DataframeToCustomerIoComponent",
  "description": "Reverse-ETL sink \u2014 batch-POST DataFrame rows to Customer.io via /api/v2/batch (up to 100 ops/batch). Two modes: `identify` (upsert profile attributes) or `event` (bulk-track events).",
  "category": "reverse_etl",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true
    },
    "outputs": {
      "type": "MaterializeResult"
    }
  },
  "icon": "si:customerio",
  "attributes": {
    "asset_name": {
      "label": "Asset Name",
      "type": "string",
      "required": true
    },
    "upstream_asset_key": {
      "label": "Upstream Asset Key",
      "type": "string",
      "required": false
    },
    "source": {
      "label": "Source",
      "type": "object",
      "required": false
    },
    "resource_key": {
      "label": "Resource Key",
      "type": "string",
      "required": true
    },
    "mode": {
      "label": "Mode",
      "type": "string",
      "enum": [
        "identify",
        "event"
      ],
      "default": "identify",
      "required": false
    },
    "id_column": {
      "label": "ID Column",
      "type": "string",
      "required": false,
      "description": "Preferred identifier."
    },
    "email_column": {
      "label": "Email Column",
      "type": "string",
      "required": false
    },
    "cio_id_column": {
      "label": "Cio ID Column",
      "type": "string",
      "required": false
    },
    "event_name_column": {
      "label": "Event Name Column",
      "type": "string",
      "required": false,
      "description": "Required for mode='event' (or set default_event_name)."
    },
    "default_event_name": {
      "label": "Default Event Name",
      "type": "string",
      "required": false
    },
    "event_timestamp_column": {
      "label": "Event Timestamp Column",
      "type": "string",
      "required": false,
      "description": "For event mode. Coerced to unix seconds."
    },
    "fields_map": {
      "label": "Fields Map",
      "type": "object",
      "required": false
    },
    "attribute_columns": {
      "label": "Attribute Columns",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "batch_size": {
      "label": "Batch Size",
      "type": "integer",
      "required": false,
      "description": "Default 100 (Customer.io max)."
    },
    "dry_run": {
      "label": "Dry Run",
      "type": "boolean",
      "required": false,
      "default": false
    },
    "group_name": {
      "label": "Group Name",
      "type": "string",
      "required": false
    },
    "description": {
      "label": "Description",
      "type": "string",
      "required": false
    },
    "deps": {
      "label": "Deps",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "owners": {
      "label": "Owners",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "asset_tags": {
      "label": "Asset Tags",
      "type": "object",
      "required": false
    },
    "kinds": {
      "label": "Kinds",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "retry_policy_max_retries": {
      "label": "Retry Policy Max Retries",
      "type": "integer",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "label": "Retry Policy Delay Seconds",
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {
      "label": "Retry Policy Backoff",
      "type": "string",
      "required": false,
      "default": "exponential"
    },
    "freshness_max_lag_minutes": {
      "label": "Freshness Max Lag Minutes",
      "type": "integer",
      "required": false
    },
    "freshness_cron": {
      "label": "Freshness Cron",
      "type": "string",
      "required": false
    },
    "partition_type": {
      "label": "Partition Type",
      "type": "string",
      "required": false
    },
    "partition_start": {
      "label": "Partition Start",
      "type": "string",
      "required": false
    },
    "partition_values": {
      "label": "Partition Values",
      "type": "string",
      "required": false
    },
    "dynamic_partition_name": {
      "label": "Dynamic Partition Name",
      "type": "string",
      "required": false
    }
  },
  "tags": [
    "sink",
    "customer-io",
    "reverse-etl",
    "customer-engagement",
    "email",
