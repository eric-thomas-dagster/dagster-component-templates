{
  "component_type": "dagster_component_templates.DataframeToSegmentComponent",
  "description": "Reverse-ETL sink \u2014 batch-POST DataFrame rows to Segment via POST /v1/batch. Two modes: `identify` (traits sync) or `track` (event stream). Auto-packs ops under Segment's 500KB per-batch limit.",
  "category": "reverse_etl",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true
    },
    "outputs": {
      "type": "MaterializeResult"
    }
  },
  "icon": "si:segment",
  "attributes": {
    "asset_name": {
      "label": "Asset Name",
      "type": "string",
      "required": true
    },
    "upstream_asset_key": {
      "label": "Upstream Asset Key",
      "type": "string",
      "required": false
    },
    "source": {
      "label": "Source",
      "type": "object",
      "required": false
    },
    "resource_key": {
      "label": "Resource Key",
      "type": "string",
      "required": true
    },
    "mode": {
      "label": "Mode",
      "type": "string",
      "enum": [
        "identify",
        "track"
      ],
      "default": "identify",
      "required": false
    },
    "user_id_column": {
      "label": "User ID Column",
      "type": "string",
      "required": false
    },
    "anonymous_id_column": {
      "label": "Anonymous ID Column",
      "type": "string",
      "required": false,
      "description": "Required if user_id_column unset (Segment needs one)."
    },
    "event_column": {
      "label": "Event Column",
      "type": "string",
      "required": false,
      "description": "Required for mode='track' (or set default_event)."
    },
    "default_event": {
      "label": "Default Event",
      "type": "string",
      "required": false
    },
    "timestamp_column": {
      "label": "Timestamp Column",
      "type": "string",
      "required": false,
      "description": "Coerced to ISO 8601 (accepts int seconds/ms or datetime)."
    },
    "traits_map": {
      "label": "Traits Map",
      "type": "object",
      "required": false,
      "description": "identify mode: source_col -> traits key."
    },
    "properties_map": {
      "label": "Properties Map",
      "type": "object",
      "required": false,
      "description": "track mode: source_col -> properties key."
    },
    "fields_map": {
      "label": "Fields Map",
      "type": "object",
      "required": false,
      "description": "Alias for traits_map/properties_map when only one is needed."
    },
    "property_columns": {
      "label": "Property Columns",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "batch_size": {
      "label": "Batch Size",
      "type": "integer",
      "required": false,
      "description": "Default 100. Resource also enforces ~480KB payload budget."
    },
    "dry_run": {
      "label": "Dry Run",
      "type": "boolean",
      "required": false,
      "default": false
    },
    "group_name": {
      "label": "Group Name",
      "type": "string",
      "required": false
    },
    "description": {
      "label": "Description",
      "type": "string",
      "required": false
    },
    "deps": {
      "label": "Deps",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "owners": {
      "label": "Owners",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "asset_tags": {
      "label": "Asset Tags",
      "type": "object",
      "required": false
    },
    "kinds": {
      "label": "Kinds",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "retry_policy_max_retries": {
      "label": "Retry Policy Max Retries",
      "type": "integer",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "label": "Retry Policy Delay Seconds",
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {
      "label": "Retry Policy Backoff",
      "type": "string",
      "required": false,
      "default": "exponential"
    },
    "freshness_max_lag_minutes": {
      "label": "Freshness Max Lag Minutes",
      "type": "integer",
      "required": false
    },
    "freshness_cron": {
      "label": "Freshness Cron",
      "type": "string",
      "required": false
    },
    "partition_type": {
      "label": "Partition Type",
      "type": "string",
      "required": false
    },
    "partition_start": {
      "label": "Partition Start",
      "type": "string",
      "required": false
    },
    "partition_values": {
      "label": "Partition Values",
      "type": "string",
      "required": false
    },
    "dynamic_partition_name": {
      "label": "Dynamic Partition Name",
      "type": "string",
      "required": false
    }
  },
  "tags": [
    "sink",
    "segment",
    "cdp",
    "reverse-etl",
    "event-tracking",
    "customer-data-platform"
  ],
  "name": "DataFrame to Segment",
  "vertical": "marketing"
}
