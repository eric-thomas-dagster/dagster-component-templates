{
  "component_type": "dagster_component_templates.WooCommerceProductUpsertComponent",
  "description": "Reverse-ETL sink: mirror an upstream DataFrame into WooCommerce Products via the REST API v3. Search-then-write per row (WooCommerce has no native upsert) — GET /products?sku=X → PUT the match or POST a new product.",
  "category": "reverse_etl",
  "icon": "si:woocommerce",
  "vertical": "crm-sales",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "description": "pandas DataFrame from an upstream asset. Each row → one WooCommerce product (upserted by matching on sku)."
    },
    "outputs": {
      "type": "sink",
      "description": "Dagster asset materialization with metadata (rows_created / rows_updated / rows_errored). No downstream data — write side effect lands in WooCommerce."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output Dagster asset name.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true,
      "description": "Asset providing the DataFrame."
    },
    "resource_key": {
      "description": "Resource key registered by WooCommerceResourceComponent.",
      "type": "string",
      "label": "Resource Key",
      "required": false,
      "default": "woocommerce"
    },
    "fields_map": {
      "type": "object",
      "label": "Fields Map",
      "required": true,
      "description": "Upstream column → WooCommerce field name. MUST include a mapping to `sku`.",
      "ui:widget": "key-value"
    },
    "batch_size": {
      "type": "integer",
      "label": "Batch Size",
      "required": false,
      "default": 200,
      "description": "Max upstream rows per run (safety cap)."
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "woocommerce"
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Asset kinds (auto-includes 'woocommerce').",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    }
  },
  "tags": [
    "woocommerce",
    "sink",
    "reverse-etl",
    "upsert",
    "products",
    "e-commerce"
  ],
  "name": "WooCommerce Product Upsert"
}
