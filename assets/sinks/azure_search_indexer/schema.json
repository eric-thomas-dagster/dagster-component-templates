{
  "component_type": "dagster_component_templates.AzureSearchIndexerComponent",
  "description": "Push DataFrame rows as documents to an Azure AI Search index. Backbone of RAG, semantic search, enterprise knowledge bases. Each row = one document; the DataFrame must include the index's key field.",
  "category": "sink",
  "icon": "Search",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "description": "Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Asset key of upstream DataFrame",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "endpoint": {
      "description": "Azure AI Search endpoint URL, e.g. 'https://my-search.search.windows.net'",
      "type": "string",
      "label": "Endpoint",
      "required": true
    },
    "index_name": {
      "description": "Target search index (must already exist)",
      "type": "string",
      "label": "Index Name",
      "required": true
    },
    "api_key_env_var": {
      "description": "Env var holding an admin API key. Omit to use DefaultAzureCredential (Entra OAuth).",
      "type": "string",
      "label": "Api Key Env Var",
      "required": false,
      "default": null
    },
    "tenant_id_env_var": {
      "type": "string",
      "label": "Tenant Id Env Var",
      "required": false,
      "default": null
    },
    "client_id_env_var": {
      "type": "string",
      "label": "Client Id Env Var",
      "required": false,
      "default": null
    },
    "client_secret_env_var": {
      "type": "string",
      "label": "Client Secret Env Var",
      "required": false,
      "default": null
    },
    "action": {
      "description": "'upload' (insert/replace), 'merge' (partial update), 'mergeOrUpload', or 'delete'",
      "type": "string",
      "label": "Action",
      "required": false,
      "default": "mergeOrUpload",
      "enum": [
        "upload",
        "merge",
        "mergeOrUpload",
        "delete"
      ]
    },
    "batch_size": {
      "description": "Max documents per batch (Azure caps at 1000)",
      "type": "integer",
      "label": "Batch Size",
      "required": false,
      "default": 1000
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "label": "Kinds",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    }
  }
}