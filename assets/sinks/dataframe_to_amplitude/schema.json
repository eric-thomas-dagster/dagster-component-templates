{
  "component_type": "dagster_component_templates.DataframeToAmplitudeComponent",
  "description": "Reverse-ETL sink — POST DataFrame rows as Amplitude events via HTTP V2 API (POST /2/httpapi, up to 1000/batch). Sets event_type + user_id/device_id + event_properties + user_properties per row.",
  "category": "sink",
  "icon": "si:amplitude",
  "attributes": {
    "asset_name": {"type": "string", "required": true},
    "upstream_asset_key": {"type": "string", "required": false},
    "source": {"type": "object", "required": false},
    "resource_key": {"type": "string", "required": false},
    "api_key_env_var": {"type": "string", "required": false},
    "base_url": {"type": "string", "required": false},
    "event_type_column": {"type": "string", "required": false, "description": "Column with event_type; supply this OR `default_event_type`."},
    "default_event_type": {"type": "string", "required": false, "description": "Static fallback event_type."},
    "user_id_column": {"type": "string", "required": false},
    "device_id_column": {"type": "string", "required": false, "description": "Required if user_id_column unset (Amplitude needs ONE identifier)."},
    "time_column": {"type": "string", "required": false, "description": "Coerced to unix ms."},
    "insert_id_column": {"type": "string", "required": false, "description": "Per-event de-dup key (Amplitude drops repeats for 7d)."},
    "event_properties_map": {"type": "object", "required": false},
    "user_properties_map": {"type": "object", "required": false},
    "event_property_columns": {"type": "array", "items": {"type": "string"}, "required": false},
    "batch_size": {"type": "integer", "required": false, "description": "Default 1000 (Amplitude V2 max)."},
    "dry_run": {"type": "boolean", "required": false, "default": false},
    "request_timeout_seconds": {"type": "integer", "required": false, "default": 30},
    "group_name": {"type": "string", "required": false},
    "description": {"type": "string", "required": false},
    "deps": {"type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"type": "object", "required": false},
    "kinds": {"type": "array", "items": {"type": "string"}, "required": false},
    "retry_policy_max_retries": {"type": "integer", "required": false},
    "retry_policy_delay_seconds": {"type": "integer", "required": false},
    "retry_policy_backoff": {"type": "string", "required": false, "default": "exponential"},
    "freshness_max_lag_minutes": {"type": "integer", "required": false},
    "freshness_cron": {"type": "string", "required": false},
    "partition_type": {"type": "string", "required": false},
    "partition_start": {"type": "string", "required": false},
    "partition_values": {"type": "string", "required": false},
    "dynamic_partition_name": {"type": "string", "required": false}
  },
  "tags": ["sink", "amplitude", "reverse-etl", "product-analytics", "event-tracking", "user-properties"],
  "name": "DataFrame to Amplitude"
}
