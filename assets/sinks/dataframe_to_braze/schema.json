{
  "component_type": "dagster_component_templates.DataframeToBrazeComponent",
  "description": "Reverse-ETL sink — batch-POST DataFrame rows to Braze via the REST API for customer activation flows. Two endpoints: /users/track (user attribute sync) and /catalogs/{name}/items (catalog upsert).",
  "category": "sink",
  "icon": "si:braze",
  "x-dagster-io": {
    "inputs": {"type": "DataFrame", "description": "Rows to POST to Braze"},
    "outputs": {"type": "MaterializeResult", "description": "Export summary metadata"}
  },
  "attributes": {
    "asset_name": {"type": "string", "required": true, "label": "Asset Name"},
    "upstream_asset_key": {"type": "string", "required": true, "label": "Upstream Asset Key"},
    "api_key_env_var": {"type": "string", "required": false, "default": "BRAZE_API_KEY", "label": "API Key Env Var", "description": "Env var holding the Braze REST API key with the required scope."},
    "rest_endpoint": {"type": "string", "required": true, "label": "REST Endpoint URL", "description": "Region-specific Braze REST URL (e.g. https://rest.iad-01.braze.com)."},
    "endpoint": {
      "type": "string",
      "enum": ["users_track", "catalogs"],
      "default": "users_track",
      "required": false,
      "label": "Endpoint",
      "description": "Which Braze endpoint to POST to."
    },
    "catalog_name": {"type": "string", "required": false, "label": "Catalog Name", "description": "Required when endpoint='catalogs'."},
    "user_id_column": {"type": "string", "required": false, "default": "external_id", "label": "User ID Column"},
    "attribute_columns": {"type": "array", "items": {"type": "string"}, "required": false, "label": "Attribute Columns", "description": "Top-level user attributes. Default: all columns except id + custom."},
    "custom_attribute_columns": {"type": "array", "items": {"type": "string"}, "required": false, "label": "Custom Attribute Columns", "description": "Nested under 'custom_attributes' on the Braze user."},
    "item_id_column": {"type": "string", "required": false, "default": "id", "label": "Item ID Column (catalogs mode)"},
    "batch_size": {"type": "integer", "required": false, "label": "Batch Size", "description": "Default 75 for users_track, 50 for catalogs."},
    "request_timeout_seconds": {"type": "integer", "required": false, "default": 30, "label": "Request Timeout Seconds"},
    "dry_run": {"type": "boolean", "required": false, "default": false, "label": "Dry Run"},

    "group_name": {"type": "string", "required": false},
    "description": {"type": "string", "required": false},
    "deps": {"type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"type": "object", "required": false},
    "kinds": {"type": "array", "items": {"type": "string"}, "required": false},

    "retry_policy_max_retries": {"type": "integer", "required": false},
    "retry_policy_delay_seconds": {"type": "integer", "required": false},
    "retry_policy_backoff": {"type": "string", "required": false, "default": "exponential"},

    "freshness_max_lag_minutes": {"type": "integer", "required": false},
    "freshness_cron": {"type": "string", "required": false},

    "partition_type": {"type": "string", "required": false},
    "partition_start": {"type": "string", "required": false},
    "partition_values": {"type": "string", "required": false},
    "dynamic_partition_name": {"type": "string", "required": false}
  },
  "tags": ["sink", "braze", "reverse-etl", "customer-engagement", "marketing-activation", "user-track", "catalogs", "rest-api"],
  "name": "DataFrame to Braze"
}
