{
  "component_type": "dagster_component_templates.DataframeToCustomerIoComponent",
  "description": "Reverse-ETL sink — batch-POST DataFrame rows to Customer.io via /api/v2/batch (up to 100 ops/batch). Two modes: `identify` (upsert profile attributes) or `event` (bulk-track events).",
  "category": "sink",
  "icon": "si:customerio",
  "attributes": {
    "asset_name": {"type": "string", "required": true},
    "upstream_asset_key": {"type": "string", "required": false},
    "source": {"type": "object", "required": false},
    "resource_key": {"type": "string", "required": true},
    "mode": {"type": "string", "enum": ["identify", "event"], "default": "identify", "required": false},
    "id_column": {"type": "string", "required": false, "description": "Preferred identifier."},
    "email_column": {"type": "string", "required": false},
    "cio_id_column": {"type": "string", "required": false},
    "event_name_column": {"type": "string", "required": false, "description": "Required for mode='event' (or set default_event_name)."},
    "default_event_name": {"type": "string", "required": false},
    "event_timestamp_column": {"type": "string", "required": false, "description": "For event mode. Coerced to unix seconds."},
    "fields_map": {"type": "object", "required": false},
    "attribute_columns": {"type": "array", "items": {"type": "string"}, "required": false},
    "batch_size": {"type": "integer", "required": false, "description": "Default 100 (Customer.io max)."},
    "dry_run": {"type": "boolean", "required": false, "default": false},
    "group_name": {"type": "string", "required": false},
    "description": {"type": "string", "required": false},
    "deps": {"type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"type": "object", "required": false},
    "kinds": {"type": "array", "items": {"type": "string"}, "required": false},
    "retry_policy_max_retries": {"type": "integer", "required": false},
    "retry_policy_delay_seconds": {"type": "integer", "required": false},
    "retry_policy_backoff": {"type": "string", "required": false, "default": "exponential"},
    "freshness_max_lag_minutes": {"type": "integer", "required": false},
    "freshness_cron": {"type": "string", "required": false},
    "partition_type": {"type": "string", "required": false},
    "partition_start": {"type": "string", "required": false},
    "partition_values": {"type": "string", "required": false},
    "dynamic_partition_name": {"type": "string", "required": false}
  },
  "tags": ["sink", "customer-io", "reverse-etl", "customer-engagement", "email", "sms", "push", "in-app"],
  "name": "DataFrame to Customer.io"
}
