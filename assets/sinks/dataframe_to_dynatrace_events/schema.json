{
  "component_type": "dagster_component_templates.DataframeToDynatraceEventsComponent",
  "description": "Push DataFrame rows as Dynatrace events via the v2 Events API. Use for batch-job markers (deployments, ETL completions, anomalies) that should annotate Dynatrace's timeline.",
  "category": "sink",
  "icon": "Upload",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "description": "Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Asset key of upstream DataFrame",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "environment_url": {
      "description": "Dynatrace environment URL",
      "type": "string",
      "label": "Environment Url",
      "required": true
    },
    "api_token_env_var": {
      "description": "Env var holding the API token (events.ingest scope)",
      "type": "string",
      "label": "Api Token Env Var",
      "required": true
    },
    "event_type": {
      "description": "Dynatrace event type: 'CUSTOM_INFO' \\| 'CUSTOM_DEPLOYMENT' \\| 'CUSTOM_ANNOTATION' \\| 'AVAILABILITY_EVENT' \\| 'ERROR_EVENT' \\| 'PERFORMANCE_EVENT' \\| 'RESOURCE_CONTENTION_EVENT'",
      "type": "string",
      "label": "Event Type",
      "required": false,
      "default": "CUSTOM_INFO",
      "enum": [
        "CUSTOM_INFO",
        "CUSTOM_DEPLOYMENT",
        "CUSTOM_ANNOTATION",
        "AVAILABILITY_EVENT",
        "ERROR_EVENT",
        "PERFORMANCE_EVENT",
        "RESOURCE_CONTENTION_EVENT"
      ],
      "ui:widget": "select"
    },
    "title_column": {
      "description": "Column whose value becomes the event title. Default: synthesized from row.",
      "type": "string",
      "label": "Title Column",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "entity_selector": {
      "description": "Optional Dynatrace entity selector to attach events to. Example: 'type(HOST),tag(\"env:prod\")'. Required if you want events on a specific entity.",
      "type": "string",
      "label": "Entity Selector",
      "required": false,
      "default": null
    },
    "properties_columns": {
      "description": "Columns whose values become custom event properties. Default: all columns.",
      "type": "array",
      "label": "Properties Columns",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      },
      "x-dagster-widget": "columns"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "label": "Kinds",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    }
  }
}
