{
  "component_type": "dagster_component_templates.DataframeToIcebergTableComponent",
  "description": "Write a pandas DataFrame to an EXISTING Iceberg table (append or overwrite). For Iceberg tables shared with other engines \u2014 Snowflake, Trino, Spark, Flink, Databricks.",
  "category": "sink",
  "icon": "si:apacheiceberg",
  "x-dagster-io": {
    "inputs": {
      "upstream": {
        "type": "pandas.DataFrame",
        "required": true
      }
    },
    "outputs": {
      "type": "Output[None]"
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Upstream asset producing the DataFrame to write",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "catalog_type": {
      "description": "'rest' (default) \\| 'glue' \\| 'hive' \\| 'hadoop' \\| 'sql'",
      "type": "string",
      "label": "Catalog Type",
      "required": false,
      "default": "rest",
      "enum": [
        "rest",
        "glue",
        "hive",
        "hadoop",
        "sql"
      ],
      "ui:widget": "select"
    },
    "catalog_name": {
      "type": "string",
      "label": "Catalog Name",
      "required": false,
      "default": "default"
    },
    "catalog_properties": {
      "description": "Catalog-specific config. ${ENV_VAR} expansion supported.",
      "type": "object",
      "label": "Catalog Properties",
      "required": false,
      "ui:widget": "key-value"
    },
    "namespace": {
      "description": "Iceberg namespace",
      "type": "string",
      "label": "Namespace",
      "required": true
    },
    "mode": {
      "type": "string",
      "label": "Mode",
      "description": "'append' (default) | 'overwrite'",
      "required": false,
      "default": "append",
      "enum": [
        "append",
        "overwrite"
      ],
      "ui:widget": "select"
    },
    "overwrite_filter": {
      "type": "string",
      "label": "Overwrite Filter",
      "description": "Iceberg expression \u2014 supports {partition_key}",
      "required": false,
      "ui:widget": "code"
    },
    "skip_columns": {
      "description": "Columns to drop from the DataFrame before writing (e.g. internal pandas cols).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Skip Columns",
      "required": false,
      "ui:widget": "list",
      "x-dagster-widget": "columns"
    },
    "schema_evolution": {
      "description": "Allow Iceberg schema evolution if the DataFrame has new columns the table lacks. Use cautiously — Iceberg writers may fail if the table schema is locked.",
      "type": "boolean",
      "label": "Schema Evolution",
      "required": false,
      "default": false,
      "ui:widget": "checkbox"
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "ui:widget": "code"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "iceberg_sink"
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false,
      "ui:widget": "list"
    },
    "partition_type": {
      "description": "Partition type: 'daily', 'weekly', 'monthly', 'hourly', 'static', 'multi', 'dynamic', or None for unpartitioned.",
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "partition_values": {
      "description": "Comma-separated values for static or multi partitioning, e.g. 'customer_a,customer_b,customer_c'.",
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "dynamic_partition_name": {
      "description": "Name for DynamicPartitionsDefinition (when partition_type='dynamic').",
      "type": "string",
      "label": "Dynamic Partition Name",
      "required": false
    },
    "retry_policy_max_retries": {
      "description": "Max retries on asset failure. Defines a RetryPolicy.",
      "type": "integer",
      "label": "Retry Policy Max Retries",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "description": "Seconds between retries.",
      "type": "integer",
      "label": "Retry Policy Delay Seconds",
      "required": false
    },
    "retry_policy_backoff": {
      "description": "Backoff strategy: 'linear' or 'exponential'.",
      "type": "string",
      "label": "Retry Policy Backoff",
      "required": false,
      "default": "exponential",
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    }
  },
  "tags": [
    "sink",
    "iceberg",
    "lakehouse",
    "pyiceberg",
    "external-table"
  ],
  "name": "Dataframe \u2192 Iceberg Table"
}
