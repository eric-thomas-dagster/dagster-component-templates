{
  "component_type": "dagster_component_templates.DataframeToIterableComponent",
  "description": "Reverse-ETL sink — POST DataFrame rows to Iterable via bulk endpoints. Two modes: `users` (POST /api/users/bulkUpdate, up to 1000/batch) or `events` (POST /api/events/trackBulk, up to 1000/batch).",
  "category": "sink",
  "icon": "si:iterable",
  "attributes": {
    "asset_name": {"type": "string", "required": true},
    "upstream_asset_key": {"type": "string", "required": false},
    "source": {"type": "object", "required": false},
    "resource_key": {"type": "string", "required": false},
    "api_key_env_var": {"type": "string", "required": false},
    "base_url": {"type": "string", "required": false},
    "mode": {"type": "string", "enum": ["users", "events"], "default": "users", "required": false},
    "fields_map": {"type": "object", "required": false},
    "user_id_column": {"type": "string", "required": false},
    "email_column": {"type": "string", "required": false, "default": "email"},
    "prefer_user_id": {"type": "boolean", "required": false, "default": false},
    "event_name_column": {"type": "string", "required": false, "description": "Required for mode='events'."},
    "campaign_id_column": {"type": "string", "required": false},
    "data_field_columns": {"type": "array", "items": {"type": "string"}, "required": false},
    "batch_size": {"type": "integer", "required": false, "description": "Default 1000 (Iterable max)."},
    "dry_run": {"type": "boolean", "required": false, "default": false},
    "request_timeout_seconds": {"type": "integer", "required": false, "default": 30},
    "group_name": {"type": "string", "required": false},
    "description": {"type": "string", "required": false},
    "deps": {"type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"type": "object", "required": false},
    "kinds": {"type": "array", "items": {"type": "string"}, "required": false},
    "retry_policy_max_retries": {"type": "integer", "required": false},
    "retry_policy_delay_seconds": {"type": "integer", "required": false},
    "retry_policy_backoff": {"type": "string", "required": false, "default": "exponential"},
    "freshness_max_lag_minutes": {"type": "integer", "required": false},
    "freshness_cron": {"type": "string", "required": false},
    "partition_type": {"type": "string", "required": false},
    "partition_start": {"type": "string", "required": false},
    "partition_values": {"type": "string", "required": false},
    "dynamic_partition_name": {"type": "string", "required": false}
  },
  "tags": ["sink", "iterable", "reverse-etl", "customer-engagement", "email", "sms", "push", "events"],
  "name": "DataFrame to Iterable"
}
