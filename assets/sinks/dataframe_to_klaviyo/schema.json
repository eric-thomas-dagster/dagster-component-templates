{
  "component_type": "dagster_component_templates.DataframeToKlaviyoComponent",
  "description": "Reverse-ETL sink — POST DataFrame rows as Klaviyo profile updates via the async bulk profile-import job endpoint. Two source shapes (upstream_asset_key OR inline source). Reserved fields (email, phone_number, external_id, first_name, ...) land at the top level; everything else nests under `properties`.",
  "category": "sink",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true
    },
    "outputs": {
      "type": "MaterializeResult"
    }
  },
  "icon": "si:klaviyo",
  "attributes": {
    "asset_name": {"label": "Asset Name", "type": "string", "required": true},
    "upstream_asset_key": {"label": "Upstream Asset Key", "type": "string", "required": false},
    "source": {"label": "Source", "type": "object", "required": false, "description": "{kind: sql|csv|inline, ...}"},
    "resource_key": {"label": "Resource Key", "type": "string", "required": false, "description": "KlaviyoResourceComponent key."},
    "api_key_env_var": {"label": "API Key Env Var", "type": "string", "required": false},
    "api_revision": {"label": "API Revision", "type": "string", "required": false},
    "list_id": {"label": "List ID", "type": "string", "required": false, "description": "Optional Klaviyo list id to add all profiles to."},
    "fields_map": {"label": "Fields Map", "type": "object", "required": false},
    "email_column": {"label": "Email Column", "type": "string", "required": false, "default": "email"},
    "phone_column": {"label": "Phone Column", "type": "string", "required": false},
    "external_id_column": {"label": "External ID Column", "type": "string", "required": false},
    "property_columns": {"label": "Property Columns", "type": "array", "items": {"type": "string"}, "required": false},
    "batch_size": {"label": "Batch Size", "type": "integer", "required": false, "description": "Default 10000 (Klaviyo bulk-import job max)."},
    "dry_run": {"label": "Dry Run", "type": "boolean", "required": false, "default": false},
    "request_timeout_seconds": {"label": "Request Timeout Seconds", "type": "integer", "required": false, "default": 30},
    "group_name": {"label": "Group Name", "type": "string", "required": false},
    "description": {"label": "Description", "type": "string", "required": false},
    "deps": {"label": "Deps", "type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"label": "Owners", "type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"label": "Asset Tags", "type": "object", "required": false},
    "kinds": {"label": "Kinds", "type": "array", "items": {"type": "string"}, "required": false},
    "retry_policy_max_retries": {"label": "Retry Policy Max Retries", "type": "integer", "required": false},
    "retry_policy_delay_seconds": {"label": "Retry Policy Delay Seconds", "type": "integer", "required": false},
    "retry_policy_backoff": {"label": "Retry Policy Backoff", "type": "string", "required": false, "default": "exponential"},
    "freshness_max_lag_minutes": {"label": "Freshness Max Lag Minutes", "type": "integer", "required": false},
    "freshness_cron": {"label": "Freshness Cron", "type": "string", "required": false},
    "partition_type": {"label": "Partition Type", "type": "string", "required": false},
    "partition_start": {"label": "Partition Start", "type": "string", "required": false},
    "partition_values": {"label": "Partition Values", "type": "string", "required": false},
    "dynamic_partition_name": {"label": "Dynamic Partition Name", "type": "string", "required": false}
  },
  "tags": ["sink", "klaviyo", "reverse-etl", "customer-engagement", "email", "sms", "e-commerce", "profile-sync"],
  "name": "DataFrame to Klaviyo"
}
