{
  "component_type": "dagster_component_templates.DataframeToODataComponent",
  "description": "Sink \u2014 write a pandas DataFrame to an OData v2/v4 entity set via POST / PATCH / DELETE.",
  "category": "sink",
  "icon": "si:odata",
  "x-dagster-io": {
    "inputs": {
      "upstream": {
        "type": "pandas.DataFrame",
        "required": true
      }
    },
    "outputs": {
      "type": "Output[None]"
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Upstream asset producing the DataFrame to write",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "service_url": {
      "description": "Base service URL",
      "type": "string",
      "label": "Service URL",
      "required": true
    },
    "entity_set": {
      "description": "Entity set to write to",
      "type": "string",
      "label": "Entity Set",
      "required": true
    },
    "odata_version": {
      "description": "'v2' (default) or 'v4'.",
      "type": "string",
      "label": "OData Version",
      "required": false,
      "default": "v2",
      "enum": [
        "v2",
        "v4"
      ],
      "ui:widget": "select"
    },
    "mode": {
      "type": "string",
      "label": "Mode",
      "description": "'insert' | 'upsert' | 'delete'",
      "required": false,
      "default": "insert",
      "enum": [
        "insert",
        "upsert",
        "delete"
      ],
      "ui:widget": "select"
    },
    "key_column": {
      "type": "string",
      "label": "Key Column",
      "description": "Required for upsert / delete",
      "required": false,
      "x-dagster-widget": "column"
    },
    "auth_type": {
      "description": "'basic' \\| 'bearer' \\| 'none'",
      "type": "string",
      "label": "Auth Type",
      "required": false,
      "default": "basic",
      "enum": [
        "basic",
        "bearer",
        "none"
      ],
      "ui:widget": "select"
    },
    "auth_username_env_var": {
      "type": "string",
      "label": "Auth Username Env Var",
      "required": false
    },
    "auth_password_env_var": {
      "type": "string",
      "label": "Auth Password Env Var",
      "required": false
    },
    "auth_token_env_var": {
      "type": "string",
      "label": "Auth Token Env Var",
      "required": false
    },
    "extra_headers": {
      "description": "Extra HTTP headers (sap-client, sap-language, ...).",
      "type": "object",
      "label": "Extra Headers",
      "required": false,
      "ui:widget": "key-value"
    },
    "csrf_fetch_path": {
      "type": "string",
      "label": "CSRF Fetch Path",
      "description": "Path to fetch x-csrf-token from before writes.",
      "required": false
    },
    "verify_ssl": {
      "type": "boolean",
      "label": "Verify SSL",
      "required": false,
      "default": true,
      "ui:widget": "checkbox"
    },
    "skip_columns": {
      "description": "Columns to drop before serializing the row body (e.g. internal pandas columns).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Skip Columns",
      "required": false,
      "ui:widget": "list",
      "x-dagster-widget": "columns"
    },
    "batch_mode": {
      "description": "Use OData $batch protocol — bundles many writes into one HTTP request. Supported by S/4HANA and SuccessFactors. NOT supported by all OData servers; leave off unless you're sure.",
      "type": "boolean",
      "label": "Batch Mode ($batch)",
      "required": false,
      "default": false,
      "ui:widget": "checkbox"
    },
    "batch_size": {
      "description": "$batch chunk size when batch_mode=true",
      "type": "integer",
      "label": "Batch Size",
      "required": false,
      "default": 100
    },
    "rate_limit_max_retries": {
      "type": "integer",
      "label": "Rate Limit Max Retries",
      "required": false,
      "default": 5
    },
    "rate_limit_backoff_seconds": {
      "type": "number",
      "label": "Rate Limit Backoff (s)",
      "required": false,
      "default": 2.0
    },
    "request_timeout_seconds": {
      "type": "integer",
      "label": "Request Timeout (s)",
      "required": false,
      "default": 120
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "ui:widget": "code"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "odata_sink"
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "ui:widget": "list"
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false,
      "ui:widget": "list"
    },
    "partition_type": {
      "description": "Partition type: 'daily', 'weekly', 'monthly', 'hourly', 'static', 'multi', 'dynamic', or None for unpartitioned.",
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "partition_values": {
      "description": "Comma-separated values for static or multi partitioning, e.g. 'customer_a,customer_b,customer_c'.",
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "dynamic_partition_name": {
      "description": "Name for DynamicPartitionsDefinition (when partition_type='dynamic').",
      "type": "string",
      "label": "Dynamic Partition Name",
      "required": false
    },
    "retry_policy_max_retries": {
      "description": "Max retries on asset failure. Defines a RetryPolicy.",
      "type": "integer",
      "label": "Retry Policy Max Retries",
      "required": false
    },
    "retry_policy_delay_seconds": {
      "description": "Seconds between retries.",
      "type": "integer",
      "label": "Retry Policy Delay Seconds",
      "required": false
    },
    "retry_policy_backoff": {
      "description": "Backoff strategy: 'linear' or 'exponential'.",
      "type": "string",
      "label": "Retry Policy Backoff",
      "required": false,
      "default": "exponential",
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    }
  },
  "tags": [
    "sink",
    "odata",
    "sap",
    "s4hana",
    "dynamics365",
    "msgraph"
  ],
  "name": "Dataframe \u2192 OData"
}
