{
  "component_type": "dagster_component_templates.DataframeToSegmentComponent",
  "description": "Reverse-ETL sink — batch-POST DataFrame rows to Segment via POST /v1/batch. Two modes: `identify` (traits sync) or `track` (event stream). Auto-packs ops under Segment's 500KB per-batch limit.",
  "category": "sink",
  "icon": "si:segment",
  "attributes": {
    "asset_name": {"type": "string", "required": true},
    "upstream_asset_key": {"type": "string", "required": false},
    "source": {"type": "object", "required": false},
    "resource_key": {"type": "string", "required": true},
    "mode": {"type": "string", "enum": ["identify", "track"], "default": "identify", "required": false},
    "user_id_column": {"type": "string", "required": false},
    "anonymous_id_column": {"type": "string", "required": false, "description": "Required if user_id_column unset (Segment needs one)."},
    "event_column": {"type": "string", "required": false, "description": "Required for mode='track' (or set default_event)."},
    "default_event": {"type": "string", "required": false},
    "timestamp_column": {"type": "string", "required": false, "description": "Coerced to ISO 8601 (accepts int seconds/ms or datetime)."},
    "traits_map": {"type": "object", "required": false, "description": "identify mode: source_col -> traits key."},
    "properties_map": {"type": "object", "required": false, "description": "track mode: source_col -> properties key."},
    "fields_map": {"type": "object", "required": false, "description": "Alias for traits_map/properties_map when only one is needed."},
    "property_columns": {"type": "array", "items": {"type": "string"}, "required": false},
    "batch_size": {"type": "integer", "required": false, "description": "Default 100. Resource also enforces ~480KB payload budget."},
    "dry_run": {"type": "boolean", "required": false, "default": false},
    "group_name": {"type": "string", "required": false},
    "description": {"type": "string", "required": false},
    "deps": {"type": "array", "items": {"type": "string"}, "required": false},
    "owners": {"type": "array", "items": {"type": "string"}, "required": false},
    "asset_tags": {"type": "object", "required": false},
    "kinds": {"type": "array", "items": {"type": "string"}, "required": false},
    "retry_policy_max_retries": {"type": "integer", "required": false},
    "retry_policy_delay_seconds": {"type": "integer", "required": false},
    "retry_policy_backoff": {"type": "string", "required": false, "default": "exponential"},
    "freshness_max_lag_minutes": {"type": "integer", "required": false},
    "freshness_cron": {"type": "string", "required": false},
    "partition_type": {"type": "string", "required": false},
    "partition_start": {"type": "string", "required": false},
    "partition_values": {"type": "string", "required": false},
    "dynamic_partition_name": {"type": "string", "required": false}
  },
  "tags": ["sink", "segment", "cdp", "reverse-etl", "event-tracking", "customer-data-platform"],
  "name": "DataFrame to Segment"
}
