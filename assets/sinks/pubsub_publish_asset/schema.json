{
  "component_type": "dagster_component_templates.PubSubPublishAssetComponent",
  "description": "Publish DataFrame rows as Pub/Sub messages \u2014 one message per row. Columns can be mapped into Pub/Sub message attributes for downstream filter routing on subscribers.",
  "category": "sink",
  "icon": "si:googlecloud",
  "x-dagster-io": {
    "outputs": {
      "type": "DataFrame",
      "description": "Upstream DataFrame with pubsub_message_id (and optional _error) columns added."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output asset name.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Upstream DataFrame asset key.",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "credentials": {
      "type": "object",
      "label": "Credentials (dict)",
      "required": false,
      "default": null
    },
    "credentials_path": {
      "description": "Falls back to GOOGLE_APPLICATION_CREDENTIALS.",
      "type": "string",
      "label": "Credentials Path",
      "required": false,
      "default": null
    },
    "project_id": {
      "description": "GCP project. Defaults to the SA's project.",
      "type": "string",
      "label": "Project ID",
      "required": false,
      "default": null
    },
    "topic": {
      "type": "string",
      "label": "Topic",
      "required": true,
      "description": "Topic name (no projects/.../topics/ prefix)."
    },
    "auto_create_topic": {
      "description": "If True, create the topic if it doesn't exist (requires roles/pubsub.editor).",
      "type": "boolean",
      "label": "Auto-Create Topic",
      "required": false,
      "default": false
    },
    "message_column": {
      "type": "string",
      "label": "Message Column",
      "required": false,
      "default": null,
      "description": "Single column to publish. Default: JSON-serialize the whole row.",
      "x-dagster-widget": "column"
    },
    "attribute_columns": {
      "type": "array",
      "label": "Attribute Columns",
      "required": false,
      "items": {
        "type": "string"
      },
      "description": "Columns mapped to Pub/Sub message attributes.",
      "x-dagster-widget": "columns"
    },
    "ordering_key_column": {
      "description": "Optional column to use as Pub/Sub ordering_key (requires the topic to have message ordering enabled).",
      "type": "string",
      "label": "Ordering Key Column",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "flush_batch_size": {
      "description": "Flush publishes every N messages.",
      "type": "integer",
      "label": "Flush Batch Size",
      "required": false,
      "default": 100
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    }
  },
  "tags": [
    "sink",
    "google",
    "pubsub",
    "messaging",
    "streaming"
  ],
  "name": "Pub/Sub Publish"
}
