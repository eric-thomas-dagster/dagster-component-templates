{
  "component_type": "dagster_component_templates.AzureTableReaderComponent",
  "description": "Read entities from an Azure Table as a DataFrame. Supports OData filters for partition-scoped, RowKey-scoped, or property filtering.",
  "category": "source",
  "icon": "Table",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "description": "Output Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "account_name_env_var": {
      "type": "string",
      "label": "Account Name Env Var",
      "required": false,
      "default": "AZURE_STORAGE_ACCOUNT"
    },
    "account_key_env_var": {
      "type": "string",
      "label": "Account Key Env Var",
      "required": false,
      "default": "AZURE_STORAGE_ACCOUNT_KEY"
    },
    "table_name": {
      "description": "Table to read",
      "type": "string",
      "label": "Table Name",
      "required": true
    },
    "filter_query": {
      "description": "OData filter expression. Examples: \"PartitionKey eq 'orders' and RowKey gt '2026'\", \"category eq 'Electronics'\". Leave empty to read all entities.",
      "type": "string",
      "label": "Filter Query",
      "required": false,
      "default": null
    },
    "select": {
      "description": "Optional column projection — list of property names to return",
      "type": "array",
      "label": "Select",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "description": "Optional row cap (client-side; the server returns pages of 1000)",
      "type": "integer",
      "label": "Limit",
      "required": false,
      "default": null
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "label": "Kinds",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    }
  }
}