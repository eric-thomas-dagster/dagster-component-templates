{
  "component_type": "dagster_component_templates.DynatraceMetricsQueryComponent",
  "description": "Query Dynatrace metrics via the v2 Metrics API \u2192 DataFrame. Returns per-series rows with timestamps + dimensions.",
  "category": "source",
  "icon": "LineChart",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "description": "Output Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "environment_url": {
      "description": "Dynatrace environment URL",
      "type": "string",
      "label": "Environment Url",
      "required": true
    },
    "api_token_env_var": {
      "description": "Env var holding the API token (metrics.read scope)",
      "type": "string",
      "label": "Api Token Env Var",
      "required": true
    },
    "metric_selector": {
      "description": "Dynatrace metric selector. Example: 'builtin:host.cpu.usage:splitBy(dt.entity.host):avg' or 'builtin:tech.generic.cpu.usage:filter(eq(dt.entity.host,HOST-XXXX))'",
      "type": "string",
      "label": "Metric Selector",
      "required": true
    },
    "resolution": {
      "description": "Resolution: '1m', '5m', '1h', etc. Coarser resolutions cover longer time-frames.",
      "type": "string",
      "label": "Resolution",
      "required": false,
      "default": "1m"
    },
    "timeframe": {
      "description": "Time range: relative (now-Nh / now-Nd) or absolute ISO 8601 (start_iso/end_iso)",
      "type": "string",
      "label": "Timeframe",
      "required": false,
      "default": "now-1h"
    },
    "entity_selector": {
      "description": "Optional entity scope filter, e.g. 'type(HOST),tag(\"env:prod\")'",
      "type": "string",
      "label": "Entity Selector",
      "required": false,
      "default": null
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "label": "Kinds",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    }
  }
}