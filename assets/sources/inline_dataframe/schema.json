{
  "component_type": "dagster_component_templates.InlineDataframeComponent",
  "description": "Materialize a small literal DataFrame from inline YAML rows + optional per-column dtypes. For reference tables, fixtures, or Alteryx Text Input ports \u2014 where bundling a CSV is overkill.",
  "category": "source",
  "icon": "Table",
  "x-dagster-io": {
    "outputs": {
      "type": "dataframe"
    },
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Columns",
      "required": true,
      "x-dagster-widget": "columns"
    },
    "rows": {
      "type": "array",
      "label": "Rows",
      "description": "Each row is a list of values matching `columns` length.",
      "required": false
    },
    "dtypes": {
      "type": "object",
      "label": "Dtypes",
      "description": "Per-column dtype overrides (e.g. {quantity: Int64, unit_price: float64}). Numeric dtypes route through pd.to_numeric.",
      "required": false
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "required": false
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "description": "Defaults to ['inline', 'reference'].",
      "required": false
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "required": false
    },
    "freshness_max_lag_minutes": {"label": "Freshness Max Lag Minutes", 
      "type": "integer",
      "required": false
    },
    "freshness_cron": {"label": "Freshness Cron", 
      "type": "string",
      "required": false,
      "x-dagster-widget": "cron"
    }
  }
}
