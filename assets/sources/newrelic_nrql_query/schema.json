{
  "component_type": "dagster_component_templates.NewRelicNrqlQueryComponent",
  "description": "Run an NRQL query via NerdGraph \u2192 DataFrame. Use for ops dashboards, anomaly detection, capacity planning, alerting trends.",
  "category": "source",
  "icon": "Search",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "asset_name": {
      "description": "Output Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "api_key_env_var": {
      "description": "Env var holding the User API Key",
      "type": "string",
      "label": "Api Key Env Var",
      "required": true
    },
    "account_id": {
      "description": "New Relic Account ID",
      "type": "string",
      "label": "Account Id",
      "required": true
    },
    "region": {
      "description": "'US' or 'EU'",
      "type": "string",
      "label": "Region",
      "required": false,
      "default": "US",
      "enum": [
        "US",
        "EU"
      ]
    },
    "query": {
      "description": "NRQL query, e.g. 'SELECT count(*) FROM Transaction SINCE 1 hour ago FACET appName'",
      "type": "string",
      "label": "Query",
      "required": true
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "asset_tags": {
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object",
      "label": "Asset Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "label": "Kinds",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    }
  }
}