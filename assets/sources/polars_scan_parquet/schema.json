{
  "component_type": "dagster_component_templates.PolarsScanParquetComponent",
  "description": "Read parquet via polars's lazy scanner with predicate + column pushdown.",
  "category": "source",
  "icon": "si:polars",
  "x-dagster-io": {
    "outputs": {
      "type": "dataframe",
      "description": "Polars or pandas DataFrame with the scanned data"
    }
  },
  "attributes": {
    "asset_name": {
      "type": "string",
      "required": true,
      "label": "Asset Name"
    },
    "path": {
      "type": "string",
      "required": true,
      "label": "Path / Glob",
      "description": "Local path, glob, or cloud URI (s3:// / gs:// / az://)"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Columns",
      "description": "Projection pushdown \u2014 only these columns are read off disk.",
      "x-dagster-widget": "columns"
    },
    "predicate": {
      "type": "string",
      "label": "Predicate",
      "description": "SQL predicate pushed down to the parquet reader."
    },
    "storage_options": {
      "type": "object",
      "label": "Storage Options",
      "description": "Cloud auth options for polars/object_store."
    },
    "output_type": {
      "type": "string",
      "label": "Output Type",
      "enum": [
        "polars",
        "pandas"
      ],
      "default": "polars"
    },
    "n_rows": {
      "type": "integer",
      "label": "Max Rows",
      "description": "LIMIT \u2014 pushed down."
    },
    "streaming": {
      "type": "boolean",
      "label": "Streaming",
      "default": false
    },
    "group_name": {
      "type": "string",
      "label": "Asset Group"
    },
    "description": {"label": "Description", 
      "type": "string"
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object"
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_preview_metadata": {"label": "Include Preview Metadata", 
      "type": "boolean",
      "default": false
    },
    "preview_rows": {"label": "Preview Rows", 
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 500
    }
  }
}
