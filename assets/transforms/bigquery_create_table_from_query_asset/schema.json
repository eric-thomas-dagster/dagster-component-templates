{
  "component_type": "dagster_component_templates.BigQueryCreateTableFromQueryAssetComponent",
  "description": "CTAS as a Dagster asset — CREATE OR REPLACE TABLE / VIEW / MATERIALIZED VIEW from a SELECT statement. The transform layer of any BQ-native ELT pipeline.",
  "category": "transformation",
  "icon": "si:googlebigquery",
  "x-dagster-io": {
    "outputs": {
      "type": "DataFrame",
      "description": "One-row DataFrame with destination table metadata."
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output asset name.",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "credentials": {
      "type": "object",
      "label": "Credentials (dict)",
      "required": false,
      "default": null
    },
    "credentials_path": {
      "description": "Falls back to GOOGLE_APPLICATION_CREDENTIALS.",
      "type": "string",
      "label": "Credentials Path",
      "required": false,
      "default": null
    },
    "project_id": {
      "description": "Billing project. Defaults to the SA's project.",
      "type": "string",
      "label": "Project ID",
      "required": false,
      "default": null
    },
    "location": {
      "description": "BQ location (`US`, `EU`, etc.). Default: auto-detect.",
      "type": "string",
      "label": "Location",
      "required": false,
      "default": null
    },
    "destination_table_id": {
      "type": "string",
      "label": "Destination Table ID",
      "required": true,
      "description": "Fully-qualified, e.g. project.dataset.table"
    },
    "materialization": {
      "type": "string",
      "label": "Materialization",
      "required": false,
      "default": "table",
      "description": "One of: table / view / materialized_view.",
      "enum": [
        "table",
        "view",
        "materialized_view"
      ],
      "ui:widget": "select"
    },
    "query": {
      "description": "SELECT statement that defines the table contents. Supports {placeholder} substitution from query_params.",
      "type": "string",
      "label": "Query",
      "required": true,
      "ui:widget": "textarea"
    },
    "query_params": {
      "type": "object",
      "label": "Query Params",
      "required": false,
      "default": null
    },
    "table_options": {
      "description": "OPTIONS clause k/v map (e.g. `{description: 'cleaned orders', labels: {tier: gold}}`).",
      "type": "object",
      "label": "Table Options",
      "required": false,
      "default": null
    },
    "partition_field": {
      "description": "Column to partition the destination table by (e.g. 'order_date'). Adds PARTITION BY.",
      "type": "string",
      "label": "Partition Field",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "cluster_fields": {
      "description": "Columns to cluster on (max 4). Adds CLUSTER BY.",
      "type": "array",
      "label": "Cluster Fields",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "label": "Deps",
      "required": false,
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "default": null,
      "ui:widget": "textarea"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    }
  },
  "tags": [
    "transformation",
    "google",
    "bigquery",
    "ctas",
    "etl",
    "warehouse"
  ],
  "name": "BigQuery CTAS"
}
