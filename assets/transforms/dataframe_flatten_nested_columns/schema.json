{
  "component_type": "dagster_component_templates.DataframeFlattenNestedColumnsComponent",
  "description": "DataframeFlattenNestedColumnsComponent — JSON-stringify dict/list columns.",
  "category": "transformation",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": false
    },
    "outputs": {
      "type": "dataframe"
    }
  },
  "icon": "Braces",
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "required": false,
      "description": "Output asset name."
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "required": false,
      "description": "Upstream DataFrame asset key. Mutually exclusive with `source` -- set exactly one.",
      "default": null
    },
    "source": {
      "type": "object",
      "label": "Source",
      "description": "Pull rows directly via SQL instead of from an upstream asset: {kind: warehouse_query, resource_key: <registered resource> OR database_url_env_var: <env var>, sql: <query>}. Mutually exclusive with `upstream_asset_key` -- set exactly one.",
      "required": false,
      "default": null
    },
    "columns": {
      "type": "array",
      "label": "Columns",
      "required": false,
      "description": "Explicit columns to flatten. Default: every column with at least one dict/list value.",
      "items": {
        "type": "string"
      },
      "x-dagster-widget": "columns"
    },
    "exclude_columns": {
      "type": "array",
      "label": "Exclude Columns",
      "required": false,
      "description": "Skip these columns even if they contain dicts/lists.",
      "items": {
        "type": "string"
      },
      "x-dagster-widget": "columns"
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "label": "Owners",
      "required": false,
      "items": {
        "type": "string"
      }
    }
  },
  "tags": [
    "dataframe-flatten-nested-columns",
    "transforms"
  ],
  "name": "Dataframe Flatten Nested Columns"
}
