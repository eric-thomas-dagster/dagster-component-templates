{
  "component_type": "dagster_community_components.SpatialInfoComponent",
  "description": "Append geometry metadata columns (area, length, centroid, bounds, geom type) to a (Geo)DataFrame. Drop-in for Alteryx's Spatial Info tool.",
  "category": "transformation",
  "icon": "Info",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true,
      "description": "(Geo)DataFrame with a geometry column"
    },
    "outputs": {
      "type": "dataframe",
      "description": "Original columns plus selected metric columns"
    }
  },
  "attributes": {
    "asset_name": {
      "description": "Output Dagster asset name",
      "type": "string",
      "label": "Asset Name",
      "required": true
    },
    "upstream_asset_key": {
      "description": "Upstream (Geo)DataFrame with a geometry column",
      "type": "string",
      "label": "Upstream Asset Key",
      "required": true
    },
    "geometry_column": {
      "description": "Geometry column to inspect",
      "type": "string",
      "default": "geometry",
      "label": "Geometry Column",
      "x-dagster-widget": "column"
    },
    "metrics": {
      "description": "Which metrics to compute. Subset of: area, length, centroid, bounds, geom_type, num_points, is_valid. Centroid adds centroid_x + centroid_y; bounds adds minx/miny/maxx/maxy.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "area",
          "length",
          "centroid",
          "bounds",
          "geom_type",
          "num_points",
          "is_valid"
        ]
      },
      "default": null,
      "label": "Metrics"
    },
    "projected_crs": {
      "description": "Projected CRS used for area / length math (gives real-world units). Default is Web Mercator. For survey-grade results pick the right UTM zone (e.g. EPSG:32610 for the US West Coast).",
      "type": "string",
      "default": "EPSG:3857",
      "label": "Projected CRS"
    },
    "area_unit": {
      "description": "Unit for area: 'sq_meters' (default), 'sq_km', 'sq_miles', 'sq_feet'.",
      "type": "string",
      "enum": [
        "sq_meters",
        "sq_km",
        "sq_miles",
        "sq_feet"
      ],
      "default": "sq_meters",
      "label": "Area Unit"
    },
    "length_unit": {
      "description": "Unit for length: 'meters' (default), 'km', 'miles', 'feet'.",
      "type": "string",
      "enum": [
        "meters",
        "km",
        "miles",
        "feet"
      ],
      "default": "meters",
      "label": "Length Unit"
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name"
    }
  }
}
