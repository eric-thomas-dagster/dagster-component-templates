{
  "component_type": "dagster_component_templates.WarehouseFormulaComponent",
  "description": "Add/replace columns via inline SQL expressions (CTAS pushdown). Alteryx Formula In-DB equivalent.",
  "category": "transformation",
  "icon": "Calculator",
  "x-dagster-io": {
    "inputs": {
      "type": "table",
      "required": true
    },
    "outputs": {
      "type": "table"
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true
    },
    "database_url": {"label": "Database URL", 
      "type": "string"
    },
    "database_url_env_var": {"label": "Database URL Env Var", 
      "type": "string"
    },
    "dialect": {"label": "Dialect", 
      "type": "string",
      "required": true,
      "enum": [
        "duckdb",
        "postgres",
        "postgresql",
        "snowflake",
        "bigquery",
        "redshift",
        "databricks",
        "mssql",
        "mysql"
      ]
    },
    "upstream_table": {"label": "Upstream Table", 
      "type": "string",
      "required": true
    },
    "output_table": {"label": "Output Table", 
      "type": "string",
      "required": true
    },
    "expressions": {"label": "Expressions", 
      "type": "object",
      "required": true,
      "description": "Map of output_col \u2192 SQL expression (inlined verbatim into SELECT)."
    },
    "keep_existing": {"label": "Keep Existing", 
      "type": "boolean",
      "default": true,
      "description": "true: SELECT *, <new>. false + keep_columns: those cols + new. false alone: only new."
    },
    "keep_columns": {"label": "Keep Columns", 
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-dagster-widget": "columns"
    },
    "mode": {"label": "Mode", 
      "type": "string",
      "enum": [
        "replace",
        "create_if_not_exists"
      ],
      "default": "replace"
    },
    "group_name": {"label": "Group Name", 
      "type": "string"
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {"label": "Description", 
      "type": "string"
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object"
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_preview_metadata": {"label": "Include Preview Metadata", 
      "type": "boolean",
      "default": false
    },
    "preview_rows": {"label": "Preview Rows", 
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 200
    }
  }
}
