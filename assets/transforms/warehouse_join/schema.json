{
  "component_type": "dagster_component_templates.WarehouseJoinComponent",
  "description": "Join two tables in the warehouse via CTAS. No Python materialization.",
  "category": "transformation",
  "icon": "GitMerge",
  "x-dagster-io": {
    "inputs": {
      "type": "table",
      "required": true
    },
    "outputs": {
      "type": "table"
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true
    },
    "database_url": {"label": "Database URL", 
      "type": "string"
    },
    "database_url_env_var": {"label": "Database URL Env Var", 
      "type": "string"
    },
    "dialect": {"label": "Dialect", 
      "type": "string",
      "required": true,
      "enum": [
        "duckdb",
        "postgres",
        "postgresql",
        "snowflake",
        "bigquery",
        "redshift",
        "databricks",
        "mssql",
        "mysql"
      ]
    },
    "left_table": {"label": "Left Table", 
      "type": "string",
      "required": true
    },
    "right_table": {"label": "Right Table", 
      "type": "string",
      "required": true
    },
    "output_table": {"label": "Output Table", 
      "type": "string",
      "required": true
    },
    "how": {"label": "How", 
      "type": "string",
      "enum": [
        "inner",
        "left",
        "right",
        "outer",
        "full",
        "cross"
      ],
      "default": "inner"
    },
    "on_columns": {"label": "On Columns", 
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Join columns (same name on both sides). NB: not `on` \u2014 YAML 1.1 parses bare `on:` as a boolean.",
      "x-dagster-widget": "columns"
    },
    "left_on": {"label": "Left On", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "right_on": {"label": "Right On", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "select_cols": {"label": "Select Cols", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {"label": "Mode", 
      "type": "string",
      "enum": [
        "replace",
        "create_if_not_exists"
      ],
      "default": "replace"
    },
    "group_name": {"label": "Group Name", 
      "type": "string"
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {"label": "Description", 
      "type": "string"
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object"
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_preview_metadata": {"label": "Include Preview Metadata", 
      "type": "boolean",
      "default": false
    },
    "preview_rows": {"label": "Preview Rows", 
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 200
    }
  }
}
