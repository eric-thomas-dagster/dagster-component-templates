{
  "component_type": "dagster_component_templates.WarehouseMultiFieldFormulaComponent",
  "description": "Apply one formula template to N columns via CTAS. Alteryx Multi-Field Formula equivalent.",
  "category": "transformation",
  "icon": "Calculator",
  "x-dagster-io": {
    "inputs": {
      "type": "asset_reference",
      "required": true
    },
    "outputs": {
      "type": "asset_reference"
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "description": "Output Dagster asset name",
      "type": "string",
      "required": true
    },
    "database_url": {"label": "Database URL", 
      "type": "string"
    },
    "database_url_env_var": {"label": "Database URL Env Var", 
      "type": "string"
    },
    "dialect": {"label": "Dialect", 
      "description": "`f'SQL dialect: one of {sorted(_SUPPORTED_DIALECTS)}.'`",
      "type": "string",
      "required": true,
      "enum": [
        "duckdb",
        "postgres",
        "postgresql",
        "snowflake",
        "bigquery",
        "redshift",
        "databricks",
        "mssql",
        "mysql"
      ]
    },
    "upstream_table": {"label": "Upstream Table", 
      "description": "Source table name",
      "type": "string",
      "required": true
    },
    "output_table": {"label": "Output Table", 
      "description": "Destination table name",
      "type": "string",
      "required": true
    },
    "expression": {"label": "Expression", 
      "type": "string",
      "required": true,
      "description": "Formula template with {col} as the column-name placeholder. e.g. 'UPPER(TRIM({col}))'."
    },
    "columns": {"label": "Columns", 
      "description": "Columns to apply the expression to.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": true,
      "x-dagster-widget": "columns"
    },
    "output_mode": {"label": "Output Mode", 
      "description": "'replace' — transformed values overwrite the original columns (uses SELECT * EXCEPT(); duckdb/bigquery/snowflake/databricks only). 'add_suffix' — original passes through plus new <col><suffix> columns. 'add_prefix' — same with prefix instead of suffix.",
      "type": "string",
      "enum": [
        "replace",
        "add_suffix",
        "add_prefix"
      ],
      "default": "add_suffix"
    },
    "suffix": {"label": "Suffix", 
      "description": "Used when output_mode='add_suffix'.",
      "type": "string",
      "default": "_calc"
    },
    "prefix": {"label": "Prefix", 
      "description": "Used when output_mode='add_prefix'.",
      "type": "string",
      "default": "calc_"
    },
    "mode": {"label": "Mode", 
      "description": "'replace' or 'create_if_not_exists'",
      "type": "string",
      "enum": [
        "replace",
        "create_if_not_exists"
      ],
      "default": "replace"
    },
    "group_name": {"label": "Group Name", 
      "description": "Dagster asset group name.",
      "type": "string"
    },
    "deps": {"label": "Deps", 
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {"label": "Owners", 
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {"label": "Description", 
      "description": "Asset description.",
      "type": "string"
    },
    "asset_tags": {"label": "Asset Tags", 
      "description": "Additional key-value tags applied to the asset in the Dagster catalog.",
      "type": "object"
    },
    "kinds": {"label": "Kinds", 
      "description": "Asset kinds for the Dagster catalog.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_preview_metadata": {"label": "Include Preview Metadata", 
      "description": "Include a preview of the output data in metadata (sample rows) for builder UIs.",
      "type": "boolean",
      "default": false
    },
    "preview_rows": {"label": "Preview Rows", 
      "description": "Rows to include in the preview metadata when `include_preview_metadata` is True.",
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 200
    }
  }
}
