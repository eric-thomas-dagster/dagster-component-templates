{
  "component_type": "dagster_component_templates.WarehouseTopNPerGroupComponent",
  "description": "Top-N-per-group in the warehouse (ROW_NUMBER pushdown). No Python materialization.",
  "category": "transformation",
  "icon": "BarChart",
  "x-dagster-io": {
    "inputs": {
      "type": "table",
      "required": true
    },
    "outputs": {
      "type": "table"
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true
    },
    "database_url": {"label": "Database URL", 
      "type": "string"
    },
    "database_url_env_var": {"label": "Database URL Env Var", 
      "type": "string"
    },
    "dialect": {"label": "Dialect", 
      "type": "string",
      "required": true,
      "enum": [
        "duckdb",
        "postgres",
        "postgresql",
        "snowflake",
        "bigquery",
        "redshift",
        "databricks",
        "mssql",
        "mysql"
      ]
    },
    "upstream_table": {"label": "Upstream Table", 
      "type": "string",
      "required": true
    },
    "output_table": {"label": "Output Table", 
      "type": "string",
      "required": true
    },
    "group_by": {"label": "Group By", 
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": true,
      "x-dagster-widget": "columns"
    },
    "sort_by": {"label": "Sort By", 
      "type": "string",
      "required": true,
      "x-dagster-widget": "columns"
    },
    "n": {"label": "N", 
      "type": "integer",
      "default": 3,
      "minimum": 1
    },
    "ascending": {"label": "Ascending", 
      "type": "boolean",
      "default": false
    },
    "rank_column": {"label": "Rank Column", 
      "type": "string",
      "x-dagster-widget": "column"
    },
    "mode": {"label": "Mode", 
      "type": "string",
      "enum": [
        "replace",
        "create_if_not_exists"
      ],
      "default": "replace"
    },
    "group_name": {"label": "Group Name", 
      "type": "string"
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {"label": "Description", 
      "type": "string"
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object"
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "include_preview_metadata": {"label": "Include Preview Metadata", 
      "type": "boolean",
      "default": false
    },
    "preview_rows": {"label": "Preview Rows", 
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 200
    }
  }
}
