{
  "component_type": "dagster_component_templates.ExternalDeltaTableAsset",
  "description": "Declare an external Delta Lake table (written by Spark, Databricks, Trino, Flink, etc.) as an observable Dagster external asset. Engine-agnostic.",
  "category": "external",
  "x-dagster-io": {
    "outputs": {
      "type": "AssetSpec"
    }
  },
  "icon": "si:databricks",
  "attributes": {
    "asset_key": {
      "description": "Dagster asset key (slash-delimited)",
      "type": "string",
      "label": "Asset Key",
      "required": true
    },
    "table_uri": {
      "description": "Delta table location: s3://, az://, gs://, /local, or uc://catalog.schema.table",
      "type": "string",
      "label": "Table URI",
      "required": true
    },
    "owner_engine": {
      "type": "string",
      "label": "Owner Engine",
      "description": "databricks / spark / trino / flink / snowflake-uniform",
      "required": false
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "ui:widget": "code"
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "partition_type": {
      "description": "Partition type: 'daily', 'weekly', 'monthly', 'hourly', 'static', 'multi', 'dynamic', or None for unpartitioned.",
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "partition_values": {
      "description": "Comma-separated values for static or multi partitioning, e.g. 'customer_a,customer_b,customer_c'.",
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "dynamic_partition_name": {
      "description": "Name for DynamicPartitionsDefinition (when partition_type='dynamic').",
      "type": "string",
      "label": "Dynamic Partition Name",
      "required": false
    }
  },
  "tags": [
    "external",
    "delta",
    "delta-lake",
    "lakehouse",
    "observable"
  ],
  "name": "External Delta Lake Table"
}
