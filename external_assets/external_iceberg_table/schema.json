{
  "component_type": "dagster_component_templates.ExternalIcebergTableAsset",
  "description": "Declare an external Apache Iceberg table (written by Snowflake / Trino / Spark / Flink / Databricks / etc.) as an observable Dagster external asset. Engine-agnostic.",
  "category": "external",
  "x-dagster-io": {
    "outputs": {
      "type": "AssetSpec"
    }
  },
  "icon": "si:apacheiceberg",
  "attributes": {
    "asset_key": {
      "description": "Dagster asset key (slash-delimited)",
      "type": "string",
      "label": "Asset Key",
      "required": true
    },
    "catalog_name": {
      "description": "Iceberg catalog handle (e.g. 'my_polaris_catalog', 'glue_main', 'snowflake_managed')",
      "type": "string",
      "label": "Catalog Name",
      "required": true
    },
    "namespace": {
      "description": "Iceberg namespace",
      "type": "string",
      "label": "Namespace",
      "required": true
    },
    "table_name": {
      "description": "Iceberg table name",
      "type": "string",
      "label": "Table Name",
      "required": true
    },
    "warehouse": {
      "description": "Warehouse location (e.g. 's3://bucket/warehouse'). Used as metadata only.",
      "type": "string",
      "label": "Warehouse Location",
      "required": false
    },
    "catalog_type": {
      "description": "'rest' \\| 'glue' \\| 'hive' \\| 'hadoop' \\| 'sql' — informational metadata.",
      "type": "string",
      "label": "Catalog Type",
      "required": false,
      "enum": [
        "rest",
        "glue",
        "hive",
        "hadoop",
        "sql"
      ],
      "ui:widget": "select"
    },
    "owner_engine": {
      "type": "string",
      "label": "Owner Engine",
      "description": "snowflake / trino / spark / flink / databricks / dremio",
      "required": false
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false
    },
    "description": {
      "description": "Asset description.",
      "type": "string",
      "label": "Description",
      "required": false,
      "ui:widget": "code"
    },
    "owners": {
      "description": "Asset owners.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "ui:widget": "list"
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "ui:widget": "key-value"
    },
    "partition_type": {
      "description": "Partition type: 'daily', 'weekly', 'monthly', 'hourly', 'static', 'multi', 'dynamic', or None for unpartitioned.",
      "type": "string",
      "label": "Partition Type",
      "required": false,
      "enum": [
        "daily",
        "hourly",
        "weekly",
        "monthly",
        "static",
        "multi",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "type": "string",
      "label": "Partition Start",
      "required": false
    },
    "partition_values": {
      "description": "Comma-separated values for static or multi partitioning, e.g. 'customer_a,customer_b,customer_c'.",
      "type": "string",
      "label": "Partition Values",
      "required": false
    },
    "dynamic_partition_name": {
      "description": "Name for DynamicPartitionsDefinition (when partition_type='dynamic').",
      "type": "string",
      "label": "Dynamic Partition Name",
      "required": false
    }
  },
  "tags": [
    "external",
    "iceberg",
    "lakehouse",
    "observable"
  ],
  "name": "External Iceberg Table"
}
