{
  "component_type": "dagster_component_templates.ExternalStarRocksTableAsset",
  "description": "Declare a StarRocks table as an external Dagster asset.\n\nExample:\n    ```yaml\n    type: dagster_community_components.ExternalStarRocksTableAsset\n    attributes:\n      asset_key: starrocks/analytics/events_realtime\n      database: analytics\n      table: events_realtime\n      fe_host: starrocks-fe.mycompany.com\n      group_name: starrocks\n    ```",
  "category": "external",
  "icon": "favicon:starrocks.io",
  "attributes": {
    "asset_key": {
      "type": "string",
      "label": "Asset Key",
      "required": true,
      "description": "Dagster asset key."
    },
    "database": {
      "type": "string",
      "label": "Database",
      "required": true,
      "description": "StarRocks database (catalog) name."
    },
    "table": {
      "type": "string",
      "label": "Table",
      "required": true,
      "description": "StarRocks table name."
    },
    "fe_host": {
      "type": "string",
      "label": "Fe Host",
      "required": false,
      "description": "StarRocks Frontend host (metadata only).",
      "default": null
    },
    "table_model": {
      "type": "string",
      "label": "Table Model",
      "required": false,
      "description": "StarRocks table model: 'duplicate' / 'unique' / 'aggregate' / 'primary' / 'mv'.",
      "default": null
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": null,
      "description": "Dagster asset group name"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "required": false
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Owners",
      "required": false,
      "description": "Asset owners — team names (team:analytics) or email addresses.",
      "ui:widget": "list"
    },
    "tags": {
      "type": "object",
      "label": "Tags",
      "required": false,
      "default": null
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Kinds",
      "required": false,
      "description": "Asset kinds shown in the Dagster catalog. Auto-inferred from component name if empty.",
      "ui:widget": "list"
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false
    }
  }
}
