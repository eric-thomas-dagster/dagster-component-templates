    "project_name": {"label": "Project Name", "type": "string", "required": false},
    "target": {"label": "Target", "type": "string", "required": false, "default": "production", "enum": ["production", "preview", "development"]},
    "team_id": {"label": "Team ID", "type": "string", "required": false},
    "vercel_dashboard_url": {"label": "Vercel Dashboard URL", "type": "string", "required": false},
    "production_url": {"label": "Production URL", "type": "string", "required": false},
    "group_name": {"label": "Group Name", "type": "string", "required": false, "default": "vercel"},
    "description": {"label": "Description", "type": "string", "required": false},
    "owners": {"label": "Owners", "type": "array", "required": false},
    "tags": {"label": "Tags", "type": "object", "required": false},
    "kinds": {"label": "Kinds", "type": "array", "required": false},
    "deps": {"label": "Deps", "type": "array", "required": false}
