{
  "component_type": "dagster_component_templates.FabricWorkspaceComponent",
  "description": "Import Microsoft Fabric workspace items (Lakehouse, Warehouse, Notebook, DataPipeline, Dataflow) as Dagster assets via the Fabric REST API.",
  "category": "integration",
  "icon": "si:microsoftazure",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "import_lakehouses": {
      "type": "boolean",
      "label": "Import Lakehouses",
      "required": false,
      "default": true
    },
    "import_warehouses": {
      "type": "boolean",
      "label": "Import Warehouses",
      "required": false,
      "default": true
    },
    "import_notebooks": {
      "description": "Notebooks become materializable @assets -- materializing them runs the notebook job.",
      "type": "boolean",
      "label": "Import Notebooks",
      "required": false,
      "default": false
    },
    "import_pipelines": {
      "description": "Data Pipelines become materializable @assets.",
      "type": "boolean",
      "label": "Import Data Pipelines",
      "required": false,
      "default": true
    },
    "import_dataflows": {
      "description": "Dataflow Gen2 become materializable @assets.",
      "type": "boolean",
      "label": "Import Dataflows",
      "required": false,
      "default": false
    },
    "import_semantic_models": {
      "type": "boolean",
      "label": "Import Semantic Models",
      "required": false,
      "default": false
    },
    "import_reports": {
      "type": "boolean",
      "label": "Import Reports",
      "required": false,
      "default": false
    },
    "filter_by_name_pattern": {
      "description": "Regex applied to Fabric item display names for inclusion.",
      "type": "string",
      "label": "Filter By Name (regex)",
      "required": false,
      "default": null
    },
    "exclude_name_pattern": {
      "description": "Regex applied to Fabric item display names for exclusion.",
      "type": "string",
      "label": "Exclude Name (regex)",
      "required": false,
      "default": null
    },
    "group_name": {
      "description": "Dagster asset group name.",
      "type": "string",
      "label": "Group Name",
      "required": false,
      "default": "fabric"
    },
    "upstream_asset_keys": {
      "description": "Asset keys that all imported assets wait for (lineage-only).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Upstream Asset Keys",
      "required": false,
      "default": null
    }
  }
}
