{
  "component_type": "dagster_component_templates.SnowflakeCortexSearchComponent",
  "description": "Query a Snowflake Cortex Search Service and materialize the results as a Dagster asset.",
  "category": "ai",
  "icon": "si:snowflake",
  "x-dagster-io": {
    "outputs": {
      "type": "integration",
      "description": "One Dagster asset per selected item discovered in the vendor. See README for what each materialization produces."
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true,
      "description": "Output Dagster asset name"
    },
    "account": {"label": "Account", 
      "type": "string",
      "required": true,
      "description": "Snowflake account, e.g. xy12345-abc."
    },
    "user": {"label": "User", 
      "type": "string",
      "required": true,
      "description": "Snowflake user (NAME for keypair, LOGIN_NAME for password/SSO/PAT)."
    },
    "warehouse": {"label": "Warehouse", 
      "type": "string",
      "required": false
    },
    "database": {"label": "Database", 
      "type": "string",
      "required": true,
      "description": "Database containing the search service."
    },
    "schema_name": {"label": "Schema Name", 
      "type": "string",
      "required": true,
      "description": "Schema containing the search service."
    },
    "role": {"label": "Role", 
      "type": "string",
      "required": false
    },
    "password": {"label": "Password", 
      "type": "string",
      "required": false,
      "description": "Snowflake password."
    },
    "authenticator": {"label": "Authenticator", 
      "type": "string",
      "required": false,
      "description": "Snowflake authenticator: 'SNOWFLAKE_JWT' (keypair), 'externalbrowser' (SSO), 'PROGRAMMATIC_ACCESS_TOKEN' (PAT), 'oauth'.",
      "enum": [
        "SNOWFLAKE_JWT",
        "externalbrowser",
        "PROGRAMMATIC_ACCESS_TOKEN",
        "oauth"
      ],
      "ui:widget": "select"
    },
    "private_key_file": {"label": "Private Key File", 
      "type": "string",
      "required": false
    },
    "private_key_file_pwd": {"label": "Private Key File Pwd", 
      "type": "string",
      "required": false
    },
    "token": {"label": "Token", 
      "type": "string",
      "required": false
    },
    "service_name": {"label": "Service Name", 
      "type": "string",
      "required": true,
      "description": "Name of the Cortex Search Service to query. Unqualified — gets resolved to `database.schema_name.service_name`."
    },
    "query": {"label": "Query", 
      "type": "string",
      "required": true,
      "description": "The search query (natural-language text)."
    },
    "result_limit": {"label": "Result Limit", 
      "type": "integer",
      "required": false,
      "description": "Max number of results to return."
    },
    "result_columns": {"label": "Result Columns", 
      "type": "array",
      "required": false,
      "description": "Subset of the search service's source columns to return per result (e.g. ['CONTENT', 'TITLE', 'URL']). If unset, all columns the service exposes are returned.",
      "x-dagster-widget": "columns"
    },
    "result_filter": {"label": "Result Filter", 
      "type": "string",
      "required": false,
      "description": "Optional JSON filter applied at query time (e.g. '{\"@eq\": {\"category\": \"docs\"}}'). See Cortex Search docs for filter syntax."
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "required": false
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "required": false
    },
    "retry_policy_max_retries": {"label": "Retry Policy Max Retries", 
      "type": "integer",
      "required": false,
      "description": "Max retries on query failure. Defines a RetryPolicy."
    },
    "retry_policy_delay_seconds": {"label": "Retry Policy Delay Seconds", 
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {"label": "Retry Policy Backoff", 
      "type": "string",
      "required": false,
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    }
  }
}
