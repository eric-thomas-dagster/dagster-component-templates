{
  "component_type": "dagster_component_templates.SnowflakeTimeTravelAssetComponent",
  "description": "Query a Snowflake table AT a past point in time (Time Travel) and materialize the result as a Dagster asset.",
  "category": "integration",
  "icon": "si:snowflake",
  "x-dagster-io": {
    "outputs": {
      "type": "integration",
      "description": "One Dagster asset per selected item discovered in the vendor. See README for what each materialization produces."
    }
  },
  "attributes": {
    "asset_name": {"label": "Asset Name", 
      "type": "string",
      "required": true,
      "description": "Output Dagster asset name"
    },
    "account": {"label": "Account", 
      "type": "string",
      "required": true,
      "description": "Snowflake account, e.g. xy12345-abc."
    },
    "user": {"label": "User", 
      "type": "string",
      "required": true,
      "description": "Snowflake user (NAME for keypair, LOGIN_NAME for password/SSO/PAT)."
    },
    "warehouse": {"label": "Warehouse", 
      "type": "string",
      "required": false
    },
    "database": {"label": "Database", 
      "type": "string",
      "required": true,
      "description": "Database containing the source table."
    },
    "schema_name": {"label": "Schema Name", 
      "type": "string",
      "required": true,
      "description": "Schema containing the source table."
    },
    "role": {"label": "Role", 
      "type": "string",
      "required": false
    },
    "password": {"label": "Password", 
      "type": "string",
      "required": false
    },
    "authenticator": {"label": "Authenticator", 
      "type": "string",
      "required": false,
      "description": "Snowflake authenticator: 'SNOWFLAKE_JWT', 'externalbrowser', 'PROGRAMMATIC_ACCESS_TOKEN', 'oauth'.",
      "enum": [
        "SNOWFLAKE_JWT",
        "externalbrowser",
        "PROGRAMMATIC_ACCESS_TOKEN",
        "oauth"
      ],
      "ui:widget": "select"
    },
    "private_key_file": {"label": "Private Key File", 
      "type": "string",
      "required": false
    },
    "private_key_file_pwd": {"label": "Private Key File Pwd", 
      "type": "string",
      "required": false
    },
    "token": {"label": "Token", 
      "type": "string",
      "required": false
    },
    "source_table": {"label": "Source Table", 
      "type": "string",
      "required": true,
      "description": "Table to time-travel against (unqualified; resolved against database.schema_name)."
    },
    "columns": {"label": "Columns", 
      "type": "array",
      "required": false,
      "description": "Columns to SELECT (defaults to *). E.g. ['ID', 'NAME', 'AMOUNT'].",
      "x-dagster-widget": "columns"
    },
    "where_clause": {"label": "Where Clause", 
      "type": "string",
      "required": false,
      "description": "Optional WHERE predicate (without the WHERE keyword). E.g. 'AMOUNT > 100'."
    },
    "row_limit": {"label": "Row Limit", 
      "type": "integer",
      "required": false,
      "description": "Optional LIMIT N on the result."
    },
    "time_travel_offset_seconds": {"label": "Time Travel Offset Seconds", 
      "type": "integer",
      "required": false,
      "description": "Seconds back from now (NEGATIVE int, e.g. -3600 = 1 hour ago). Maps to `AT(OFFSET => <n>)`."
    },
    "time_travel_timestamp": {"label": "Time Travel Timestamp", 
      "type": "string",
      "required": false,
      "description": "Specific timestamp to time-travel to, e.g. '2025-05-19 10:00:00'. Maps to `AT(TIMESTAMP => '...'::TIMESTAMP)`."
    },
    "time_travel_statement_id": {"label": "Time Travel Statement ID", 
      "type": "string",
      "required": false,
      "description": "Query ID to time-travel BEFORE. Maps to `BEFORE(STATEMENT => '<query_id>')`."
    },
    "group_name": {"label": "Group Name", 
      "type": "string",
      "required": false
    },
    "description": {"label": "Description", 
      "type": "string",
      "required": false
    },
    "asset_tags": {"label": "Asset Tags", 
      "type": "object",
      "required": false
    },
    "kinds": {"label": "Kinds", 
      "type": "array",
      "required": false
    },
    "owners": {"label": "Owners", 
      "type": "array",
      "required": false
    },
    "deps": {"label": "Deps", 
      "type": "array",
      "required": false
    },
    "retry_policy_max_retries": {"label": "Retry Policy Max Retries", 
      "type": "integer",
      "required": false,
      "description": "Max retries on query failure."
    },
    "retry_policy_delay_seconds": {"label": "Retry Policy Delay Seconds", 
      "type": "integer",
      "required": false
    },
    "retry_policy_backoff": {"label": "Retry Policy Backoff", 
      "type": "string",
      "required": false,
      "enum": [
        "exponential",
        "linear",
        "fixed"
      ],
      "ui:widget": "select"
    }
  }
}
