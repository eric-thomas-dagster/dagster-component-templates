{
  "component_type": "dagster_community_components.TalendCloudWorkspaceComponent",
  "description": "Talend Cloud (TMC) artifacts as Dagster assets. Discovers /workspaces/{id}/executables + optionally POSTs /executions + polls to completion. Fivetran-shape workspace: block for auth + selector for filtering + polling_sensor + freshness_lag_threshold_seconds.",
  "category": "integration",
  "icon": "Cloud",
  "x-dagster-io": {
    "outputs": {
      "type": "integration",
      "description": "One Dagster asset per selected item discovered in the vendor. See README for what each materialization produces."
    }
  },
  "attributes": {
    "workspace": {
      "type": "object",
      "label": "Workspace",
      "description": "Talend Cloud connection (region, workspace_id, auth_token_env_var).",
      "required": true
    },
    "artifact_selector": {
      "type": "object",
      "label": "Artifact Selector",
      "description": "Filter which Talend artifacts become Dagster assets. Omit for all.",
      "required": false
    },
    "action": {
      "type": "string",
      "label": "Action",
      "description": "noop = external asset; execute = POST /executions + poll.",
      "required": false,
      "default": "noop",
      "enum": [
        "noop",
        "execute"
      ],
      "ui:widget": "select"
    },
    "wait_for_completion": {
      "type": "boolean",
      "required": false,
      "default": true,
      "ui:widget": "checkbox"
    },
    "poll_interval_seconds": {
      "type": "integer",
      "required": false,
      "default": 30
    },
    "timeout_seconds": {
      "type": "integer",
      "required": false,
      "default": 3600
    },
    "polling_sensor": {
      "type": "boolean",
      "required": false,
      "default": false,
      "ui:widget": "checkbox"
    },
    "observation_interval_seconds": {
      "type": "integer",
      "required": false,
      "default": 300
    },
    "freshness_lag_threshold_seconds": {
      "type": "integer",
      "label": "Freshness Lag Threshold (seconds)",
      "required": false,
      "default": null
    },
    "asset_key_prefix": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "ui:widget": "list"
    },
    "group_name": {
      "type": "string",
      "required": false,
      "default": "talend_cloud"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "default": [
        "talend"
      ],
      "ui:widget": "list"
    },
    "tags": {
      "type": "object",
      "required": false,
      "ui:widget": "key-value"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false,
      "ui:widget": "list"
    }
  },
  "tags": [
    "talend",
    "tmc",
    "cloud",
    "etl",
    "workspace"
  ],
  "name": "Talend Cloud Workspace"
}
