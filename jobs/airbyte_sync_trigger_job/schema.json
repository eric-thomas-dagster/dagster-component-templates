{
  "component_type": "dagster_community_components.AirbyteSyncTriggerJobComponent",
  "description": "Trigger an Airbyte connection sync via REST API \u2014 fire-and-forget or wait for completion.",
  "category": "jobs",
  "icon": "Cog",
  "attributes": {
    "job_name": {
      "type": "string",
      "label": "Job Name",
      "description": "Dagster job name",
      "required": true
    },
    "schedule": {
      "type": "string",
      "label": "Schedule",
      "description": "Cron schedule (None = no schedule)",
      "required": false,
      "x-dagster-widget": "cron"
    },
    "default_status": {
      "type": "string",
      "label": "Default Status",
      "description": "One of: STOPPED / RUNNING.",
      "required": false,
      "default": "stopped",
      "enum": [
        "stopped",
        "running"
      ],
      "ui:widget": "select"
    },
    "tags": {
      "type": "object",
      "label": "Tags",
      "description": "Dagster job tags",
      "required": false
    },
    "airbyte_url": {
      "type": "string",
      "label": "Airbyte Url",
      "description": "Airbyte server URL (e.g. 'https://airbyte.acme.com')",
      "required": true
    },
    "connection_id": {
      "type": "string",
      "label": "Connection Id",
      "description": "Connection UUID to sync",
      "required": true
    },
    "username_env": {
      "type": "string",
      "label": "Username Env",
      "description": "Username Env",
      "required": false,
      "default": "AIRBYTE_USER"
    },
    "password_env": {
      "type": "string",
      "label": "Password Env",
      "description": "Password Env",
      "required": false,
      "default": "AIRBYTE_PASSWORD"
    },
    "wait_for_completion": {
      "type": "boolean",
      "label": "Wait For Completion",
      "description": "Wait For Completion",
      "required": false,
      "default": false
    },
    "poll_interval_seconds": {
      "type": "integer",
      "label": "Poll Interval Seconds",
      "description": "Poll Interval Seconds",
      "required": false,
      "default": 15
    },
    "timeout_seconds": {
      "type": "integer",
      "label": "Timeout Seconds",
      "description": "Timeout Seconds",
      "required": false,
      "default": 3600
    },
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "description": "If set, this component emits a real materializable `@dg.asset` (with `deps`) instead of a plain op-job, returning the real Airbyte job id in metadata. `job_name`/`schedule` are ignored when this is set. For connections managed by a declared Airbyte workspace, `integrations/airbyte_assets` (the official `dagster_airbyte` wrapper) is usually the better fit -- this component is for triggering a self-hosted/legacy Airbyte instance directly via its basic-auth `/api/v1/` REST endpoints, which is a different auth/API surface.",
      "required": false
    },
    "deps": {
      "description": "Lineage-only upstream asset keys (no data passed at runtime).",
      "items": {
        "type": "string"
      },
      "label": "Deps",
      "required": false,
      "type": "array"
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "description": "Asset group name. Only used when `asset_name` is set.",
      "required": false
    }
  }
}
