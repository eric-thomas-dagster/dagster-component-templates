{
  "component_type": "dagster_component_templates.DagsterAuditToWarehouseJobComponent",
  "description": "Op-shaped job that pulls Dagster+ audit log entries (who did what, when) via GraphQL and MERGEs them into a warehouse table for compliance / SOC2 retention queries. Dagster+ only.",
  "category": "jobs",
  "icon": "Upload",
  "attributes": {
    "job_name": {"type": "string", "required": true},
    "schedule": {"type": "string", "required": false, "default": "0 * * * *", "x-dagster-widget": "cron"},
    "default_status": {"type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"type": "object", "required": false, "default": null},
    "dagster_plus_url": {"type": "string", "label": "Dagster+ URL", "description": "e.g. https://acme.dagster.cloud/prod", "required": true},
    "dagster_plus_token_env": {"type": "string", "required": false, "default": "DAGSTER_CLOUD_API_TOKEN"},
    "warehouse": {"type": "string", "required": true, "enum": ["snowflake", "bigquery", "postgres"]},

    "snowflake_account": {"type": "string", "required": false, "default": null},
    "snowflake_user": {"type": "string", "required": false, "default": null},
    "snowflake_password_env": {"type": "string", "required": false, "default": "SNOWFLAKE_PASSWORD"},
    "snowflake_warehouse": {"type": "string", "required": false, "default": null},
    "snowflake_database": {"type": "string", "required": false, "default": null},
    "snowflake_schema": {"type": "string", "required": false, "default": "PUBLIC"},

    "bq_project": {"type": "string", "required": false, "default": null},
    "bq_dataset": {"type": "string", "required": false, "default": null},

    "postgres_dsn_env": {"type": "string", "required": false, "default": "POSTGRES_DSN"},
    "postgres_schema": {"type": "string", "required": false, "default": "public"},

    "table": {"type": "string", "required": false, "default": "dagster_audit_log"},
    "initial_lookback_hours": {"type": "integer", "required": false, "default": 24},
    "batch_limit": {"type": "integer", "required": false, "default": 1000}
  }
}
