{
  "component_type": "dagster_component_templates.DagsterCheckResultsPruneJobComponent",
  "description": "Op-shaped job that deletes old AssetCheckResult events from the event log. Filters by max_age_days and optional per-asset scoping.",
  "category": "jobs",
  "icon": "Trash",
  "attributes": {
    "job_name": {"label": "Job Name", 
      "type": "string",
      "required": true
    },
    "schedule": {"label": "Schedule", 
      "type": "string",
      "required": false,
      "default": "0 5 * * 0",
      "x-dagster-widget": "cron"
    },
    "default_status": {"label": "Default Status", 
      "type": "string",
      "required": false,
      "default": "stopped",
      "enum": [
        "stopped",
        "running"
      ]
    },
    "tags": {"label": "Tags", 
      "type": "object",
      "required": false,
      "default": null
    },
    "asset_keys": {
      "type": "array",
      "label": "Asset Keys",
      "description": "Empty = all assets; list to scope.",
      "required": false,
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "max_age_days": {"label": "Max Age Days", 
      "type": "integer",
      "required": false,
      "default": 30
    },
    "max_deletes_per_run": {"label": "Max Deletes Per Run", 
      "type": "integer",
      "required": false,
      "default": 5000
    },
    "dry_run": {"label": "Dry Run", 
      "type": "boolean",
      "required": false,
      "default": true
    }
  }
}
