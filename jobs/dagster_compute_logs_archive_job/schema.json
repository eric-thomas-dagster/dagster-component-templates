{
  "component_type": "dagster_component_templates.DagsterComputeLogsArchiveJobComponent",
  "description": "Op-shaped job that gzips + archives old Dagster compute log files to S3/GCS/local, then optionally deletes them from primary storage. Frees primary storage without losing audit trail.",
  "category": "jobs",
  "icon": "Archive",
  "attributes": {
    "job_name": {"label": "Job Name", "type": "string", "required": true},
    "schedule": {"label": "Schedule", "type": "string", "required": false, "default": "0 6 * * *", "x-dagster-widget": "cron"},
    "default_status": {"label": "Default Status", "type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"label": "Tags", "type": "object", "required": false, "default": null},
    "source_dir": {"type": "string", "label": "Source Dir", "description": "Root of compute logs. Empty = $DAGSTER_HOME/storage.", "required": false, "default": ""},
    "min_age_days": {"label": "Min Age Days", "type": "integer", "required": false, "default": 7},
    "archive_target": {"type": "string", "label": "Archive Target", "required": false, "default": "local", "enum": ["local", "s3", "gcs"]},
    "archive_local_dir": {"label": "Archive Local Dir", "type": "string", "required": false, "default": null},
    "archive_bucket": {"label": "Archive Bucket", "type": "string", "required": false, "default": null},
    "archive_prefix": {"label": "Archive Prefix", "type": "string", "required": false, "default": "dagster-compute-logs-archive/"},
    "delete_after_archive": {"label": "Delete After Archive", "type": "boolean", "required": false, "default": false},
    "max_files_per_run": {"label": "Max Files Per Run", "type": "integer", "required": false, "default": 1000},
    "dry_run": {"label": "Dry Run", "type": "boolean", "required": false, "default": true}
  }
}
