{
  "component_type": "dagster_component_templates.EventLogToBigQueryJobComponent",
  "description": "Op-shaped job that streams new Dagster event log entries into a BigQuery table via insert_rows_json. Cursor-based; only sends new events.",
  "category": "jobs",
  "icon": "Upload",
  "attributes": {
    "job_name": {"description": "Dagster job name", "label": "Job Name", "type": "string", "required": true},
    "schedule": {"description": "Cron schedule; default every 15min.", "label": "Schedule", "type": "string", "required": false, "default": "*/15 * * * *", "x-dagster-widget": "cron"},
    "default_status": {"description": "STOPPED \\| RUNNING", "label": "Default Status", "type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"description": "Dagster job tags", "label": "Tags", "type": "object", "required": false, "default": null},
    "gcp_project": {"description": "GCP project ID.", "type": "string", "label": "GCP Project", "required": true},
    "dataset": {"description": "BigQuery dataset name.", "type": "string", "label": "BigQuery Dataset", "required": true},
    "table": {"description": "BigQuery table name.", "label": "Table", "type": "string", "required": false, "default": "dagster_events"},
    "initial_lookback_hours": {"description": "On first run, pull events from last N hours.", "label": "Initial Lookback Hours", "type": "integer", "required": false, "default": 24},
    "batch_limit": {"description": "Max events per tick.", "label": "Batch Limit", "type": "integer", "required": false, "default": 5000}
  }
}
