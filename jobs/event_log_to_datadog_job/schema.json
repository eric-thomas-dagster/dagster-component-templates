{
  "component_type": "dagster_component_templates.EventLogToDatadogJobComponent",
  "description": "Op-shaped job that ships new Dagster event log entries to Datadog as log entries via the HTTP intake API. Batches up to 1000 events per POST.",
  "category": "jobs",
  "icon": "Upload",
  "attributes": {
    "job_name": {"label": "Job Name", "type": "string", "required": true},
    "schedule": {"label": "Schedule", "type": "string", "required": false, "default": "*/5 * * * *", "x-dagster-widget": "cron"},
    "default_status": {"label": "Default Status", "type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"label": "Tags", "type": "object", "required": false, "default": null},
    "api_key_env": {"label": "API Key Env", "type": "string", "required": false, "default": "DATADOG_API_KEY"},
    "intake_url": {"label": "Intake URL", "type": "string", "required": false, "default": "https://http-intake.logs.datadoghq.com/api/v2/logs"},
    "service": {"label": "Service", "type": "string", "required": false, "default": "dagster"},
    "env": {"label": "Env", "type": "string", "required": false, "default": "prod"},
    "initial_lookback_hours": {"label": "Initial Lookback Hours", "type": "integer", "required": false, "default": 6},
    "batch_limit": {"label": "Batch Limit", "type": "integer", "required": false, "default": 5000}
  }
}
