{
  "component_type": "dagster_component_templates.EventLogToDatadogJobComponent",
  "description": "Op-shaped job that ships new Dagster event log entries to Datadog as log entries via the HTTP intake API. Batches up to 1000 events per POST.",
  "category": "jobs",
  "icon": "Upload",
  "attributes": {
    "job_name": {"description": "Dagster job name", "label": "Job Name", "type": "string", "required": true},
    "schedule": {"description": "Cron schedule; default every 5min.", "label": "Schedule", "type": "string", "required": false, "default": "*/5 * * * *", "x-dagster-widget": "cron"},
    "default_status": {"description": "STOPPED \\| RUNNING", "label": "Default Status", "type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"description": "Dagster job tags", "label": "Tags", "type": "object", "required": false, "default": null},
    "api_key_env": {"description": "Env var with the Datadog API key (sent as DD-API-KEY).", "label": "API Key Env", "type": "string", "required": false, "default": "DATADOG_API_KEY"},
    "intake_url": {"description": "Datadog intake URL. EU: https://http-intake.logs.datadoghq.eu/api/v2/logs", "label": "Intake URL", "type": "string", "required": false, "default": "https://http-intake.logs.datadoghq.com/api/v2/logs"},
    "service": {"description": "`service` tag on emitted logs.", "label": "Service", "type": "string", "required": false, "default": "dagster"},
    "env": {"description": "`env` tag on emitted logs.", "label": "Env", "type": "string", "required": false, "default": "prod"},
    "initial_lookback_hours": {"description": "On first run, pull events from last N hours.", "label": "Initial Lookback Hours", "type": "integer", "required": false, "default": 6},
    "batch_limit": {"description": "Max events per tick (split into 1000-entry sub-batches).", "label": "Batch Limit", "type": "integer", "required": false, "default": 5000}
  }
}
