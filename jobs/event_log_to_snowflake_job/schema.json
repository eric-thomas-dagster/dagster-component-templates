{
  "component_type": "dagster_component_templates.EventLogToSnowflakeJobComponent",
  "description": "Op-shaped job that streams new Dagster event log entries into a Snowflake table via INSERT batches. Cursor-based; only sends new events.",
  "category": "jobs",
  "icon": "Upload",
  "attributes": {
    "job_name": {"description": "Dagster job name", "label": "Job Name", "type": "string", "required": true},
    "schedule": {"description": "Cron schedule; default every 15min.", "label": "Schedule", "type": "string", "required": false, "default": "*/15 * * * *", "x-dagster-widget": "cron"},
    "default_status": {"description": "STOPPED \\| RUNNING", "label": "Default Status", "type": "string", "required": false, "default": "stopped", "enum": ["stopped", "running"]},
    "tags": {"description": "Dagster job tags", "label": "Tags", "type": "object", "required": false, "default": null},
    "account": {"type": "string", "label": "Snowflake Account", "description": "e.g. abc12345.us-east-1", "required": true},
    "user": {"description": "Snowflake username.", "label": "User", "type": "string", "required": true},
    "password_env": {"description": "Env var with password.", "label": "Password Env", "type": "string", "required": false, "default": "SNOWFLAKE_PASSWORD"},
    "warehouse": {"description": "Snowflake warehouse.", "type": "string", "label": "Snowflake Warehouse", "required": true},
    "database": {"description": "Snowflake database.", "label": "Database", "type": "string", "required": true},
    "snowflake_schema": {"description": "Snowflake schema.", "label": "Snowflake Schema", "type": "string", "required": false, "default": "PUBLIC"},
    "table": {"description": "Target table name.", "label": "Table", "type": "string", "required": false, "default": "DAGSTER_EVENTS"},
    "role": {"description": "Optional role.", "label": "Role", "type": "string", "required": false, "default": null},
    "initial_lookback_hours": {"description": "On first run, pull events from last N hours.", "label": "Initial Lookback Hours", "type": "integer", "required": false, "default": 24},
    "batch_limit": {"description": "Max events per tick.", "label": "Batch Limit", "type": "integer", "required": false, "default": 5000}
  }
}
