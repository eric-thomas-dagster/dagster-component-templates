{
  "component_type": "dagster_component_templates.FabricCapacityAdminJobComponent",
  "description": "Pause / resume / scale a Microsoft Fabric capacity via the management REST API. Op-job \u2014 schedule it nightly + weekends to halve Fabric capacity spend.",
  "category": "jobs",
  "icon": "Power",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "job_name": {
      "description": "Dagster job name (e.g. fabric_capacity_pause_nightly)",
      "type": "string",
      "label": "Job Name",
      "required": true
    },
    "action": {
      "description": "'suspend' (pause billing) \\| 'resume' \\| 'scale' (change SKU)",
      "type": "string",
      "label": "Action",
      "required": false,
      "default": "suspend",
      "enum": [
        "suspend",
        "resume",
        "scale"
      ]
    },
    "target_sku": {
      "description": "Required when action='scale'. Fabric SKU like 'F2', 'F4', 'F8', 'F16', 'F32', 'F64', 'F128', 'F256'.",
      "type": "string",
      "label": "Target Sku",
      "required": false,
      "default": null
    },
    "subscription_id": {
      "description": "Azure subscription ID",
      "type": "string",
      "label": "Subscription Id",
      "required": true
    },
    "resource_group_name": {
      "description": "Resource group containing the capacity",
      "type": "string",
      "label": "Resource Group Name",
      "required": true
    },
    "capacity_name": {
      "description": "Fabric capacity name",
      "type": "string",
      "label": "Capacity Name",
      "required": true
    },
    "tenant_id_env_var": {
      "type": "string",
      "label": "Tenant Id Env Var",
      "required": false,
      "default": null
    },
    "client_id_env_var": {
      "type": "string",
      "label": "Client Id Env Var",
      "required": false,
      "default": null
    },
    "client_secret_env_var": {
      "type": "string",
      "label": "Client Secret Env Var",
      "required": false,
      "default": null
    },
    "schedule": {
      "description": "Cron schedule (e.g. '0 19 * * *' for 7pm daily, '0 6 * * 1-5' for 6am weekdays)",
      "type": "string",
      "label": "Schedule",
      "required": false,
      "default": null,
      "x-dagster-widget": "cron"
    },
    "schedule_default_status": {
      "type": "string",
      "label": "Schedule Default Status",
      "required": false,
      "default": "STOPPED",
      "enum": [
        "STOPPED",
        "RUNNING"
      ]
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "default": null
    }
  }
}
