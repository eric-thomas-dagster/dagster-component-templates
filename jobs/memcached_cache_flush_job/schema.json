{
  "component_type": "dagster_component_templates.MemcachedCacheFlushJobComponent",
  "description": "Flush Memcached — entire cache or a key list — as a Dagster job.",
  "category": "jobs",
  "icon": "si:memcached",
  "attributes": {
    "job_name": {
      "type": "string",
      "label": "Job Name",
      "required": true,
      "description": "Dagster job name"
    },
    "schedule": {
      "type": "string",
      "label": "Schedule",
      "required": false,
      "description": "Cron schedule (None = no schedule)",
      "default": null
    },
    "default_status": {
      "type": "string",
      "label": "Default Status",
      "required": false,
      "description": "STOPPED | RUNNING",
      "default": "STOPPED",
      "enum": [
        "STOPPED",
        "RUNNING"
      ],
      "ui:widget": "select"
    },
    "tags": {
      "type": "object",
      "label": "Tags",
      "required": false,
      "description": "Dagster job tags",
      "default": null
    },
    "host": {
      "type": "string",
      "label": "Host",
      "required": false,
      "description": "Memcached host",
      "default": "localhost"
    },
    "port": {
      "type": "integer",
      "label": "Port",
      "required": false,
      "description": "Memcached port",
      "default": 11211
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "ui:widget": "list",
      "label": "Keys",
      "required": false,
      "description": "Explicit list of keys to delete. When None or empty, calls `flush_all` (nukes everything). Memcached has no SCAN, so pattern-based deletes aren't supported — enumerate the keys.",
      "default": null
    },
    "timeout_seconds": {
      "type": "number",
      "label": "Timeout Seconds",
      "required": false,
      "description": "Connect + read/write timeout",
      "default": 3.0
    }
  }
}
