{
  "component_type": "dagster_community_components.SentryAlertJobComponent",
  "description": "Fire a Sentry event as a scheduled (or on-demand) job \u2014 no asset materialized. Matches the pattern of http_webhook_job / observability_heartbeat_job. Configurable message, level, tags, extras, fingerprint, environment, release.",
  "category": "jobs",
  "icon": "AlertCircle",
  "attributes": {
    "job_name": {"label": "Job Name", 
      "type": "string",
      "required": true
    },
    "schedule": {"label": "Schedule", 
      "type": "string",
      "required": false,
      "description": "Cron expression (None = no schedule).",
      "x-dagster-widget": "cron"
    },
    "default_status": {"label": "Default Status", 
      "type": "string",
      "required": false,
      "default": "stopped",
      "enum": [
        "stopped",
        "running"
      ],
      "ui:widget": "select"
    },
    "tags": {"label": "Tags", 
      "type": "object",
      "required": false,
      "description": "Dagster job tags (not Sentry tags)."
    },
    "dsn_env_var": {"label": "Dsn Env Var", 
      "type": "string",
      "required": false,
      "default": "SENTRY_DSN"
    },
    "message": {"label": "Message", 
      "type": "string",
      "required": true,
      "description": "Event message text ({now} \u2192 UTC ISO timestamp)."
    },
    "level": {"label": "Level", 
      "type": "string",
      "required": false,
      "default": "info",
      "description": "One of: debug / info / warning / error / fatal.",
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "ui:widget": "select"
    },
    "environment": {"label": "Environment", 
      "type": "string",
      "required": false
    },
    "release": {"label": "Release", 
      "type": "string",
      "required": false
    },
    "sentry_tags": {"label": "Sentry Tags", 
      "type": "object",
      "required": false,
      "description": "Searchable Sentry tags applied to the event."
    },
    "sentry_extras": {"label": "Sentry Extras", 
      "type": "object",
      "required": false,
      "description": "Extra (non-indexed) context on the event."
    },
    "fingerprint": {"label": "Fingerprint", 
      "type": "array",
      "required": false
    },
    "fail_on_error": {"label": "Fail On Error", 
      "type": "boolean",
      "required": false,
      "default": true
    }
  }
}
