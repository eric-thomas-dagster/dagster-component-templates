{
  "component_type": "dagster_community_components.SentryMonitorCheckinJobComponent",
  "description": "Fire a Sentry Cron Monitoring check-in (in_progress + ok) as a scheduled job. Sentry watches for missing check-ins and alerts on-call when the schedule silently drops a beat. Optional monitor_config auto-creates the monitor on first check-in.",
  "category": "jobs",
  "icon": "Clock",
  "attributes": {
    "job_name": {"label": "Job Name", 
      "type": "string",
      "required": true
    },
    "schedule": {"label": "Schedule", 
      "type": "string",
      "required": false,
      "description": "Cron expression (None = no schedule).",
      "x-dagster-widget": "cron"
    },
    "default_status": {"label": "Default Status", 
      "type": "string",
      "required": false,
      "default": "stopped",
      "enum": [
        "stopped",
        "running"
      ],
      "ui:widget": "select"
    },
    "tags": {"label": "Tags", 
      "type": "object",
      "required": false
    },
    "dsn_env_var": {"label": "Dsn Env Var", 
      "type": "string",
      "required": false,
      "default": "SENTRY_DSN"
    },
    "monitor_slug": {"label": "Monitor Slug", 
      "type": "string",
      "required": true,
      "description": "Stable slug identifying the Sentry monitor."
    },
    "environment": {"label": "Environment", 
      "type": "string",
      "required": false
    },
    "release": {"label": "Release", 
      "type": "string",
      "required": false
    },
    "monitor_config": {"label": "Monitor Config", 
      "type": "object",
      "required": false,
      "description": "Sentry monitor_config dict (schedule/checkin_margin/max_runtime/timezone). Auto-creates monitor on first check-in when set."
    },
    "fail_on_error": {"label": "Fail On Error", 
      "type": "boolean",
      "required": false,
      "default": false
    }
  }
}
