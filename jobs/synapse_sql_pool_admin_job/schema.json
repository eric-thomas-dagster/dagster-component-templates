{
  "component_type": "dagster_component_templates.SynapseSqlPoolAdminJobComponent",
  "description": "Pause / resume / scale a Synapse dedicated SQL pool via the management REST API. Op-job (not an asset) since pause/resume produces no data \u2014 schedule it to halve dedicated SQL pool spend by pausing nightly + on weekends.",
  "category": "jobs",
  "icon": "Power",
  "x-dagster-io": {
    "supports_partitions": false
  },
  "attributes": {
    "job_name": {
      "description": "Dagster job name (e.g. synapse_pool_pause_nightly)",
      "type": "string",
      "label": "Job Name",
      "required": true
    },
    "action": {
      "description": "'pause' \\| 'resume' \\| 'scale'. Scale requires `target_sku`.",
      "type": "string",
      "label": "Action",
      "required": false,
      "default": "pause",
      "enum": [
        "pause",
        "resume",
        "scale"
      ]
    },
    "target_sku": {
      "type": "string",
      "label": "Target SKU",
      "required": false,
      "default": null,
      "description": "DWU SKU when action=scale (e.g. DW100c, DW200c, DW500c)"
    },
    "subscription_id": {
      "description": "Azure subscription ID",
      "type": "string",
      "label": "Subscription ID",
      "required": true
    },
    "resource_group_name": {
      "description": "Resource group containing the workspace",
      "type": "string",
      "label": "Resource Group",
      "required": true
    },
    "workspace_name": {
      "description": "Synapse workspace name",
      "type": "string",
      "label": "Workspace Name",
      "required": true
    },
    "sql_pool_name": {
      "description": "Dedicated SQL pool name",
      "type": "string",
      "label": "SQL Pool Name",
      "required": true
    },
    "tenant_id_env_var": {
      "type": "string",
      "label": "Tenant ID Env Var",
      "required": false,
      "default": null
    },
    "client_id_env_var": {
      "type": "string",
      "label": "Client ID Env Var",
      "required": false,
      "default": null
    },
    "client_secret_env_var": {
      "type": "string",
      "label": "Client Secret Env Var",
      "required": false,
      "default": null
    },
    "schedule": {
      "type": "string",
      "label": "Schedule",
      "required": false,
      "default": null,
      "description": "Cron schedule (e.g. '0 19 * * 1-5' for 7pm weekdays)",
      "x-dagster-widget": "cron"
    },
    "schedule_default_status": {
      "description": "STOPPED \\| RUNNING",
      "type": "string",
      "label": "Schedule Default Status",
      "required": false,
      "default": "STOPPED",
      "enum": [
        "STOPPED",
        "RUNNING"
      ]
    },
    "tags": {
      "description": "Catalog tags.",
      "type": "object",
      "label": "Tags",
      "required": false,
      "default": null
    }
  }
}
