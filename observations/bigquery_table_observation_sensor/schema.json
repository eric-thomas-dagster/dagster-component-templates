{
  "component_type": "dagster_component_templates.BigQueryTableObservationSensorComponent",
  "description": "Emit health observations for an external BigQuery table.",
  "category": "observation",
  "icon": "si:googlebigquery",
  "x-dagster-io": {
    "outputs": {
      "type": "AssetObservation",
      "description": "Asset observation events"
    }
  },
  "attributes": {
    "sensor_name": {
      "type": "string",
      "label": "Sensor Name",
      "description": "Unique sensor name",
      "required": true
    },
    "asset_key": {
      "type": "string",
      "label": "Asset Key",
      "description": "Asset key of the ExternalBigQueryTableAsset to observe",
      "required": true
    },
    "project_id": {
      "type": "string",
      "label": "Project Id",
      "description": "GCP project ID",
      "required": true
    },
    "dataset_id": {
      "type": "string",
      "label": "Dataset Id",
      "description": "BigQuery dataset ID",
      "required": true
    },
    "table_id": {
      "type": "string",
      "label": "Table Id",
      "description": "BigQuery table ID",
      "required": true
    },
    "check_interval_seconds": {
      "type": "integer",
      "label": "Check Interval Seconds",
      "description": "Seconds between health checks",
      "required": false,
      "default": 300
    },
    "resource_key": {
      "type": "string",
      "label": "Resource Key",
      "description": "Optional Dagster resource key.",
      "required": false,
      "default": null,
      "ui:widget": "resource-picker"
    },
    "include_preview_metadata": {
      "description": "Run an extra `SELECT * LIMIT preview_rows` against the table and include the result as a markdown preview on the AssetObservation, so builder UIs can show table contents without their own warehouse access.",
      "type": "boolean",
      "label": "Include Preview Metadata",
      "required": false,
      "default": false
    },
    "preview_rows": {
      "description": "Rows in the preview SELECT when include_preview_metadata=True.",
      "type": "integer",
      "label": "Preview Rows",
      "required": false,
      "default": 25
    }
  },
  "tags": [
    "observation",
    "bigquery",
    "table",
    "sensor"
  ],
  "name": "BigQuery Table Observation Sensor"
}
