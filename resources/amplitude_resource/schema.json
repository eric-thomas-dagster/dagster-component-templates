{
  "component_type": "dagster_component_templates.AmplitudeResourceComponent",
  "description": "Register an AmplitudeResource under a resource key. Holds auth (API key in body) + exposes track_events_bulk (HTTP V2 API, up to 1000/call) for downstream Amplitude sinks.",
