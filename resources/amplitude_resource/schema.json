    "base_url": {"type": "string", "required": false, "default": "https://api2.amplitude.com", "description": "https://api.eu.amplitude.com for EU projects."},
    "request_timeout_seconds": {"type": "integer", "required": false, "default": 30}
  },
  "tags": ["resource", "amplitude", "product-analytics", "event-tracking", "user-properties"],
  "name": "Amplitude Resource"
}
