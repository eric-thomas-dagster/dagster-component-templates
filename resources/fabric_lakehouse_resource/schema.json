{
  "component_type": "dagster_community_components.FabricLakehouseResourceComponent",
  "description": "OneLake URL helper + storage credentials for Fabric Lakehouse access. Use from custom ops via resource.table_path('orders') / resource.storage_options() to read/write Delta tables without re-deriving the abfss URL pattern.",
  "category": "resource",
  "icon": "si:microsoftazure",
  "x-dagster-io": {},
  "attributes": {
    "resource_key": {
      "description": "Dagster resource key",
      "type": "string",
      "label": "Resource Key",
      "required": false,
      "default": "fabric_lakehouse"
    },
    "workspace_id": {
      "description": "Fabric workspace ID (GUID)",
      "type": "string",
      "label": "Workspace Id",
      "required": true,
      "default": null
    },
    "lakehouse_name": {
      "description": "Lakehouse item display name",
      "type": "string",
      "label": "Lakehouse Name",
      "required": true,
      "default": null
    },
    "tenant_id_env_var": {
      "type": "string",
      "label": "Tenant Id Env Var",
      "required": false,
      "default": null
    },
    "client_id_env_var": {
      "type": "string",
      "label": "Client Id Env Var",
      "required": false,
      "default": null
    },
    "client_secret_env_var": {
      "type": "string",
      "label": "Client Secret Env Var",
      "required": false,
      "default": null
    },
    "use_azure_cli": {
      "description": "Force Azure CLI auth when no service principal is set (local dev only -- needs an interactive `az login` session). Leave false in production/CI to let delta-rs/object_store's own default credential resolution run instead.",
      "type": "boolean",
      "label": "Use Azure Cli",
      "required": false,
      "default": false
    }
  }
}
