{
  "component_type": "dagster_component_templates.IcebergCatalogResourceComponent",
  "description": "Register a PyIceberg catalog (REST / Glue / Hive / Hadoop / SQL) once and reuse across many ingestion / sink / observation components.",
  "category": "resource",
  "icon": "si:apacheiceberg",
  "attributes": {
    "resource_key": {
      "description": "Dagster resource key",
      "type": "string",
      "label": "Resource Key",
      "required": false,
      "default": "iceberg"
    },
    "catalog_type": {
      "description": "'rest' \\| 'glue' \\| 'hive' \\| 'hadoop' \\| 'sql'",
      "type": "string",
      "label": "Catalog Type",
      "required": false,
      "default": "rest",
      "enum": [
        "rest",
        "glue",
        "hive",
        "hadoop",
        "sql"
      ],
      "ui:widget": "select"
    },
    "catalog_name": {
      "description": "PyIceberg local catalog identifier",
      "type": "string",
      "label": "Catalog Name",
      "required": false,
      "default": "default"
    },
    "catalog_properties": {
      "description": "Catalog-specific config. ${ENV_VAR} expansion supported.",
      "type": "object",
      "label": "Catalog Properties",
      "required": false,
      "ui:widget": "key-value"
    }
  },
  "tags": [
    "resource",
    "iceberg",
    "lakehouse",
    "pyiceberg"
  ],
  "name": "Iceberg Catalog Resource"
}
