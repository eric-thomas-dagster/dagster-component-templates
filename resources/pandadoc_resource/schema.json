{
  "component_type": "dagster_component_templates.PandaDocResourceComponent",
  "description": "Register a PandaDocResource (static API Key REST API client) for use by other components",
  "category": "resource",
  "icon": "si:pandadoc",
  "x-dagster-io": {
    "outputs": {
      "type": "resource",
      "description": "PandaDoc REST API resource (static API Key auth)."
    }
  },
  "x-dagster-provides": [
    "pandadoc_resource"
  ],
  "attributes": {
    "resource_key": {
      "type": "string",
      "label": "Resource Key",
      "description": "Key used to register this resource. Other components reference it via resource_key.",
      "required": false,
      "default": "pandadoc_resource"
    },
    "api_key": {
      "type": "string",
      "label": "API Key",
      "description": "PandaDoc API key.",
      "required": true,
      "ui:widget": "env_var"
    },
    "base_url": {
      "type": "string",
      "label": "Base URL",
      "description": "PandaDoc API base URL.",
      "required": false,
      "default": "https://api.pandadoc.com/public/v1"
    }
  },
  "tags": [
    "resource",
    "pandadoc",
    "esignature",
    "document"
  ],
  "name": "PandaDoc Resource"
}
