{
  "component_type": "dagster_component_templates.SapRFCResourceComponent",
  "description": "Register a connection to an SAP system over RFC (Remote Function Call) — for on-prem R/3 / ECC / S/4HANA installs without OData. Uses pyrfc + SAP NW RFC SDK.",
  "category": "resource",
  "icon": "si:sap",
  "attributes": {
    "resource_key": {"description": "Dagster resource key", "type": "string", "label": "Resource Key", "required": false, "default": "sap_rfc"},
    "ashost": {"description": "Application server host (direct connect)", "type": "string", "label": "App Server Host", "required": false},
    "sysnr": {"description": "System number, two-digit string (e.g. '00')", "type": "string", "label": "System Number", "required": false},
    "mshost": {"description": "Message server host (load-balanced connect)", "type": "string", "label": "Message Server Host", "required": false},
    "msserv": {"description": "Message server port/service name (default sapms<SYSID>).", "type": "string", "label": "Message Server Service", "required": false},
    "sysid": {"description": "System ID, three-character (e.g. 'PRD')", "type": "string", "label": "System ID", "required": false},
    "group": {"description": "Logon group, e.g. 'PUBLIC'", "type": "string", "label": "Logon Group", "required": false},
    "client": {"description": "SAP client number, three-digit string (e.g. '100')", "type": "string", "label": "Client", "required": true},
    "user": {"description": "RFC user name", "type": "string", "label": "User", "required": true},
    "passwd_env_var": {"description": "Env var holding the user's password", "type": "string", "label": "Password Env Var", "required": true},
    "lang": {"description": "Logon language code (e.g. 'EN', 'DE')", "type": "string", "label": "Language", "required": false, "default": "EN"},
    "snc_qop": {"description": "SNC quality of protection: '1' (auth only) / '2' (integrity) / '3' (privacy) / '9' (max).", "type": "string", "label": "SNC QoP", "required": false},
    "snc_myname": {"description": "SNC partner name (client side)", "type": "string", "label": "SNC My Name", "required": false},
    "snc_partnername": {"description": "SNC partner name (server side)", "type": "string", "label": "SNC Partner Name", "required": false},
    "snc_lib": {"description": "Path to SNC library (e.g. CommonCryptoLib)", "type": "string", "label": "SNC Library Path", "required": false},
    "trace": {"description": "RFC trace level 0-3", "type": "integer", "label": "Trace Level", "required": false, "default": 0},
    "connect_timeout_seconds": {"type": "integer", "label": "Connect Timeout (s)", "required": false, "default": 30}
  },
  "tags": ["resource", "sap", "rfc", "bapi", "idoc", "ecc", "r3", "s4hana"],
  "name": "SAP RFC Resource"
}
