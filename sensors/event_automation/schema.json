              "subject_template": {"type": "string"},
              "message_template": {"type": "string", "default": "Dagster automation fired: {event_type} {job_name} {status}"}
            },
            "required": ["type", "topic_arn"]
          },
          {
            "title": "sqs — send message to AWS SQS queue",
            "properties": {
              "type": {"const": "sqs"},
              "queue_url": {"type": "string"},
              "region": {"type": "string", "default": "us-east-1"},
              "body_template": {"type": "string"},
              "message_group_id": {"type": "string", "description": "For FIFO queues."},
              "message_deduplication_id_template": {"type": "string", "description": "For FIFO queues, templated."}
            },
            "required": ["type", "queue_url"]
          },
          {
            "title": "reload_code_location — reload a Dagster+ code location (or whole workspace)",
            "properties": {
              "type": {"const": "reload_code_location"},
              "location_name": {"type": "string", "description": "Location to reload. Templated. Unset = reload whole workspace."},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "deployment": {"type": "string", "default": "prod"}
            },
            "required": ["type"]
          },
          {
            "title": "refresh_defs_state — refresh Dagster+ definitions state for a code location",
            "properties": {
              "type": {"const": "refresh_defs_state"},
              "location_name": {"type": "string", "description": "Code location. Templated."},
              "defs_state_key": {"type": "string", "description": "Optional specific state key (uses refreshComponentState). Templated."},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "deployment": {"type": "string", "default": "prod"}
            },
            "required": ["type", "location_name"]
          },
          {
            "title": "set_concurrency_limit — dynamically adjust a pool's slot count",
            "properties": {
              "type": {"const": "set_concurrency_limit"},
