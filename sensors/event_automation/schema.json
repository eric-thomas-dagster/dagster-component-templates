              "type": {"const": "add_dynamic_partition"},
              "partitions_def_name": {"type": "string", "description": "DynamicPartitionsDefinition name."},
              "partition_key": {"type": "string", "description": "Partition key to add. Templated."}
            },
            "required": ["type", "partitions_def_name", "partition_key"]
          }
        ]
      },
      "required": true
    },
    "_throttle_shape": {
      "type": "object",
      "description": "Optional throttle config attached to any trigger via `throttle:`.",
      "properties": {
        "min_seconds_between_fires": {"type": "integer", "description": "Cooldown between successful fires."},
        "max_per_hour": {"type": "integer", "description": "Rolling-window hard cap."},
        "dedup_key_template": {"type": "string", "description": "Templated dedup key for state scoping."},
        "strategy": {"type": "string", "enum": ["silence", "summarize", "first_last", "llm", "escalate", "auto_resolve"], "default": "silence"},
        "flush_after_seconds": {"type": "integer", "default": 600, "description": "For summarize / first_last: buffer window."},
        "llm_provider": {"type": "string", "enum": ["openai", "anthropic"], "default": "openai"},
        "llm_model": {"type": "string", "default": "gpt-4o-mini"},
        "llm_api_key_env_var": {"type": "string", "default": "OPENAI_API_KEY"},
        "llm_prompt_template": {"type": "string", "description": "Custom prompt. Tokens: {message}, {recent}, plus standard tokens."},
        "llm_decision_cache_seconds": {"type": "integer", "default": 60},
        "business_hours_only": {
          "type": "string",
          "description": "Only fire during this daily window. Format: 'HH:MM-HH:MM tz [days]'. E.g. '09:00-17:00 America/New_York mon,tue,wed,thu,fri'."
        },
        "maintenance_windows": {
          "type": "array",
          "description": "Scheduled quiet periods. Fires within any listed window are suppressed.",
          "items": {
            "type": "object",
            "properties": {
              "from_ts": {"type": "string", "description": "ISO8601 start (e.g. '2024-01-15T02:00:00Z')."},
              "to_ts": {"type": "string", "description": "ISO8601 end."},
              "reason": {"type": "string", "description": "Free-form reason shown in logs."}
            },
            "required": ["from_ts", "to_ts"]
          }
        },
        "correlation_suppress_sensors": {
          "type": "array",
          "description": "Sensor-name substrings whose recent fires suppress THIS trigger (root-cause suppression).",
          "items": {"type": "string"}
        },
        "correlation_within_seconds": {"type": "integer", "default": 300, "description": "Correlation lookback window in seconds."},
        "escalation_ladder": {
          "type": "array",
          "description": "For strategy=escalate: fire count → which action indices fire.",
          "items": {
            "type": "object",
            "properties": {
              "after_fires": {"type": "integer", "description": "Fire count threshold (0 = first fire)."},
              "action_indices": {"type": "array", "items": {"type": "integer"}, "description": "Indices into the `then:` list to execute at this tier."}
            },
            "required": ["after_fires", "action_indices"]
          }
        },
        "auto_resolve_message": {
          "type": "string",
          "default": "✅ Resolved after {duration_seconds}s ({fire_count} fires)",
          "description": "For strategy=auto_resolve: message template for the paired resolve event."
        }
      }
    },
    "default_status": {
      "type": "string",
      "label": "Default Status",
      "description": "RUNNING | STOPPED for the generated sensors.",
      "enum": ["RUNNING", "STOPPED"],
      "default": "STOPPED"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Free-form description shown in the UI."
    }
  }
}
