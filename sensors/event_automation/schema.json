              "type": {"const": "opsgenie"},
              "api_key_env_var": {"type": "string"},
              "priority": {"type": "string", "enum": ["P1", "P2", "P3", "P4", "P5"], "default": "P3"},
              "message_template": {"type": "string", "default": "Dagster: {event_type} on {job_name} — {status}"},
              "dedup_key_template": {"type": "string"}
            },
            "required": ["type", "api_key_env_var"]
          },
          {
            "title": "mattermost — Mattermost webhook alert",
            "properties": {
              "type": {"const": "mattermost"},
              "webhook_url_env_var": {"type": "string"},
              "message": {"type": "string", "default": "Dagster automation fired: {event_type} {job_name} {status}"},
              "channel": {"type": "string"},
              "username": {"type": "string"}
            },
            "required": ["type", "webhook_url_env_var"]
