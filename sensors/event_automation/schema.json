{
  "component_type": "dagster_component_templates.EventAutomationComponent",
  "description": "35 declarative triggers → 17 actions in one YAML component. Prefect-Automations analog on top of real Dagster sensors.",
  "category": "sensor",
  "icon": "Bell",
  "x-dagster-io": {
    "outputs": {
      "type": "Sensor",
      "description": "One Dagster sensor per non-schedule trigger, all calling the same action bundle when they fire."
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "label": "Automation Name",
      "description": "Automation name — prefix for generated sensor names.",
      "required": true
    },
    "when": {
      "type": "array",
      "label": "Triggers",
      "description": "Triggers that fire the automation. OR semantics — any fires it. Discriminator: `type`.",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "title": "run_status — job / asset run finished with specific status",
            "properties": {
              "type": {"const": "run_status"},
              "status": {"type": "string", "enum": ["SUCCESS", "FAILURE", "CANCELED", "STARTED"], "description": "Run status to fire on."},
              "job_name": {"type": "string", "description": "Optional job filter. Omit = any job."},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name (e.g. 'prod_*')."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter — every listed key=value must be present in the run's tags."},
              "monitored_locations": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Cross-code-location: watch every job in these locations. Enables a dedicated 'alerts' code location that observes prod locations. Default: own location only."
              },
              "monitored_jobs": {
                "type": "array",
                "description": "Cross-code-location: watch specific jobs by (location, repository, job).",
                "items": {
                  "type": "object",
                  "properties": {
                    "location": {"type": "string", "description": "Code location name."},
                    "job": {"type": "string", "description": "Job name."},
                    "repository": {"type": "string", "default": "__repository__", "description": "Repository name. Defaults to __repository__ (create-dagster convention)."}
                  },
                  "required": ["location", "job"]
                }
              }
            },
            "required": ["type", "status"]
          },
          {
            "title": "asset_materialized — named assets got materialized",
            "properties": {
              "type": {"const": "asset_materialized"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."}
            },
            "required": ["type", "asset_keys"]
          },
          {
            "title": "schedule — cron trigger",
            "properties": {
              "type": {"const": "schedule"},
              "cron": {"type": "string", "description": "Cron expression, e.g. '0 * * * *'."},
              "execution_timezone": {"type": "string", "default": "UTC"}
            },
            "required": ["type", "cron"]
          },
          {
            "title": "http_poll — poll a URL, fire on condition",
            "properties": {
              "type": {"const": "http_poll"},
              "url": {"type": "string"},
              "method": {"type": "string", "default": "GET"},
              "headers": {"type": "object"},
              "minimum_interval_seconds": {"type": "integer", "default": 60, "description": "Seconds between polls. Minimum 10."},
              "condition": {"type": "string", "enum": ["response_changed", "status_ok", "json_path_present"], "default": "response_changed"},
              "json_path": {"type": "string", "description": "Required for condition=json_path_present. Dotted path into the JSON response."}
            },
            "required": ["type", "url"]
          },
          {
            "title": "freshness_violation — asset stale beyond max_age",
            "properties": {
              "type": {"const": "freshness_violation"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "max_age_minutes": {"type": "integer", "description": "Fire if latest materialization is older than this."},
              "minimum_interval_seconds": {"type": "integer", "default": 300}
            },
            "required": ["type", "asset_keys", "max_age_minutes"]
          },
          {
            "title": "run_duration — run finished + duration > threshold",
            "properties": {
              "type": {"const": "run_duration"},
              "max_duration_seconds": {"type": "integer", "description": "Fire when total run duration > this."},
              "job_name": {"type": "string", "description": "Optional job filter."},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter (all listed key=value must match)."},
              "on_status": {"type": "string", "enum": ["ANY", "SUCCESS", "FAILURE"], "default": "ANY"},
              "monitored_locations": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Cross-code-location: watch every job in these locations."
              },
              "monitored_jobs": {
                "type": "array",
                "description": "Cross-code-location: watch specific jobs by (location, repository, job).",
                "items": {
                  "type": "object",
                  "properties": {
                    "location": {"type": "string"},
                    "job": {"type": "string"},
                    "repository": {"type": "string", "default": "__repository__"}
                  },
                  "required": ["location", "job"]
                }
              }
            },
            "required": ["type", "max_duration_seconds"]
          },
          {
            "title": "run_stuck — active run running too long",
            "properties": {
              "type": {"const": "run_stuck"},
              "max_running_seconds": {"type": "integer", "description": "Fire when a run has been RUNNING for > this."},
              "job_name": {"type": "string", "description": "Optional job filter."},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "max_running_seconds"]
          },
          {
            "title": "asset_check_failed — reactive data quality",
            "properties": {
              "type": {"const": "asset_check_failed"},
              "check_names": {"type": "array", "items": {"type": "string"}, "description": "Names of checks to watch. Omit = any check failure."},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Optional asset key filter. — accepts a list of keys OR a Dagster asset-selection string (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, boolean composition) or fnmatch glob (`marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "metric_threshold — numeric metadata crossed threshold",
            "properties": {
              "type": {"const": "metric_threshold"},
              "asset_key": {"type": "string"},
              "metadata_key": {"type": "string", "description": "Numeric metadata key on the materialization (e.g. 'row_count')."},
              "comparison": {"type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "neq"]},
              "threshold": {"type": "number"},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_key", "metadata_key", "comparison", "threshold"]
          },
          {
            "title": "absence — dead-man's switch (no materialization in window)",
            "properties": {
              "type": {"const": "absence"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "max_gap_minutes": {"type": "integer", "description": "Fire if no materialization in this many minutes."},
              "minimum_interval_seconds": {"type": "integer", "default": 300}
            },
            "required": ["type", "asset_keys", "max_gap_minutes"]
          },
          {
            "title": "log_pattern — regex match on run log lines (events + stdout + stderr)",
            "properties": {
              "type": {"const": "log_pattern"},
              "pattern": {"type": "string", "description": "Regex pattern to match against log message text."},
              "job_name": {"type": "string", "description": "Optional job filter."},
              "sources": {
                "type": "array",
                "items": {"type": "string", "enum": ["events", "stdout", "stderr"]},
                "default": ["events"],
                "description": "Which log streams to scan. events = dagster user_message logs. stdout/stderr = compute_log_manager raw process output (K8s / ECS / Docker container output)."
              },
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "pattern"]
          },
          {
            "title": "daemon_heartbeat — Dagster daemon / agent stopped heartbeating",
            "properties": {
              "type": {"const": "daemon_heartbeat"},
              "daemon_type": {"type": "string", "description": "Filter to daemon type (SENSOR / SCHEDULER / …). None = all."},
              "max_seconds_since_heartbeat": {"type": "integer", "default": 120},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "code_location_status — code location failed or stuck loading",
            "properties": {
              "type": {"const": "code_location_status"},
              "on_status": {"type": "string", "enum": ["ERROR", "LOADING", "TIMED_OUT", "UNHEALTHY"]},
              "max_seconds_loading": {"type": "integer", "default": 300, "description": "For on_status=LOADING: fire when location has been LOADING > this."},
              "location_name_pattern": {"type": "string", "description": "Optional regex on location name."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "on_status"]
          },
          {
            "title": "run_startup_slow — run took too long to start (compute spinup)",
            "properties": {
              "type": {"const": "run_startup_slow"},
              "max_startup_seconds": {"type": "integer", "description": "Fire when time from run creation to STARTED > this."},
              "job_name": {"type": "string"},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "max_startup_seconds"]
          },
          {
            "title": "asset_observation — AssetObservation event emitted",
            "properties": {
              "type": {"const": "asset_observation"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_keys"]
          },
          {
            "title": "step_error — op step raised an exception (step-level)",
            "properties": {
              "type": {"const": "step_error"},
              "job_name": {"type": "string"},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter."},
              "step_key_pattern": {"type": "string", "description": "Optional regex on step key."},
              "exception_pattern": {"type": "string", "description": "Optional regex on exception message."},
              "only_final_failures": {
                "type": "boolean",
                "default": false,
                "description": "When True, skip intermediate attempts that will be retried by the op's RetryPolicy. Only fires when the step is definitively FAILURE."
              },
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "metadata_match — materialization/observation carries specific metadata",
            "properties": {
              "type": {"const": "metadata_match"},
              "asset_key": {"type": "string"},
              "metadata_key": {"type": "string"},
              "equals": {"type": "string", "description": "Exact-match value. Mutually exclusive with regex."},
              "regex": {"type": "string", "description": "Regex on str(value). Mutually exclusive with equals."},
              "include_observations": {"type": "boolean", "default": true, "description": "True = match on materializations AND observations."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_key", "metadata_key"]
          },
          {
            "title": "asset_value_change — numeric metadata Δ across materializations",
            "properties": {
              "type": {"const": "asset_value_change"},
              "asset_key": {"type": "string"},
              "metadata_key": {"type": "string", "description": "Numeric metadata key to compare across materializations."},
              "direction": {"type": "string", "enum": ["any", "increase", "decrease"], "default": "any"},
              "min_delta": {"type": "number", "description": "Absolute delta threshold."},
              "min_delta_pct": {"type": "number", "description": "Percentage delta threshold (0-100). Fires when |Δ|/prev > this."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_key", "metadata_key"]
          },
          {
            "title": "backfill_status — partition backfill entered a state",
            "properties": {
              "type": {"const": "backfill_status"},
              "status": {"type": "string", "enum": ["COMPLETED", "FAILED", "CANCELED", "REQUESTED"]},
              "job_name": {"type": "string", "description": "Optional job filter."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "status"]
          },
          {
            "title": "sensor_failing — target sensor has failed N consecutive ticks",
            "properties": {
              "type": {"const": "sensor_failing"},
              "target_sensor_name": {"type": "string", "description": "Name of the sensor to monitor."},
              "consecutive_failures": {"type": "integer", "default": 3, "description": "Number of consecutive failures to fire on."},
              "minimum_interval_seconds": {"type": "integer", "default": 120}
            },
            "required": ["type", "target_sensor_name"]
          },
          {
            "title": "concurrency_hit — active-run count exceeded threshold",
            "properties": {
              "type": {"const": "concurrency_hit"},
              "max_queued": {"type": "integer", "description": "Fire when queued+running count > this."},
              "tag_key": {"type": "string", "description": "Optional tag filter."},
              "tag_value": {"type": "string", "description": "Optional tag value filter."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "max_queued"]
          },
          {
            "title": "hook_fired — a Dagster hook (@success_hook / @failure_hook) executed",
            "properties": {
              "type": {"const": "hook_fired"},
              "hook_name_pattern": {"type": "string"},
              "on_status": {"type": "string", "enum": ["ANY", "SUCCESS", "FAILURE"], "default": "ANY"},
              "job_name": {"type": "string"},
              "job_name_pattern": {"type": "string", "description": "Optional fnmatch glob on the run's job_name."},
              "run_tags": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Optional run-tag filter."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "asset_partition_materialized — specific asset PARTITION materialized",
            "properties": {
              "type": {"const": "asset_partition_materialized"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "partition_key": {
                "oneOf": [
                  {"type": "string", "description": "Exact partition match — single-dim (e.g. '2024-01-15')."},
                  {"type": "object", "additionalProperties": {"type": "string"}, "description": "Multi-dim partition filter — one entry per dimension. Unspecified dims wildcard (e.g. {region: 'us'} matches every date for region=us)."}
                ],
                "description": "Exact partition match. String for single-dim, object for MultiPartitionsDefinition."
              },
              "partition_key_pattern": {"type": "string", "description": "Regex on partition key (string form only)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_keys"]
          },
          {
            "title": "run_reexecution — a run was re-executed (retry audit)",
            "properties": {
              "type": {"const": "run_reexecution"},
              "job_name": {"type": "string"},
              "strategy": {"type": "string", "enum": ["from_failure", "all_steps"]},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "asset_wipe — materialization history wiped (destructive audit)",
            "properties": {
              "type": {"const": "asset_wipe"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Watch these. None = any wipe. — accepts a list of keys OR a Dagster asset-selection string (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, boolean composition) or fnmatch glob (`marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "config_override — run launched with non-default config (change-tracking)",
            "properties": {
              "type": {"const": "config_override"},
              "job_name": {"type": "string"},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "tag_set — run carries specific tag key/value (audit + routing)",
            "properties": {
              "type": {"const": "tag_set"},
              "tag_key": {"type": "string"},
              "tag_value": {"type": "string", "description": "Exact value. Omit = any value."},
              "tag_value_pattern": {"type": "string", "description": "Regex on value."},
              "on_status": {"type": "string", "default": "STARTED"},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "tag_key"]
          },
          {
            "title": "unhandled_exception — run-level unhandled exception (infra crash)",
            "properties": {
              "type": {"const": "unhandled_exception"},
              "job_name": {"type": "string"},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "asset_check_severity — asset check evaluations at specific severity",
            "properties": {
              "type": {"const": "asset_check_severity"},
              "severity": {"type": "string", "enum": ["WARN", "ERROR"]},
              "check_names": {"type": "array", "items": {"type": "string"}},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "severity"]
          },
          {
            "title": "op_output — a specific op yielded output (STEP_OUTPUT event)",
            "properties": {
              "type": {"const": "op_output"},
              "step_key_pattern": {"type": "string", "description": "Regex on step key."},
              "output_name": {"type": "string"},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "step_key_pattern"]
          },
          {
            "title": "materialization_planned — pre-materialization event (warm caches, etc.)",
            "properties": {
              "type": {"const": "materialization_planned"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "asset_keys"]
          },
          {
            "title": "asset_check_started — asset check evaluation started",
            "properties": {
              "type": {"const": "asset_check_started"},
              "check_names": {"type": "array", "items": {"type": "string"}},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type"]
          },
          {
            "title": "insights_metric — Dagster+ Insights time-window aggregate crossed threshold",
            "properties": {
              "type": {"const": "insights_metric"},
              "metric_name": {"type": "string", "description": "Dagster+ Insights metric name."},
              "comparison": {"type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "neq"]},
              "threshold": {"type": "number"},
              "granularity": {"type": "string", "enum": ["HOURLY", "DAILY", "WEEKLY", "MONTHLY"], "default": "DAILY", "description": "Time bucket size (Victoria Metrics)."},
              "aggregation": {"type": "string", "enum": ["SUM", "AVERAGE", "MIN", "MAX"], "default": "SUM", "description": "How values within a bucket combine."},
              "lookback_hours": {"type": "integer", "default": 24, "description": "Hours of history to fetch."},
              "asset_selection": {"type": "string", "description": "Optional Dagster asset-selection string, resolved server-side ('group:X', 'tag:foo=bar', 'kind:Y', 'is:external', 'key:\"path/to/asset\"'). Unset = deployment-wide."},
              "deployment": {"type": "string", "default": "prod"},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "minimum_interval_seconds": {"type": "integer", "default": 300}
            },
            "required": ["type", "metric_name", "comparison", "threshold"]
          },
          {
            "title": "dagster_plus_audit — Dagster+ audit log event matching filter",
            "properties": {
              "type": {"const": "dagster_plus_audit"},
              "event_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "CHANGE_USER_PERMISSIONS", "CREATE_SERVICE_USER", "UPDATE_SERVICE_USER",
                    "DELETE_SERVICE_USER", "CHANGE_SERVICE_USER_PERMISSIONS",
                    "CREATE_USER_TOKEN", "REVOKE_USER_TOKEN", "CREATE_AGENT_TOKEN",
                    "REVOKE_AGENT_TOKEN", "UPDATE_AGENT_TOKEN_PERMISSIONS",
                    "CREATE_SERVICE_TOKEN", "REVOKE_SERVICE_TOKEN", "PUT_REVOKE_TOKEN",
                    "CREATE_SECRET", "UPDATE_SECRET", "DELETE_SECRET",
                    "CREATE_DEPLOYMENT", "DELETE_DEPLOYMENT", "UPDATE_DEPLOYMENT_SETTINGS",
                    "CREATE_CODE_LOCATION", "UPDATE_CODE_LOCATION", "DELETE_CODE_LOCATION",
                    "REDEPLOY_SERVERLESS_AGENT",
                    "UPDATE_SCHEDULE", "UPDATE_SENSOR", "SET_AUTO_MATERIALIZE_PAUSED",
                    "LAUNCH_RUN", "LAUNCH_BACKFILL",
                    "MODIFY_ALERT_POLICIES", "SET_ALERT_POLICY_MUTE_UNTIL",
                    "CREATE_ORGANIZATION_SUBDOMAIN", "DELETE_ORGANIZATION_SUBDOMAIN",
                    "UPDATE_SUBSCRIPTION_PLAN", "UPDATE_SUBSCRIPTION_TYPE",
                    "LOG_IN", "IFRAME_LOG_IN",
                    "EDIT_CUSTOMER_ID", "EDIT_SALESFORCE_ACCOUNT_ID", "CREATE_ENT_TRIAL",
                    "UPDATE_TRIAL_DAYS", "SET_ACCOUNT_REVIEW",
                    "UPDATE_INTERNAL_ORGANIZATION_SETTINGS", "UPDATE_AGENT_TYPE"
                  ]
                },
                "description": "Server-side push-down filter. Full 42-value AuditLogEventType enum. Prefer this over event_type_pattern for exact-match cases."
              },
              "user_emails": {"type": "array", "items": {"type": "string"}, "description": "Server-side push-down filter: list of actor emails."},
              "deployment_names": {"type": "array", "items": {"type": "string"}, "description": "Server-side push-down filter: which deployments to include."},
              "is_branch_deployment": {"type": "boolean", "description": "Server-side filter: true = branch deployments only, false = main only, null = both."},
              "event_type_pattern": {"type": "string", "description": "Client-side regex on audit event type (applied after event_types push-down)."},
              "actor_pattern": {"type": "string", "description": "Client-side regex on actor email/ID."},
              "deployment": {"type": "string", "default": "prod"},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "minimum_interval_seconds": {"type": "integer", "default": 300}
            },
            "required": ["type"]
          },
          {
            "title": "sqs_poll — poll an AWS SQS queue for messages",
            "properties": {
              "type": {"const": "sqs_poll"},
              "queue_url": {"type": "string"},
              "region": {"type": "string", "default": "us-east-1"},
              "max_messages": {"type": "integer", "default": 10, "minimum": 1, "maximum": 10},
              "minimum_interval_seconds": {"type": "integer", "default": 30},
              "delete_after": {"type": "boolean", "default": true}
            },
            "required": ["type", "queue_url"]
          },
          {
            "title": "all_of — AND-composition, fire when all sub-triggers fire within window",
            "properties": {
              "type": {"const": "all_of"},
              "triggers": {
                "type": "array",
                "description": "Leaf sub-triggers OR one level of any_of. Deeper nesting isn't supported by the type system.",
                "items": {"type": "object"}
              },
              "within_seconds": {"type": "integer", "default": 3600},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "triggers"]
          },
          {
            "title": "any_of — OR-composition inside a compound (nested-only)",
            "properties": {
              "type": {"const": "any_of"},
              "triggers": {"type": "array", "items": {"type": "object"}},
              "minimum_interval_seconds": {"type": "integer", "default": 60}
            },
            "required": ["type", "triggers"]
          }
        ]
      },
      "required": true
    },
    "then": {
      "type": "array",
      "label": "Actions",
      "description": "Actions to run when a trigger fires. All run, sequentially. Discriminator: `type`.",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "title": "materialize — launch materialization for named assets",
            "properties": {
              "type": {"const": "materialize"},
              "asset_keys": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}], "description": "Accepts a list of keys OR a Dagster asset-selection string / fnmatch glob (`group:X`, `tag:foo=bar`, `kind:Y`, `is:external`, `marts/*`)."},
              "partition_key": {
                "oneOf": [
                  {"type": "string", "description": "Single-dim partition. Values run through template rendering — use '{partition_key}' to pull from the triggering event."},
                  {"type": "object", "additionalProperties": {"type": "string"}, "description": "MultiPartitionsDefinition — one entry per dimension. Values templated (e.g. {date: '{partition_date}', region: '{partition_region}'})."}
                ],
                "description": "Optional partition to materialize. String OR dict; values templated with trigger tokens."
              }
            },
            "required": ["type", "asset_keys"]
          },
          {
            "title": "launch_job — launch a job",
            "properties": {
              "type": {"const": "launch_job"},
              "job_name": {"type": "string"},
              "tags": {"type": "object"}
            },
            "required": ["type", "job_name"]
          },
          {
            "title": "webhook — arbitrary HTTP call with templated body",
            "properties": {
              "type": {"const": "webhook"},
              "url": {"type": "string"},
              "method": {"type": "string", "default": "POST"},
              "headers": {"type": "object"},
              "body_template": {"type": "string", "description": "Supports {event_type}, {run_id}, {job_name}, {asset_key}, {status}, {timestamp}, {message}, {url} tokens."},
              "timeout_seconds": {"type": "integer", "default": 15}
            },
            "required": ["type", "url"]
          },
          {
            "title": "slack — Slack incoming-webhook alert",
            "properties": {
              "type": {"const": "slack"},
              "webhook_url_env_var": {"type": "string", "description": "Env var holding the Slack webhook URL."},
              "channel": {"type": "string"},
              "message": {"type": "string", "default": "Dagster automation fired: {event_type} {job_name} {status}"},
              "username": {"type": "string"},
              "icon_emoji": {"type": "string"}
            },
            "required": ["type", "webhook_url_env_var"]
          },
          {
            "title": "pagerduty — PagerDuty Events API v2",
            "properties": {
              "type": {"const": "pagerduty"},
              "routing_key_env_var": {"type": "string"},
              "severity": {"type": "string", "enum": ["critical", "error", "warning", "info"], "default": "error"},
              "summary_template": {"type": "string", "default": "Dagster: {event_type} on {job_name} — {status}"},
              "dedup_key_template": {"type": "string"},
              "event_action": {"type": "string", "enum": ["trigger", "acknowledge", "resolve"], "default": "trigger"}
            },
            "required": ["type", "routing_key_env_var"]
          },
          {
            "title": "discord — Discord webhook alert",
            "properties": {
              "type": {"const": "discord"},
              "webhook_url_env_var": {"type": "string"},
              "message": {"type": "string", "default": "Dagster automation fired: {event_type} {job_name} {status}"}
            },
            "required": ["type", "webhook_url_env_var"]
          },
          {
            "title": "emit_event — log emission for downstream sensor chaining",
            "properties": {
              "type": {"const": "emit_event"},
              "asset_key": {"type": "string"},
              "metadata_template": {"type": "object"}
