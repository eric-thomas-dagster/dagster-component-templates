            "required": ["type", "smtp_host_env_var", "smtp_user_env_var", "smtp_password_env_var", "from_addr", "to"]
          },
          {
            "title": "teams — Microsoft Teams webhook alert",
            "properties": {
              "type": {"const": "teams"},
              "webhook_url_env_var": {"type": "string"},
              "message": {"type": "string", "default": "Dagster automation fired: {event_type} {job_name} {status}"},
              "title": {"type": "string"}
            },
            "required": ["type", "webhook_url_env_var"]
          },
          {
            "title": "opsgenie — OpsGenie Alerts API",
