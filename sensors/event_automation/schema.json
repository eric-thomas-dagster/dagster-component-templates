            "required": ["type", "asset_key"]
          },
          {
            "title": "cancel_run — terminate a run",
            "properties": {
              "type": {"const": "cancel_run"},
              "which": {"type": "string", "enum": ["triggering", "all_matching"], "default": "triggering"},
              "job_name_filter": {"type": "string", "description": "Only used when which=all_matching."}
            },
            "required": ["type"]
          },
          {
            "title": "retry_run — re-execute a failed run",
            "properties": {
              "type": {"const": "retry_run"},
              "strategy": {"type": "string", "enum": ["from_failure", "all_steps"], "default": "from_failure"}
            },
            "required": ["type"]
          },
          {
            "title": "email — SMTP email alert (stdlib smtplib)",
            "properties": {
              "type": {"const": "email"},
              "smtp_host_env_var": {"type": "string"},
              "smtp_port_env_var": {"type": "string"},
              "smtp_user_env_var": {"type": "string"},
              "smtp_password_env_var": {"type": "string"},
              "from_addr": {"type": "string"},
              "to": {"type": "array", "items": {"type": "string"}},
              "subject_template": {"type": "string", "default": "Dagster: {event_type} {job_name} {status}"},
              "body_template": {"type": "string"},
              "use_tls": {"type": "boolean", "default": true}
