              "deployment": {"type": "string", "default": "prod"}
            },
            "required": ["type", "backfill_id"]
          },
          {
            "title": "cancel_backfill — cancel a partition backfill in progress",
            "properties": {
              "type": {"const": "cancel_backfill"},
              "backfill_id": {"type": "string", "description": "Backfill ID. Templated."},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "deployment": {"type": "string", "default": "prod"}
            },
            "required": ["type", "backfill_id"]
          },
          {
            "title": "reexecute_backfill — re-execute a failed partition backfill",
            "properties": {
              "type": {"const": "reexecute_backfill"},
              "backfill_id": {"type": "string", "description": "Parent backfill ID. Templated."},
              "from_failure": {"type": "boolean", "default": true, "description": "true = FROM_FAILURE (only failed partitions); false = ALL_STEPS."},
              "org_env_var": {"type": "string", "default": "DAGSTER_CLOUD_ORGANIZATION"},
              "token_env_var": {"type": "string", "default": "DAGSTER_CLOUD_API_TOKEN"},
              "deployment": {"type": "string", "default": "prod"}
            },
            "required": ["type", "backfill_id"]
          },
          {
            "title": "add_dynamic_partition — register a new dynamic partition programmatically",
