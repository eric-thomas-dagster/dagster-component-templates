            "title": "set_auto_materialize_paused — globally pause/unpause Declarative Automation (Dagster+)",
            "properties": {
              "type": {"const": "set_auto_materialize_paused"},
              "paused": {"type": "boolean", "description": "true = pause, false = unpause."},
