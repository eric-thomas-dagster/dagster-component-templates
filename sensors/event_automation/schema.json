            "required": ["type", "sensor_name", "action"]
          },
          {
            "title": "toggle_schedule — start / stop a Dagster schedule by name",
            "properties": {
              "type": {"const": "toggle_schedule"},
              "schedule_name": {"type": "string"},
              "action": {"type": "string", "enum": ["start", "stop"]}
            },
            "required": ["type", "schedule_name", "action"]
          },
          {
            "title": "sns — publish to AWS SNS topic",
            "properties": {
              "type": {"const": "sns"},
