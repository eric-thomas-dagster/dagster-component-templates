{
  "component_type": "dagster_component_templates.GitlabEventSensorComponent",
  "description": "Trigger a run when a GitLab project has new events (push, merge, issue, comment).",
  "category": "sensor",
  "icon": "si:gitlab",
  "x-dagster-io": {
    "outputs": {
      "type": "RunRequest",
      "description": "RunRequest per new event"
    }
  },
  "attributes": {
    "sensor_name": {
      "description": "Unique sensor name.",
      "type": "string",
      "label": "Sensor Name",
      "required": true
    },
    "asset_keys": {
      "description": "Slash-separated asset keys to materialize when an event matches.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Asset Keys",
      "required": true
    },
    "minimum_interval_seconds": {
      "description": "Minimum seconds between sensor evaluations.",
      "type": "integer",
      "label": "Minimum Interval Seconds",
      "default": 60,
      "required": false
    },
    "default_status": {
      "description": "'RUNNING' or 'STOPPED'.",
      "type": "string",
      "label": "Default Status",
      "default": "stopped",
      "enum": [
        "running",
        "stopped"
      ],
      "required": false
    },
    "project_id": {
      "description": "GitLab project ID or URL-encoded path (e.g. 'my-org%2Fmy-repo').",
      "type": "string",
      "label": "Project Id",
      "required": true
    },
    "token_env_var": {
      "description": "Env var with a GitLab PAT or project token.",
      "type": "string",
      "label": "Token Env Var",
      "required": true
    },
    "base_url": {
      "description": "GitLab instance base URL (override for self-hosted).",
      "type": "string",
      "label": "Base Url",
      "required": true
    },
    "actions": {
      "description": "Event 'action_name' values to filter on.",
      "type": "array",
      "label": "Actions",
      "required": true
    }
  },
  "tags": [
    "sensor",
    "gitlab",
    "vcs",
    "ci"
  ],
  "name": "GitlabEventSensor"
}
