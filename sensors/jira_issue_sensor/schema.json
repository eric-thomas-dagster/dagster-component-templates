{
  "component_type": "dagster_component_templates.JiraIssueSensorComponent",
  "description": "Trigger a run when Jira has new or updated issues matching a JQL query.",
  "category": "sensor",
  "icon": "si:jira",
  "x-dagster-io": {
    "outputs": {
      "type": "RunRequest",
      "description": "RunRequest per new event"
    }
  },
  "attributes": {
    "sensor_name": {
      "description": "Unique sensor name.",
      "type": "string",
      "label": "Sensor Name",
      "required": true
    },
    "asset_keys": {
      "description": "Slash-separated asset keys to materialize when an event matches.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Asset Keys",
      "required": true
    },
    "minimum_interval_seconds": {
      "description": "Minimum seconds between sensor evaluations.",
      "type": "integer",
      "label": "Minimum Interval Seconds",
      "default": 60,
      "required": false
    },
    "default_status": {
      "description": "'RUNNING' or 'STOPPED'.",
      "type": "string",
      "label": "Default Status",
      "default": "stopped",
      "enum": [
        "running",
        "stopped"
      ],
      "required": false
    },
    "base_url": {
      "description": "Jira base URL (e.g. https://mycompany.atlassian.net).",
      "type": "string",
      "label": "Base Url",
      "required": true
    },
    "email": {
      "description": "Atlassian email.",
      "type": "string",
      "label": "Email",
      "required": true
    },
    "api_token_env_var": {
      "description": "Env var with the Atlassian API token.",
      "type": "string",
      "label": "Api Token Env Var",
      "required": true
    },
    "jql": {
      "description": "Base JQL query (e.g. 'project = OPS AND status != Done').",
      "type": "string",
      "label": "Jql",
      "required": true
    },
    "fields": {
      "description": "Fields to fetch per issue.",
      "type": "array",
      "label": "Fields",
      "required": true
    }
  },
  "tags": [
    "sensor",
    "jira",
    "atlassian",
    "issue-tracking"
  ],
  "name": "JiraIssueSensor"
}
