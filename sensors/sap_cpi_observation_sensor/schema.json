{
  "component_type": "dagster_component_templates.SapCPIObservationSensorComponent",
  "description": "Poll SAP Integration Suite (CPI) Message Processing Logs and emit AssetObservations per iFlow run. Cloud middleware observability without owning the iFlow in Dagster.",
  "category": "observation",
  "icon": "si:sap",
  "attributes": {
    "sensor_name": {
      "description": "Unique Dagster sensor name",
      "type": "string",
      "label": "Sensor Name",
      "required": true
    },
    "tmn_host": {
      "description": "Integration Suite Tenant Management Node URL (e.g. https://<tenant>.it-cpi<n>.cfapps.<region>.hana.ondemand.com)",
      "type": "string",
      "label": "TMN Host",
      "required": true
    },
    "iflow_id": {
      "description": "iFlow IntegrationFlow ID to observe. Leave empty to observe ALL iFlows on the tenant.",
      "type": "string",
      "label": "IntegrationFlow ID",
      "required": false
    },
    "asset_key": {
      "description": "Dagster asset key to emit observations for (slash-delimited)",
      "type": "string",
      "label": "Asset Key",
      "required": true
    },
    "oauth_token_resource_key": {
      "description": "Key of a registered oauth_token_resource",
      "type": "string",
      "label": "OAuth Token Resource Key",
      "required": true
    },
    "only_statuses": {
      "description": "Filter to specific MPL statuses: COMPLETED, FAILED, RETRY, etc. Default: all.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Only Statuses",
      "required": false,
      "ui:widget": "list"
    },
    "minimum_interval_seconds": {
      "type": "integer",
      "label": "Min Interval (s)",
      "required": false,
      "default": 60
    },
    "request_timeout_seconds": {
      "type": "integer",
      "label": "Request Timeout (s)",
      "required": false,
      "default": 60
    },
    "batch_size": {
      "description": "Max MPLs per poll",
      "type": "integer",
      "label": "Batch Size",
      "required": false,
      "default": 50
    },
    "verify_ssl": {
      "type": "boolean",
      "label": "Verify SSL",
      "required": false,
      "default": true,
      "ui:widget": "checkbox"
    },
    "default_status": {
      "type": "string",
      "label": "Default Status",
      "required": false,
      "default": "stopped",
      "enum": [
        "stopped",
        "running"
      ],
      "ui:widget": "select"
    }
  },
  "tags": [
    "observation",
    "sensor",
    "sap",
    "cpi",
    "integration-suite",
    "btp",
    "iflow"
  ],
  "name": "SAP CPI Observation Sensor"
}
