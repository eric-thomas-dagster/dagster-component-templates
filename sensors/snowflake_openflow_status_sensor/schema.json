{
  "component_type": "dagster_community_components.SnowflakeOpenflowStatusSensorComponent",
  "description": "Poll SNOWFLAKE.TELEMETRY.EVENTS for openflow_metric activity on a named flow; emit AssetMaterialization (and optional RunRequest) when activity advances.",
  "category": "sensor",
  "icon": "si:snowflake",
  "x-dagster-io": {
    "outputs": { "type": "AssetMaterialization", "description": "AssetMaterialization (asset_key set) and/or RunRequest (job_name set)" }
  },
  "attributes": {
    "sensor_name": {"description": "Unique sensor name.", "type": "string", "label": "Sensor Name", "required": true },
    "flow_name": { "type": "string", "label": "Flow Name", "description": "OpenFlow process-group name", "required": true },
    "asset_key": {"description": "Optional Dagster asset key. When set, the sensor yields AssetMaterialization(asset_key=...) when the flow's most recent activity timestamp advances past the cursor.", "type": "string", "label": "Asset Key", "required": false, "default": null },
    "job_name": {"description": "Optional Dagster job to trigger via RunRequest on each activity advance.", "type": "string", "label": "Job Name", "required": false, "default": null },
    "account_env_var": {"description": "Env var with Snowflake account.", "type": "string", "label": "Account Env Var", "required": true, "ui:widget": "env_var" },
    "user_env_var": {"description": "Env var with Snowflake username.", "type": "string", "label": "User Env Var", "required": true, "ui:widget": "env_var" },
    "password_env_var": {"description": "Env var with Snowflake password.", "type": "string", "label": "Password Env Var", "required": false, "ui:widget": "env_var" },
    "pat_env_var": {"description": "Env var with Snowflake PAT.", "type": "string", "label": "PAT Env Var", "required": false, "ui:widget": "env_var" },
    "private_key_path_env_var": {"description": "Env var with RSA private key path.", "type": "string", "label": "Private Key Path Env Var", "required": false, "ui:widget": "env_var" },
    "private_key_passphrase_env_var": {"description": "Env var with private-key passphrase.", "type": "string", "label": "Private Key Passphrase Env Var", "required": false, "ui:widget": "env_var" },
    "warehouse_env_var": {"description": "Env var with Snowflake warehouse.", "type": "string", "label": "Warehouse Env Var", "required": false, "ui:widget": "env_var" },
    "role_env_var": {"description": "Env var with Snowflake role.", "type": "string", "label": "Role Env Var", "required": false, "ui:widget": "env_var" },
    "minimum_interval_seconds": {"description": "Seconds between Telemetry polls.", "type": "integer", "label": "Minimum Interval Seconds", "required": false, "default": 120 },
    "lookback_minutes": {"description": "How far back to query TELEMETRY each tick.", "type": "integer", "label": "Lookback Minutes", "required": false, "default": 15 },
    "default_status": {"description": "'running' or 'stopped'.", "type": "string", "label": "Default Status", "required": false, "default": "running", "enum": ["running", "stopped"] }
  },
  "tags": ["sensor", "snowflake", "openflow", "telemetry"],
  "name": "Snowflake OpenFlow Status Sensor"
}
