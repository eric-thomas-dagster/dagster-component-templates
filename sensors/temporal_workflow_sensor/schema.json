{
  "component_type": "dagster_community_components.TemporalWorkflowSensorComponent",
  "description": "Poll Temporal for terminal workflow status and fire a Dagster job + optional AssetMaterialization/Observation.",
  "category": "sensor",
  "icon": "si:temporal",
  "attributes": {
    "sensor_name": {"label": "Sensor Name", "type": "string", "required": true},
    "workflow_id": {"label": "Workflow ID", "type": "string", "required": false, "description": "Specific Temporal Workflow ID. Set this OR list_filter."},
    "list_filter": {"label": "List Filter", "type": "string", "required": false, "description": "Temporal Visibility List filter. Sensor picks the most-recently-closed match."},
    "job_name": {"label": "Job Name", "type": "string", "required": true},
    "asset_key": {"label": "Asset Key", "type": "string", "required": false, "description": "Optional Dagster asset key to materialize / observe on terminal success."},
    "asset_event_type": {"label": "Asset Event Type", "type": "string", "required": false, "default": "materialization", "enum": ["materialization", "observation"]},
    "target_host": {"label": "Target Host", "type": "string", "required": false, "default": "localhost:7233"},
    "namespace": {"label": "Namespace", "type": "string", "required": false, "default": "default"},
    "api_key_env_var": {"label": "API Key Env Var", "type": "string", "required": false},
    "tls_cert_env_var": {"label": "Tls Cert Env Var", "type": "string", "required": false},
    "tls_key_env_var": {"label": "Tls Key Env Var", "type": "string", "required": false},
    "tls_server_root_ca_env_var": {"label": "Tls Server Root Ca Env Var", "type": "string", "required": false},
    "minimum_interval_seconds": {"label": "Minimum Interval Seconds", "type": "integer", "required": false, "default": 60},
    "default_status": {"label": "Default Status", "type": "string", "required": false, "default": "running", "enum": ["running", "stopped"]}
  }
}
