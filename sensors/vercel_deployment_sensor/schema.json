{
  "component_type": "dagster_community_components.VercelDeploymentSensorComponent",
  "description": "Poll Vercel for deployment state, emit AssetMaterialization/Observation on READY, and fire a Dagster job. Optionally fire on ERROR for alert flows.",
  "category": "sensor",
  "icon": "si:vercel",
  "attributes": {
    "sensor_name": {"label": "Sensor Name", "type": "string", "required": true},
    "project_id": {"label": "Project ID", "type": "string", "required": false, "description": "Vercel project ID (prj_...). Set this OR project_name."},
    "project_name": {"label": "Project Name", "type": "string", "required": false, "description": "Vercel project slug (URL name)."},
    "target": {"label": "Target", "type": "string", "required": false, "default": "production", "enum": ["production", "preview", "development", "any"]},
    "team_id": {"label": "Team ID", "type": "string", "required": false, "description": "Vercel team ID (team_...). Required for team-scoped projects."},
    "api_token_env_var": {"label": "API Token Env Var", "type": "string", "required": false, "default": "VERCEL_API_TOKEN"},
    "api_base_url": {"label": "API Base URL", "type": "string", "required": false, "default": "https://api.vercel.com"},
    "job_name": {"label": "Job Name", "type": "string", "required": true},
    "asset_key": {"label": "Asset Key", "type": "string", "required": false},
    "asset_event_type": {"label": "Asset Event Type", "type": "string", "required": false, "default": "materialization", "enum": ["materialization", "observation"]},
    "error_state_triggers_job": {"label": "Error State Triggers Job", "type": "boolean", "required": false, "default": false},
    "minimum_interval_seconds": {"label": "Minimum Interval Seconds", "type": "integer", "required": false, "default": 60},
    "default_status": {"label": "Default Status", "type": "string", "required": false, "default": "running", "enum": ["running", "stopped"]}
  }
}
