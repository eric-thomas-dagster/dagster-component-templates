{
  "component_type": "dagster_component_templates.ZendeskTicketSensorComponent",
  "description": "Trigger a run when Zendesk has new or updated tickets matching a query.",
  "category": "sensor",
  "icon": "si:zendesk",
  "x-dagster-io": {
    "outputs": {
      "type": "RunRequest",
      "description": "RunRequest per new event"
    }
  },
  "attributes": {
    "sensor_name": {
      "description": "Unique sensor name.",
      "type": "string",
      "label": "Sensor Name",
      "required": true
    },
    "asset_keys": {
      "description": "Slash-separated asset keys to materialize when an event matches.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "label": "Asset Keys",
      "required": true
    },
    "minimum_interval_seconds": {
      "description": "Minimum seconds between sensor evaluations.",
      "type": "integer",
      "label": "Minimum Interval Seconds",
      "default": 60,
      "required": false
    },
    "default_status": {
      "description": "'RUNNING' or 'STOPPED'.",
      "type": "string",
      "label": "Default Status",
      "default": "stopped",
      "enum": [
        "running",
        "stopped"
      ],
      "required": false
    },
    "subdomain": {
      "description": "Zendesk subdomain (e.g. 'mycompany' for mycompany.zendesk.com).",
      "type": "string",
      "label": "Subdomain",
      "required": true
    },
    "email": {
      "description": "Zendesk user email used with the API token.",
      "type": "string",
      "label": "Email",
      "required": true
    },
    "api_token_env_var": {
      "description": "Env var with the Zendesk API token.",
      "type": "string",
      "label": "Api Token Env Var",
      "required": true
    },
    "statuses": {
      "description": "Optional ticket statuses to filter on (e.g. ['new', 'open']).",
      "type": "array",
      "label": "Statuses",
      "required": false
    }
  },
  "tags": [
    "sensor",
    "zendesk",
    "support",
    "ticket"
  ],
  "name": "ZendeskTicketSensor"
}
