{
  "component_type": "dagster_component_templates.SiemEventNormalizerComponent",
  "description": "Normalize heterogeneous audit-log events to a common schema (OCSF or ECS) before shipping to a SIEM.",
  "category": "security",
  "vertical": "security",
  "x-dagster-io": {
    "inputs": {
      "type": "dataframe",
      "required": true
    },
    "outputs": {
      "type": "dataframe"
    }
  },
  "icon": "Shield",
  "attributes": {
    "asset_name": {
      "type": "string",
      "label": "Asset Name",
      "description": "Dagster asset name",
      "required": true
    },
    "upstream_asset_key": {
      "type": "string",
      "label": "Upstream Asset Key",
      "description": "Upstream DataFrame to normalize",
      "required": true
    },
    "source_kind": {
      "type": "string",
      "label": "Source Kind",
      "description": "Source hint: 'cloudtrail' | 'okta' | 'github' | 'azure' | 'generic'",
      "required": false,
      "default": "generic",
      "enum": [
        "cloudtrail",
        "okta",
        "github",
        "azure",
        "generic"
      ],
      "ui:widget": "select"
    },
    "event_column": {
      "type": "string",
      "label": "Event Column",
      "description": "If set, treat this column as a JSON-encoded event payload and parse it into source columns before normalization.",
      "required": false,
      "default": null,
      "x-dagster-widget": "column"
    },
    "timestamp_column": {
      "type": "string",
      "label": "Timestamp Column",
      "description": "Source column to map to event timestamp (auto-detect if None)",
      "required": false,
      "x-dagster-widget": "column"
    },
    "actor_column": {
      "type": "string",
      "label": "Actor Column",
      "description": "Source column for actor/user (auto-detect if None)",
      "required": false,
      "x-dagster-widget": "column"
    },
    "action_column": {
      "type": "string",
      "label": "Action Column",
      "description": "Source column for action/event name",
      "required": false,
      "x-dagster-widget": "column"
    },
    "drop_extras": {
      "type": "boolean",
      "label": "Drop Extras",
      "description": "Drop source columns that don't map to the target schema",
      "required": false,
      "default": false
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Description",
      "required": false
    },
    "group_name": {
      "type": "string",
      "label": "Group Name",
      "description": "Group Name",
      "required": false,
      "default": "security_normalize"
    },
    "owners": {
      "type": "array",
      "label": "Owners",
      "description": "Owners",
      "required": false
    },
    "asset_tags": {
      "type": "object",
      "label": "Asset Tags",
      "description": "Asset Tags",
      "required": false
    },
    "kinds": {
      "type": "array",
      "label": "Kinds",
      "description": "Kinds",
      "required": false
    },
    "partition_type": {
      "type": "string",
      "label": "Partition Type",
      "description": "Partition type: 'daily' / 'weekly' / 'monthly' / 'hourly' / 'static' / 'dynamic' / None for unpartitioned.",
      "required": false,
      "default": null,
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "hourly",
        "static",
        "dynamic"
      ],
      "ui:widget": "select"
    },
    "partition_start": {
      "type": "string",
      "label": "Partition Start",
      "description": "Partition start date in ISO format, e.g. '2024-01-01'. Required for time-based partition types.",
      "required": false,
      "default": null
    },
    "partition_values": {
      "type": "string",
      "label": "Partition Values",
      "description": "Comma-separated values for static partitioning, e.g. 'us,eu,asia'.",
      "required": false,
      "default": null
    },
    "dynamic_partition_name": {
      "type": "string",
      "label": "Dynamic Partition Name",
      "description": "Name for DynamicPartitionsDefinition when partition_type='dynamic'.",
      "required": false,
      "default": null
    }
  }
}
